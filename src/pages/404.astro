---
import Layout from '../layouts/Layout.astro';
import { tr, path } from '../i18n';
import Icon from '../components/Icon.astro';
---
<Layout lang="ru" title="404 — ehroz.pro" description={tr('ru', 'nf.text')}>
  <section class="nf container" data-spy="404">
    <div class="sec-bar"><span>404 / {tr('ru', 'nf.title')}</span><span>{tr('en', 'nf.title')}</span></div>
    <div class="nf-body">
      <div class="nf-pattern" aria-hidden="true">
        {Array.from({ length: 9 }, (_, i) => <i class="ikat" style={`opacity:${(1 - Math.abs(i - 4) / 5).toFixed(2)}`} />)}
      </div>
      <p class="nf-code pixel">404</p>
      <h1 class="h2">{tr('ru', 'nf.title')}</h1>
      <p class="lead">{tr('ru', 'nf.text')}<br />{tr('en', 'nf.text')}</p>
      <a class="btn btn-primary" href={path('ru')}><Icon name="home" />ehroz.pro</a>
    </div>
  </section>
</Layout>
<style>
  .nf { padding-top: calc(var(--menubar) + 24px); }
  .nf-body { position: relative; display: grid; gap: 18px; justify-items: start; padding: 48px 0 64px; border-top: 1px solid var(--line); }
  .nf-pattern { display: grid; gap: 6px; width: 100%; color: var(--line-strong); margin-bottom: 12px; }
  .nf-code { font-size: clamp(96px, 18vw, 200px); line-height: 0.9; color: var(--accent); }
</style>

---
import '../styles/global.css';
import type { Lang } from '../content/apps';
import { tr, path, asset, PRODUCTION_ORIGIN, SITE_NAME, SEARCH_VERIFICATION } from '../i18n';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import Spotlight from '../components/Spotlight.astro';
import PageFrame from '../components/PageFrame.astro';
import Consent from '../components/Consent.astro';
import Analytics from '@vercel/analytics/astro';
import { analyticsEnabled } from '../analytics.config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  slug?: string;
  og?: string;
  /** Подпись к обложке (og:image:alt). По умолчанию — заголовок страницы. */
  ogAlt?: string;
  /** Дата изменения содержимого (YYYY-MM-DD) → og:updated_time. */
  updated?: string;
  glow?: [string, string, string];
  accent?: string;
  onAccent?: string;
  jsonld?: Record<string, unknown>;
  /** Не индексировать: 404, черновики, служебные страницы. Убирает canonical и hreflang. */
  noindex?: boolean;
}
const { lang, title, description, slug = '', og, ogAlt, updated, glow, accent, onAccent, jsonld, noindex = false } = Astro.props;
const site = Astro.site!;
// Индексируем только боевой домен. Зеркала (GitHub Pages, *.vercel.app) и черновики закрыты от поиска,
// чтобы не плодить дубли.
const indexable = site.origin === PRODUCTION_ORIGIN && !noindex;
const canonical = new URL(path(lang, slug), site).href;
const alt = (l: Lang) => new URL(path(l, slug), site).href;
const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const locale = (l: Lang) => (l === 'ru' ? 'ru_RU' : 'en_US');
const imageAlt = ogAlt ?? title;
const ogImage = new URL(asset(og ?? `og/${lang}/home.png`), site).href;
const vars = [
  glow ? `--wall-a:${glow[0]};--wall-b:${glow[1]};--wall-c:${glow[2]}` : '',
  accent ? `--app-accent:${accent};--app-on-accent:${onAccent ?? '#000'}` : '',
]
  .filter(Boolean)
  .join(';');
---

<!doctype html>
<html lang={lang} style={vars || undefined} data-slug={slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="ru" href={alt('ru')} />
        <link rel="alternate" hreflang="en" href={alt('en')} />
        <link rel="alternate" hreflang="x-default" href={alt('ru')} />
      </>
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}
    {indexable && SEARCH_VERIFICATION.google && <meta name="google-site-verification" content={SEARCH_VERIFICATION.google} />}
    {indexable && SEARCH_VERIFICATION.yandex && <meta name="yandex-verification" content={SEARCH_VERIFICATION.yandex} />}
    {indexable && SEARCH_VERIFICATION.bing && <meta name="msvalidate.01" content={SEARCH_VERIFICATION.bing} />}
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="author" content={SITE_NAME} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eef0f2" media="(prefers-color-scheme: light)" />
    <link rel="preload" href={asset('fonts/MedeoSansVariable.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={locale(lang)} />
    {indexable && <meta property="og:locale:alternate" content={locale(otherLang)} />}
    {updated && <meta property="og:updated_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <script is:inline>
      // Тема (auto | dark | light) и отключённые анимации — до первой отрисовки
      (function () {
        var p = 'auto';
        try { p = localStorage.getItem('theme') || 'auto'; } catch (e) {}
        var d = document.documentElement;
        d.setAttribute('data-theme-pref', p);
        if (p !== 'auto') d.setAttribute('data-theme', p);
        try { if (localStorage.getItem('motion') === 'reduce') d.setAttribute('data-motion', 'reduce'); } catch (e) {}
      })();
    </script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">{tr(lang, 'skip')}</a>
    <MenuBar lang={lang} slug={slug} />
    <main id="main">
      <slot />
    </main>
    <PageFrame />
    <Dock lang={lang} current={slug} />
    <Spotlight lang={lang} />
    {/* Vercel Web Analytics: без cookies, согласие не требуется; только на боевом домене. */}
    {site.origin === PRODUCTION_ORIGIN && <Analytics />}
    {analyticsEnabled() && site.origin === PRODUCTION_ORIGIN && <Consent lang={lang} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

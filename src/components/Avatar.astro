---
// Аватар-заглушка: монограмма на плашке. Чтобы поставить фото: положите public/avatar.webp и задайте photo.
import { asset } from '../i18n';
interface Props { size?: number; class?: string; photo?: string }
const { size = 28, class: cls, photo } = Astro.props;
---
{photo ? (
  <img class:list={['avatar', cls]} src={asset(photo)} width={size} height={size} alt="Ehroz" style={`width:${size}px;height:${size}px`} />
) : (
  <span class:list={['avatar', cls]} style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.62)}px`} role="img" aria-label="Ehroz">E</span>
)}
<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    object-fit: cover;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-pixel);
    line-height: 1;
  }
</style>

---
// Аватар-заглушка (монограмма). Чтобы поставить фото: положите public/avatar.webp и задайте photo.
import { asset } from '../i18n';
interface Props { size?: number; class?: string; photo?: string }
const { size = 28, class: cls, photo } = Astro.props;
---
{photo ? (
  <img class:list={['avatar', cls]} src={asset(photo)} width={size} height={size} alt="Ehroz" style={`width:${size}px;height:${size}px`} />
) : (
  <span class:list={['avatar', cls]} style={`width:${size}px;height:${size}px;font-size:${size * 0.5}px`} role="img" aria-label="Ehroz">E</span>
)}
<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    background:
      radial-gradient(80% 80% at 25% 20%, #8a74e8, transparent 60%),
      radial-gradient(80% 80% at 90% 80%, #c25a86, transparent 60%),
      linear-gradient(135deg, #3c6fa8, #2a2140);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.35), 0 2px 8px rgba(0, 0, 0, 0.25);
  }
</style>

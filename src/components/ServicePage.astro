---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../content/apps';
import { path, asset, clip, CONTACTS, SITE_NAME } from '../i18n';
import { graph, webpage, breadcrumbs, website, person, service, faqList } from '../lib/schema';
import Icon from './Icon.astro';
import Footer from './Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const SLUG = 'website-astana';
const UPDATED = '2026-11-02';
const c = CONTACTS;

const site = Astro.site!;
const url = new URL(path(lang, SLUG), site).href;
const title = ru ? 'Сайт под ключ в Астане — цены и сроки · Ehroz' : 'Turnkey websites in Astana — prices · Ehroz';
const h1 = ru ? 'Сайт под ключ в Астане' : 'Turnkey websites in Astana';
const lead = ru
  ? 'Делаю сайты для малого бизнеса в Астане и по Казахстану: от лендинга за неделю до интернет-магазина. Дизайн, вёрстка, запуск и подключение аналитики — один человек от первого звонка до публикации.'
  : 'I build websites for small businesses in Astana and across Kazakhstan: from a one-week landing page to an online store. Design, development, launch and analytics — one person from the first call to going live.';
const description = clip(ru
  ? 'Сайт под ключ в Астане: лендинг от $350 за 5–7 дней, сайт компании от $700, интернет-магазин от $1300. Дизайн, адаптив, SEO и аналитика включены.'
  : 'Turnkey websites in Astana: landing page from $350 in 5–7 days, business website from $700, online store from $1,300. Design, mobile, SEO and analytics included.');
const og = `og/${lang}/home.png`;
const crumbs = [
  { name: SITE_NAME, url: path(lang) },
  { name: h1, url: path(lang, SLUG) },
];

const packages = ru ? [
  { name: 'Лендинг', price: 350, time: '5–7 рабочих дней', description: 'Одна страница под услугу, акцию или продукт: оффер, преимущества, цены, отзывы, форма заявки.', items: ['до 8 блоков', 'форма заявки в Telegram или WhatsApp', '2 круга правок'] },
  { name: 'Сайт компании', price: 700, time: '2–3 недели', description: 'Многостраничный сайт: главная, услуги, о компании, портфолио, контакты.', items: ['до 7 страниц', 'русская и казахская или английская версии — по запросу', '3 круга правок'] },
  { name: 'Интернет-магазин', price: 1300, time: '3–5 недель', description: 'Каталог с фильтрами, карточки товаров, корзина и приём заказов.', items: ['каталог до 300 товаров на старте', 'заказы в Telegram, WhatsApp или на почту', 'обучение: как добавлять товары'] },
] : [
  { name: 'Landing page', price: 350, time: '5–7 working days', description: 'One page for a service, offer or product: headline, benefits, prices, reviews, lead form.', items: ['up to 8 sections', 'leads sent to Telegram or WhatsApp', '2 rounds of edits'] },
  { name: 'Business website', price: 700, time: '2–3 weeks', description: 'A multi-page site: home, services, about, portfolio, contacts.', items: ['up to 7 pages', 'Russian plus Kazakh or English on request', '3 rounds of edits'] },
  { name: 'Online store', price: 1300, time: '3–5 weeks', description: 'A catalogue with filters, product pages, cart and order handling.', items: ['up to 300 products at launch', 'orders to Telegram, WhatsApp or email', 'training on adding products'] },
];

const included = ru ? [
  'Дизайн под ваш бренд — без шаблонов из конструктора',
  'Адаптивная вёрстка: телефон, планшет, компьютер',
  'Базовое SEO: заголовки, описания, sitemap, микроразметка, подключение к Google Search Console и Яндекс Вебмастеру',
  'Google Analytics 4 и Яндекс Метрика с целями на заявки',
  'Помощь с доменом и хостингом (оплачиваются отдельно, по тарифам провайдера)',
  'Месяц бесплатных мелких правок после запуска',
] : [
  'Design for your brand — no website-builder templates',
  'Responsive layout for phone, tablet and desktop',
  'Basic SEO: titles, descriptions, sitemap, structured data, Google Search Console and Yandex Webmaster setup',
  'Google Analytics 4 and Yandex Metrica with lead goals',
  'Help with domain and hosting (paid separately at the provider’s rates)',
  'One month of free small edits after launch',
];

const steps = ru ? [
  ['Созвон или переписка', 'Обсуждаем задачу, сроки и бюджет. Бесплатно.'],
  ['Смета и договор', 'Фиксирую цену и сроки. Предоплата 50%.'],
  ['Дизайн', 'Показываю макет главной, утверждаем стиль, затем остальные страницы.'],
  ['Вёрстка и наполнение', 'Собираю сайт, подключаю формы, аналитику и SEO.'],
  ['Запуск', 'Публикую на вашем домене, проверяю на телефонах, передаю доступы. Оплата остатка.'],
] : [
  ['Call or chat', 'We discuss the task, timeline and budget. Free.'],
  ['Quote and contract', 'I fix the price and dates. 50% upfront.'],
  ['Design', 'I show the home page mockup, we agree on the style, then the other pages.'],
  ['Build and content', 'I build the site and connect forms, analytics and SEO.'],
  ['Launch', 'I publish on your domain, test on phones and hand over access. Remaining payment.'],
];

const faqs = ru ? [
  { q: 'Сколько стоит сайт под ключ в Астане?', a: 'Лендинг — от $350, сайт компании до 7 страниц — от $700, интернет-магазин — от $1300. Точная цена зависит от количества страниц и функций; смету называю после короткого обсуждения.' },
  { q: 'Сколько времени занимает разработка?', a: 'Лендинг — 5–7 рабочих дней, сайт компании — 2–3 недели, интернет-магазин — 3–5 недель. Срок считается с момента, когда получены тексты и фото.' },
  { q: 'Можно ли оплатить в тенге?', a: 'Да. Цены указаны в долларах для ориентира, оплата возможна в тенге по курсу на день выставления счёта.' },
  { q: 'Кто будет владельцем сайта и домена?', a: 'Вы. Домен и хостинг регистрируются на вас, после запуска передаю все доступы.' },
  { q: 'Работаете только с Астаной?', a: 'Нет, работаю удалённо с клиентами по всему Казахстану и за его пределами. Созвоны — в Telegram, WhatsApp или Google Meet.' },
] : [
  { q: 'How much does a turnkey website cost in Astana?', a: 'A landing page starts at $350, a business website of up to 7 pages at $700, an online store at $1,300. The exact price depends on pages and features; I give a quote after a short talk.' },
  { q: 'How long does it take?', a: 'A landing page takes 5–7 working days, a business website 2–3 weeks, an online store 3–5 weeks, counted from when texts and photos are ready.' },
  { q: 'Can I pay in tenge?', a: 'Yes. Prices are in US dollars for reference; you can pay in tenge at the rate on the invoice date.' },
  { q: 'Who owns the website and domain?', a: 'You do. The domain and hosting are registered in your name, and I hand over all access after launch.' },
  { q: 'Do you only work in Astana?', a: 'No, I work remotely with clients across Kazakhstan and abroad. Calls via Telegram, WhatsApp or Google Meet.' },
];

const jsonld = graph(
  webpage({ site, lang, url, name: title, description, updated: UPDATED, breadcrumb: true,
            image: new URL(asset(og), site).href, imageAlt: title }),
  breadcrumbs(site, url, crumbs),
  service(site, lang, url, {
    name: h1, description: lead, area: ru ? 'Астана' : 'Astana',
    packages: packages.map((p) => ({ name: p.name, price: p.price, description: p.description })),
  }),
  faqList(url, lang, faqs),
  website(site),
  person(site, lang),
);
const wa = `https://wa.me/${c.phone}`;
const tg = `https://t.me/+${c.phone}`;
const phoneView = `+${c.phone.slice(0, 1)} ${c.phone.slice(1, 4)} ${c.phone.slice(4, 7)} ${c.phone.slice(7, 9)} ${c.phone.slice(9)}`;
---
<Layout lang={lang} title={title} description={description} slug={SLUG} og={og} ogAlt={title} updated={UPDATED} jsonld={jsonld}>
  <section class="svc container" aria-labelledby="svc-h1" data-spy={h1}>
    <div class="sec-bar">
      <nav class="crumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumb'}>
        <ol>
          <li><a href={path(lang)}>{SITE_NAME}</a></li>
          <li><span aria-current="page">{h1}</span></li>
        </ol>
      </nav>
      <span>{ru ? 'Астана · UTC+5' : 'Astana · UTC+5'}</span>
    </div>

    <h1 class="display" id="svc-h1">{h1}</h1>
    <p class="lead">{lead}</p>
    <p class="cta">
      <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">{ru ? 'Написать в WhatsApp' : 'Message on WhatsApp'}</a>
      <a class="btn" href={tg} target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
    </p>

    <h2 class="h3">{ru ? 'Цены и сроки' : 'Prices and timelines'}</h2>
    <ul class="pk">
      {packages.map((p) => (
        <li>
          <h3>{p.name}</h3>
          <p class="price">{ru ? 'от' : 'from'} <b>${p.price.toLocaleString('en-US')}</b></p>
          <p class="time">{p.time}</p>
          <p>{p.description}</p>
          <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="note">{ru ? 'Цены в долларах США для ориентира, оплата возможна в тенге. Домен и хостинг оплачиваются отдельно.' : 'Prices in US dollars for reference; payment in tenge is possible. Domain and hosting are paid separately.'}</p>

    <h2 class="h3">{ru ? 'Что входит в любой пакет' : 'Included in every package'}</h2>
    <ul class="inc">{included.map((i) => <li>{i}</li>)}</ul>

    <h2 class="h3">{ru ? 'Как идёт работа' : 'How it works'}</h2>
    <ol class="steps">{steps.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ol>

    <h2 class="h3">{ru ? 'Частые вопросы' : 'FAQ'}</h2>
    <div class="faq">
      {faqs.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </div>

    <h2 class="h3">{ru ? 'Связаться' : 'Get in touch'}</h2>
    <p>{ru ? 'WhatsApp и Telegram:' : 'WhatsApp and Telegram:'} <a href={wa} target="_blank" rel="noopener">{phoneView}</a> · Telegram <a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener">@{c.telegram}</a> · <a href={`mailto:${c.email}`}>{c.email}</a></p>
    <p class="upd">{ru ? 'Обновлено:' : 'Updated:'} <time datetime={UPDATED}>{UPDATED}</time></p>
  </section>
  <Footer lang={lang} />
</Layout>

<style>
  .svc { padding-top: calc(var(--menubar) + 24px); padding-bottom: 64px; }
  .svc h1 { padding-top: 40px; border-top: 1px solid var(--line); }
  .svc .lead { max-width: 62ch; margin-top: 16px; }
  .svc h2 { margin: 48px 0 16px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .pk { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .pk > li { border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: grid; gap: 8px; align-content: start; }
  .pk h3 { margin: 0; font-size: 18px; }
  .pk .price { margin: 0; font-size: 15px; color: var(--text-2); }
  .pk .price b { font-size: 28px; color: var(--text); }
  .pk .time { margin: 0; font: 400 12px/1.6 var(--font-mono); color: var(--muted); text-transform: uppercase; }
  .pk p { margin: 0; }
  .pk ul { margin: 4px 0 0; padding-left: 1.2em; color: var(--text-2); font-size: 14px; display: grid; gap: 4px; }
  .note, .upd { color: var(--muted); font-size: 13px; margin-top: 12px; }
  .inc { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; max-width: 70ch; }
  .steps { margin: 0; padding-left: 1.4em; display: grid; gap: 12px; max-width: 70ch; }
  .steps li { display: grid; gap: 2px; }
  .steps span { color: var(--text-2); }
  .faq { border-top: 1px solid var(--line); max-width: 80ch; }
  .faq .qa { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq h3 { margin: 0; font-size: 16px; }
  .faq p { margin: 8px 0 0; color: var(--text-2); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--muted); }
  .crumbs a { color: var(--text-2); }
  .crumbs a:hover, .crumbs a:focus-visible { color: var(--accent); }
</style>

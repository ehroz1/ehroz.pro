---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../content/apps';
import { path, asset, clip, CONTACTS, SITE_NAME } from '../i18n';
import { graph, webpage, breadcrumbs, website, person, service, faqList } from '../lib/schema';
import Icon from './Icon.astro';
import Footer from './Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const SLUG = 'website-astana';
const UPDATED = '2026-11-04';
const c = CONTACTS;

const site = Astro.site!;
const url = new URL(path(lang, SLUG), site).href;
const title = ru ? 'Сайт под ключ в Астане — цены и сроки · Ehroz' : 'Turnkey websites in Astana — prices · Ehroz';
const h1 = ru ? 'Сайт под ключ в Астане' : 'Turnkey websites in Astana';
const lead = ru
  ? 'Делаю сайты для малого бизнеса в Астане и по Казахстану: от лендинга за неделю до интернет-магазина. Дизайн, вёрстка, запуск и подключение аналитики — один человек от первого звонка до публикации. Отдельно беру графический дизайн — логотипы, фирменный стиль, соцсети, полиграфию — и дизайн интерфейсов.'
  : 'I build websites for small businesses in Astana and across Kazakhstan: from a one-week landing page to an online store. Design, development, launch and analytics — one person from the first call to going live. I also take on graphic design — logos, brand identity, social media, print — and interface design.';
const description = clip(ru
  ? 'Сайт под ключ в Астане: лендинг от $350, сайт компании от $700, магазин от $1300. Графический дизайн: логотип от $150, фирменный стиль от $450. UX/UI.'
  : 'Websites in Astana: landing page from $350, business site from $700, store from $1,300. Graphic design: logo from $150, brand identity from $450. UX/UI.');
const og = `og/${lang}/home.png`;
const crumbs = [
  { name: SITE_NAME, url: path(lang) },
  { name: h1, url: path(lang, SLUG) },
];

const packages = ru ? [
  { name: 'Лендинг', price: 350, time: '5–7 рабочих дней', description: 'Одна страница под услугу, акцию или продукт: оффер, преимущества, цены, отзывы, форма заявки.', items: ['до 8 блоков', 'форма заявки в Telegram или WhatsApp', '2 круга правок'] },
  { name: 'Сайт компании', price: 700, time: '2–3 недели', description: 'Многостраничный сайт: главная, услуги, о компании, портфолио, контакты.', items: ['до 7 страниц', 'русская и казахская или английская версии — по запросу', '3 круга правок'] },
  { name: 'Интернет-магазин', price: 1300, time: '3–5 недель', description: 'Каталог с фильтрами, карточки товаров, корзина и приём заказов.', items: ['каталог до 300 товаров на старте', 'заказы в Telegram, WhatsApp или на почту', 'обучение: как добавлять товары'] },
] : [
  { name: 'Landing page', price: 350, time: '5–7 working days', description: 'One page for a service, offer or product: headline, benefits, prices, reviews, lead form.', items: ['up to 8 sections', 'leads sent to Telegram or WhatsApp', '2 rounds of edits'] },
  { name: 'Business website', price: 700, time: '2–3 weeks', description: 'A multi-page site: home, services, about, portfolio, contacts.', items: ['up to 7 pages', 'Russian plus Kazakh or English on request', '3 rounds of edits'] },
  { name: 'Online store', price: 1300, time: '3–5 weeks', description: 'A catalogue with filters, product pages, cart and order handling.', items: ['up to 300 products at launch', 'orders to Telegram, WhatsApp or email', 'training on adding products'] },
];

// Графический дизайн и UX/UI — цены по рынку Астаны (фриланс, средний уровень), в долларах для ориентира.
type Item = { name: string; price: number; time: string; description: string };
const graphic: Item[] = ru ? [
  { name: 'Логотип', price: 150, time: '5–7 дней', description: '3 концепции на выбор, доработка выбранной, файлы для печати и экрана.' },
  { name: 'Фирменный стиль', price: 450, time: '2–3 недели', description: 'Логотип, цвета, шрифты, визитка, бланк и мини-брендбук с правилами.' },
  { name: 'Оформление соцсетей', price: 120, time: '3–5 дней', description: 'Аватар, обложки для highlights, 6 шаблонов постов и 3 — сторис в Canva или Figma.' },
  { name: 'Визитка', price: 30, time: '1–2 дня', description: 'Двусторонняя, макет готов для типографии.' },
  { name: 'Листовка, флаер, буклет', price: 50, time: '2–3 дня', description: 'Цена за одну сторону А5–А4; буклет-евро — от $90.' },
  { name: 'Баннер, наружная реклама', price: 80, time: '2–3 дня', description: 'Ролл-ап, баннер, вывеска или билборд по техтребованиям подрядчика.' },
  { name: 'Меню для кафе и ресторана', price: 120, time: '4–6 дней', description: 'До 4 страниц, вёрстка блюд и цен, версия для печати и QR.' },
  { name: 'Упаковка и этикетка', price: 250, time: '1–2 недели', description: 'Дизайн и развёртка под производство, 2 варианта на старте.' },
  { name: 'Презентация', price: 150, time: '3–5 дней', description: 'До 15 слайдов в PowerPoint, Keynote или Google Slides; дальше — $10 за слайд.' },
] : [
  { name: 'Logo', price: 150, time: '5–7 days', description: '3 concepts to choose from, refinement of the chosen one, files for print and screen.' },
  { name: 'Brand identity', price: 450, time: '2–3 weeks', description: 'Logo, colours, typefaces, business card, letterhead and a short brand book.' },
  { name: 'Social media kit', price: 120, time: '3–5 days', description: 'Avatar, highlight covers, 6 post and 3 story templates in Canva or Figma.' },
  { name: 'Business card', price: 30, time: '1–2 days', description: 'Double-sided, print-ready.' },
  { name: 'Leaflet, flyer, booklet', price: 50, time: '2–3 days', description: 'Per side, A5–A4; a tri-fold booklet from $90.' },
  { name: 'Banner, outdoor ads', price: 80, time: '2–3 days', description: 'Roll-up, banner, signboard or billboard to the printer’s specs.' },
  { name: 'Café or restaurant menu', price: 120, time: '4–6 days', description: 'Up to 4 pages with dishes and prices, print and QR versions.' },
  { name: 'Packaging and labels', price: 250, time: '1–2 weeks', description: 'Design and dieline for production, 2 directions to start.' },
  { name: 'Presentation', price: 150, time: '3–5 days', description: 'Up to 15 slides in PowerPoint, Keynote or Google Slides; $10 per extra slide.' },
];
const uxui: Item[] = ru ? [
  { name: 'UX-аудит сайта или приложения', price: 200, time: '3–5 дней', description: 'Разбор экранов и сценариев, список проблем с приоритетами и решениями.' },
  { name: 'Дизайн мобильного приложения', price: 900, time: '3–5 недель', description: 'Сценарии, прототип и макеты до 20 экранов в Figma, UI-кит для разработчиков.' },
  { name: 'Интерфейс веб-сервиса', price: 800, time: '3–4 недели', description: 'Личный кабинет, админка или дашборд: до 15 экранов и компоненты в Figma.' },
] : [
  { name: 'UX audit of a site or app', price: 200, time: '3–5 days', description: 'Screen and flow review, a prioritised list of issues with fixes.' },
  { name: 'Mobile app design', price: 900, time: '3–5 weeks', description: 'User flows, prototype and up to 20 screens in Figma, a UI kit for developers.' },
  { name: 'Web app interface', price: 800, time: '3–4 weeks', description: 'Account area, admin panel or dashboard: up to 15 screens and components in Figma.' },
];

const included = ru ? [
  'Дизайн под ваш бренд — без шаблонов из конструктора',
  'Адаптивная вёрстка: телефон, планшет, компьютер',
  'Базовое SEO: заголовки, описания, sitemap, микроразметка, подключение к Google Search Console и Яндекс Вебмастеру',
  'Google Analytics 4 и Яндекс Метрика с целями на заявки',
  'Помощь с доменом и хостингом (оплачиваются отдельно, по тарифам провайдера)',
  'Месяц бесплатных мелких правок после запуска',
] : [
  'Design for your brand — no website-builder templates',
  'Responsive layout for phone, tablet and desktop',
  'Basic SEO: titles, descriptions, sitemap, structured data, Google Search Console and Yandex Webmaster setup',
  'Google Analytics 4 and Yandex Metrica with lead goals',
  'Help with domain and hosting (paid separately at the provider’s rates)',
  'One month of free small edits after launch',
];

const steps = ru ? [
  ['Созвон или переписка', 'Обсуждаем задачу, сроки и бюджет. Бесплатно.'],
  ['Смета и договор', 'Фиксирую цену и сроки. Предоплата 50%.'],
  ['Дизайн', 'Показываю макет главной, утверждаем стиль, затем остальные страницы.'],
  ['Вёрстка и наполнение', 'Собираю сайт, подключаю формы, аналитику и SEO.'],
  ['Запуск', 'Публикую на вашем домене, проверяю на телефонах, передаю доступы. Оплата остатка.'],
] : [
  ['Call or chat', 'We discuss the task, timeline and budget. Free.'],
  ['Quote and contract', 'I fix the price and dates. 50% upfront.'],
  ['Design', 'I show the home page mockup, we agree on the style, then the other pages.'],
  ['Build and content', 'I build the site and connect forms, analytics and SEO.'],
  ['Launch', 'I publish on your domain, test on phones and hand over access. Remaining payment.'],
];

const faqs = ru ? [
  { q: 'Сколько стоит сайт под ключ в Астане?', a: 'Лендинг — от $350, сайт компании до 7 страниц — от $700, интернет-магазин — от $1300. Точная цена зависит от количества страниц и функций; смету называю после короткого обсуждения.' },
  { q: 'Сколько времени занимает разработка?', a: 'Лендинг — 5–7 рабочих дней, сайт компании — 2–3 недели, интернет-магазин — 3–5 недель. Срок считается с момента, когда получены тексты и фото.' },
  { q: 'Можно ли оплатить в тенге?', a: 'Да. Цены указаны в долларах для ориентира, оплата возможна в тенге по курсу на день выставления счёта.' },
  { q: 'Кто будет владельцем сайта и домена?', a: 'Вы. Домен и хостинг регистрируются на вас, после запуска передаю все доступы.' },
  { q: 'Можно заказать только логотип или дизайн без сайта?', a: 'Да. Графический дизайн и дизайн интерфейсов можно заказать отдельно: логотип — от $150, фирменный стиль — от $450, дизайн приложения — от $900. Если потом понадобится сайт, он будет в том же стиле.' },
  { q: 'Работаете только с Астаной?', a: 'Нет, работаю удалённо с клиентами по всему Казахстану и за его пределами. Созвоны — в Telegram, WhatsApp или Google Meet.' },
] : [
  { q: 'How much does a turnkey website cost in Astana?', a: 'A landing page starts at $350, a business website of up to 7 pages at $700, an online store at $1,300. The exact price depends on pages and features; I give a quote after a short talk.' },
  { q: 'How long does it take?', a: 'A landing page takes 5–7 working days, a business website 2–3 weeks, an online store 3–5 weeks, counted from when texts and photos are ready.' },
  { q: 'Can I pay in tenge?', a: 'Yes. Prices are in US dollars for reference; you can pay in tenge at the rate on the invoice date.' },
  { q: 'Who owns the website and domain?', a: 'You do. The domain and hosting are registered in your name, and I hand over all access after launch.' },
  { q: 'Can I order just a logo or design without a website?', a: 'Yes. Graphic and interface design can be ordered separately: a logo from $150, brand identity from $450, app design from $900. If you need a website later, it will match the same style.' },
  { q: 'Do you only work in Astana?', a: 'No, I work remotely with clients across Kazakhstan and abroad. Calls via Telegram, WhatsApp or Google Meet.' },
];

const jsonld = graph(
  webpage({ site, lang, url, name: title, description, updated: UPDATED, breadcrumb: true,
            image: new URL(asset(og), site).href, imageAlt: title }),
  breadcrumbs(site, url, crumbs),
  service(site, lang, url, {
    name: h1, description: lead, area: ru ? 'Астана' : 'Astana',
    packages: packages.map((p) => ({ name: p.name, price: p.price, description: p.description })),
  }),
  service(site, lang, url, {
    id: 'design', type: ru ? 'Графический дизайн и UX/UI' : 'Graphic and UX/UI design',
    name: ru ? 'Графический и UX/UI-дизайн в Астане' : 'Graphic and UX/UI design in Astana',
    description: ru ? 'Логотипы, фирменный стиль, соцсети, полиграфия, упаковка, презентации и дизайн интерфейсов.' : 'Logos, brand identity, social media, print, packaging, presentations and interface design.',
    area: ru ? 'Астана' : 'Astana',
    packages: [...graphic, ...uxui].map((p) => ({ name: p.name, price: p.price, description: p.description })),
  }),
  faqList(url, lang, faqs),
  website(site),
  person(site, lang),
);
const wa = `https://wa.me/${c.phone}`;
const tg = `https://t.me/+${c.phone}`;
const phoneView = `+${c.phone.slice(0, 1)} ${c.phone.slice(1, 4)} ${c.phone.slice(4, 7)} ${c.phone.slice(7, 9)} ${c.phone.slice(9)}`;
---
<Layout lang={lang} title={title} description={description} slug={SLUG} og={og} ogAlt={title} updated={UPDATED} jsonld={jsonld}>
  <section class="info container" aria-labelledby="svc-h1" data-spy={h1}>
    <div class="sec-bar">
      <nav class="crumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumb'}>
        <ol>
          <li><a href={path(lang)}>{SITE_NAME}</a></li>
          <li><span aria-current="page">{h1}</span></li>
        </ol>
      </nav>
      <span>{ru ? 'Астана · UTC+5' : 'Astana · UTC+5'}</span>
    </div>
    <div class="info-head">
      <h1 class="display" id="svc-h1">{h1}</h1>
      <p class="lead">{lead}</p>
      <div class="cta">
        <a class="btn btn-primary" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" />{ru ? 'Написать в WhatsApp' : 'Message on WhatsApp'}</a>
        <a class="btn" href={tg} target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
      </div>
    </div>

    <h2 class="h3">{ru ? 'Цены и сроки' : 'Prices and timelines'}</h2>
    <ul class="pk">
      {packages.map((p) => (
        <li>
          <div class="pk-top">
            <h3>{p.name}</h3>
            <span class="time">{p.time}</span>
          </div>
          <p class="price">{ru ? 'от' : 'from'} <b>${p.price.toLocaleString('en-US')}</b></p>
          <p class="d">{p.description}</p>
          <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="note">{ru ? 'Цены в долларах США для ориентира, оплата возможна в тенге. Домен и хостинг оплачиваются отдельно.' : 'Prices in US dollars for reference; payment in tenge is possible. Domain and hosting are paid separately.'}</p>

    <h2 class="h3">{ru ? 'Что входит в любой пакет' : 'Included in every package'}</h2>
    <ul class="rows">{included.map((i) => <li><Icon name="check" /><span>{i}</span></li>)}</ul>

    <h2 class="h3">{ru ? 'Графический дизайн' : 'Graphic design'}</h2>
    <ul class="pl">
      {graphic.map((p) => (
        <li><b>{p.name}</b><span class="d">{p.description}</span><span class="time">{p.time}</span><span class="price">{ru ? 'от' : 'from'} <b>${p.price.toLocaleString('en-US')}</b></span></li>
      ))}
    </ul>

    <h2 class="h3">{ru ? 'UX/UI-дизайн' : 'UX/UI design'}</h2>
    <ul class="pl">
      {uxui.map((p) => (
        <li><b>{p.name}</b><span class="d">{p.description}</span><span class="time">{p.time}</span><span class="price">{ru ? 'от' : 'from'} <b>${p.price.toLocaleString('en-US')}</b></span></li>
      ))}
    </ul>
    <p class="note">{ru ? 'Цены — ориентир по рынку Астаны; точную сумму называю после брифа. В стоимость входят исходники и 2 круга правок, печать и производство оплачиваются отдельно.' : 'Prices are a guide based on the Astana market; I give an exact quote after a brief. Source files and 2 rounds of edits are included; printing and production are paid separately.'}</p>

    <h2 class="h3">{ru ? 'Как идёт работа' : 'How it works'}</h2>
    <ol class="steps">
      {steps.map(([t, d], i) => (
        <li><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{t}</b><span class="s">{d}</span></li>
      ))}
    </ol>

    <h2 class="h3">{ru ? 'Частые вопросы' : 'FAQ'}</h2>
    <div class="faq">
      {faqs.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </div>

    <h2 class="h3">{ru ? 'Связаться' : 'Get in touch'}</h2>
    <ul class="channels">
      <li><a href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /><span class="n">WhatsApp</span><span class="v">{phoneView}</span></a></li>
      <li><a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" /><span class="n">Telegram</span><span class="v">@{c.telegram}</span></a></li>
      <li><a href={`mailto:${c.email}`}><Icon name="mail" /><span class="n">Email</span><span class="v">{c.email}</span></a></li>
    </ul>
    <p class="note">{ru ? 'Обновлено:' : 'Updated:'} <time datetime={UPDATED}>{UPDATED}</time></p>
  </section>
  <Footer lang={lang} />
</Layout>

<style>
  .info { padding-top: calc(var(--menubar) + 24px); padding-bottom: 64px; }
  .info-head { display: grid; gap: 16px; justify-items: start; padding: 40px 0; border-top: 1px solid var(--line); }
  .info-head .lead { max-width: 62ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .info h2 { margin: 40px 0 16px; }
  .pk { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); column-gap: 24px; border-top: 1px solid var(--line); }
  .pk > li { display: grid; gap: 10px; align-content: start; padding: 16px 0 20px; border-bottom: 1px solid var(--line); }
  .pk-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pk h3 { margin: 0; font-size: 16px; }
  .pk .time { font: 400 11px/1 var(--font-mono); color: var(--muted); text-transform: uppercase; white-space: nowrap; }
  .pk p { margin: 0; }
  .pk .price { color: var(--text-2); font-size: 14px; }
  .pk .price b { font-size: 28px; color: var(--text); letter-spacing: -0.02em; }
  .pk .d { color: var(--text-2); }
  .pk ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 14px; color: var(--text-2); }
  .pk ul li::before { content: '— '; color: var(--muted); }
  .pl { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .pl li { display: grid; grid-template-columns: minmax(160px, 260px) 1fr 110px 110px; gap: 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .pl li > b { font-weight: 500; }
  .pl .d { color: var(--text-2); }
  .pl .time { font: 400 11px/1.6 var(--font-mono); color: var(--muted); text-transform: uppercase; }
  .pl .price { text-align: right; color: var(--text-2); font-size: 14px; white-space: nowrap; }
  .pl .price b { font-size: 18px; color: var(--text); }
  .note { margin-top: 16px; color: var(--muted); font-size: 13px; max-width: 62ch; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); max-width: 720px; }
  .rows li { display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .rows li :global(svg) { flex: none; margin-top: 3px; color: var(--muted); }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 48px minmax(140px, 220px) 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .steps .n { font: 400 12px/1.6 var(--font-mono); color: var(--muted); }
  .steps b { font-weight: 500; }
  .steps .s { color: var(--text-2); }
  .faq { border-top: 1px solid var(--line); }
  .faq .qa { display: grid; grid-template-columns: minmax(200px, 360px) 1fr; gap: 16px; border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq h3 { margin: 0; font-size: 15px; font-weight: 500; }
  .faq p { margin: 0; color: var(--text-2); max-width: 70ch; }
  .channels { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); max-width: 720px; }
  .channels a { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); color: inherit; }
  .channels .v { margin-left: auto; color: var(--text-2); font: 400 13px/1.3 var(--font-mono); overflow-wrap: anywhere; text-align: right; }
  .channels a:hover .n, .channels a:focus-visible .n { color: var(--accent); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--muted); }
  .crumbs a { color: var(--text-2); }
  .crumbs a:hover, .crumbs a:focus-visible { color: var(--accent); }
  @media (max-width: 640px) {
    .steps li { grid-template-columns: 32px 1fr; gap: 4px 12px; }
    .steps .s { grid-column: 2; }

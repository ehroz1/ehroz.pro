---
// Карточка приложения в каталоге: номер, категория, демо на подложке, иконка и описание.
import type { App, Lang } from '../content/apps';
import { path, pick, PLATFORM, STATUS, tr } from '../i18n';
import AppIcon from './AppIcon.astro';
import SceneSwitch from './scenes/SceneSwitch.astro';

interface Props {
  app: App;
  lang: Lang;
  featured?: boolean;
  /** Горизонтальная карточка на две колонки (демо слева, текст справа). */
  wide?: boolean;
  index: number;
  /** Без демо-сцены (компактная карточка: «Другие приложения»). */
  compact?: boolean;
}
const { app, lang, featured = false, wide = false, index, compact = false } = Astro.props;
const no = String(index + 1).padStart(2, '0');
---

<article class:list={['card', { featured, wide, compact }]} data-tint style={`--tint-d:${app.tint.dark};--tint-l:${app.tint.light}`}>
  <a class="card-link" href={path(lang, app.slug)} data-app-link={app.slug} aria-label={`${app.name} — ${pick(lang, app.short)}`}>
    <header class="card-h">
      <span class="tag-no">{no}</span>
      <span class="card-kind">{pick(lang, app.kind)}</span>
    </header>
    {
      !compact && (
        <div class="card-plate">
          <SceneSwitch fit id={app.features[0].scene} lang={lang} label={`${app.name}: ${pick(lang, app.features[0].title)}`} />
        </div>
      )
    }
    <div class="card-body">
      <AppIcon slug={app.slug} name={app.name} size={compact ? 72 : 76} class="card-icon" eager={index < 4} decorative vt />
      <h3 class="card-name">{app.name}</h3>
      <p class="card-short">{pick(lang, app.short)}</p>
      <div class="spec-tags">
        <span class={`stag ${app.status}`}><i class="sq" />{pick(lang, STATUS[app.status])}</span>
        <span class="stag">{app.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · ')}</span>
        {app.version && <span class="stag">v{app.version}</span>}
      </div>
      <span class="go">{tr(lang, 'apps.open')} →</span>
    </div>
    <i class="ikat card-edge" aria-hidden="true" />
  </a>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--cell);
  }
  .card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
  }
  .card-kind {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--faint);
    font-size: 13px;
    line-height: 1;
  }
  .card-plate {
    position: relative;
    height: clamp(220px, 19vw, 290px);
    background: var(--plate);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .card-body {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 0 16px 18px;
    flex: 1;
  }
  .compact .card-body {
    padding-top: 16px;
  }
  .card-body :global(.card-icon) {
    width: 76px;
    height: 76px;
    margin: -34px 0 -6px -8px;
    position: relative;
    z-index: 3;
    transition: transform var(--mid) var(--ease);
  }
  .compact .card-body :global(.card-icon) {
    width: 72px;
    height: 72px;
    margin: 0 0 -4px -8px;
  }
  .card-link:hover :global(.card-icon) {
    transform: translateY(-5px);
  }
  .card-name {
    font: 650 clamp(1.5rem, 1.3rem + 0.8vw, 2rem)/1.05 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .featured .card-name {
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem);
  }
  @media (min-width: 1100px) {
    .featured .card-plate {
      height: auto;
      flex: 1;
      min-height: clamp(380px, 32vw, 520px);
    }
    .featured .card-body {
      flex: none;
    }
  }
  /* Горизонтальная карточка: демо слева, описание справа */
  @media (min-width: 640px) {
    .wide .card-link {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-rows: auto 1fr;
    }
    .wide .card-h {
      grid-column: 1 / -1;
    }
    .wide .card-plate {
      height: 100%;
      min-height: 260px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .wide .card-body {
      align-content: center;
      padding: 20px 20px 24px;
    }
    .wide .card-body :global(.card-icon) {
      margin: 0 0 -4px -8px;
    }
  }
  .card-short {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
    text-wrap: pretty;
    max-width: 44ch;
  }
  .go {
    margin-top: 6px;
  }
  .card-link:hover .go {
    color: var(--tint);
  }
  .card-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    color: var(--tint);
    transition: height var(--fast) var(--ease);
  }
  .card-link:hover .card-edge,
  .card-link:focus-visible .card-edge {
    height: 7px;
    -webkit-mask-size: 14px 7px;
    mask-size: 14px 7px;
  }
  .card-link:focus-visible {
    outline-offset: -3px;
  }
</style>

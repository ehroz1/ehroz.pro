---
// Знак ehroz.pro: узкая Z из логотипа, одна полоса — акцентный цвет. Та же фигура, что в фавиконке.
interface Props { size?: number; class?: string }
const { size = 18, class: cls } = Astro.props;
---
<svg class:list={['zmark', cls]} viewBox="0 0 228 224" width={size} height={Math.round((size * 224) / 228)} aria-hidden="true" focusable="false">
  <path fill="currentColor" fill-rule="evenodd" d="M0 0H228V54L170 170H228V224H0V170L58 54H0Z M118 54H168L110 170H60Z" />
  <path fill="var(--accent)" d="M168 54H228L170 170H110Z" />
</svg>

---
import Layout from '../layouts/Layout.astro';
import type { App, Lang } from '../content/apps';
import { apps } from '../content/apps';
import '../lib/downloads';
import { tr, path, pick, clip, asset, PLATFORM, STATUS, CONTACTS, SITE_NAME } from '../i18n';
import { graph, webpage, breadcrumbs, application, faq, website, person } from '../lib/schema';
import AppIcon from './AppIcon.astro';
import AppWindow from './AppWindow.astro';
import Icon from './Icon.astro';
import Footer from './Footer.astro';
import SceneSwitch from './scenes/SceneSwitch.astro';
import { INSTALL } from '../content/install';

interface Props {
  app: App;
  lang: Lang;
}
const { app, lang } = Astro.props;
const ru = lang === 'ru';
const idx = apps.findIndex((a) => a.slug === app.slug);
const no = String(idx + 1).padStart(2, '0');
const others = apps.map((a, i) => ({ a, i })).filter(({ a }) => a.slug !== app.slug);
const fill = (v: string) => v.replaceAll('{app}', app.name);
const guides = app.links.map((l, i) => ({ i, g: l.install ? INSTALL[l.install] : null, l })).filter((x) => x.g);
const linkIcon = { download: 'download', open: 'external', github: 'github', releases: 'external', contact: 'telegram' } as const;
// Бренд в конце заголовка, если влезает в ~60 символов (столько показывает выдача).
const baseTitle = `${app.name} — ${pick(lang, app.short)}`;
const title = baseTitle.length + SITE_NAME.length + 3 <= 60 ? `${baseTitle} · ${SITE_NAME}` : baseTitle;
const site = Astro.site!;
const url = new URL(path(lang, app.slug), site).href;
const description = clip(pick(lang, app.about));
const ogPath = `og/${lang}/${app.slug}.png`;
const crumbs = [
  { name: SITE_NAME, url: path(lang) },
  { name: tr(lang, 'page.back'), url: `${path(lang)}#apps` },
  { name: app.name, url: path(lang, app.slug) },
];
const jsonld = graph(
  webpage({
    site, lang, url, name: title, description, updated: app.updated, breadcrumb: true,
    image: new URL(asset(ogPath), site).href, imageAlt: baseTitle,
    about: `${url}#app`, mainEntity: `${url}#app`,
  }),
  breadcrumbs(site, url, crumbs),
  application(site, lang, app, url),
  faq(url, lang, app),
  website(site),
  person(site, lang),
);
const updatedText = new Date(app.updated).toLocaleDateString(ru ? 'ru-RU' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const n = app.features.length;
const pad = (v: number) => String(v).padStart(2, '0');
---

<Layout lang={lang} title={title} description={description} slug={app.slug} og={ogPath} ogAlt={baseTitle} updated={app.updated} jsonld={jsonld}>
  <div class="app-page" data-tint style={`--tint-d:${app.tint.dark};--tint-l:${app.tint.light}`}>
    <section class="ap-hero container" aria-labelledby="ap-name" data-spy={app.name}>
      <div class="sec-bar">
        <nav class="crumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumb'}>
          <ol>
            <li><a href={path(lang)}>{SITE_NAME}</a></li>
            <li><a href={`${path(lang)}#apps`}>{tr(lang, 'page.back')}</a></li>
            <li><span aria-current="page">{app.name}</span></li>
          </ol>
        </nav>
        <span>{no} / {pick(lang, app.kind)}</span>
      </div>
      <div class="ap-grid bleed">
        <div class="ap-pass">
          <div class="ap-no" data-reveal><span class="tag-no">{no}</span><span class="pixel ap-no-big">№ {no}</span></div>
          <h1 class="display ap-name" id="ap-name" data-reveal>{app.name}</h1>
          <p class="ap-tag" data-reveal>{pick(lang, app.tagline)}</p>
          <div class="ap-cta" data-reveal>
            {
              app.links.map((l, i) => {
                /* Прямая ссылка на файл релиза — скачивание начинается в этой же вкладке, без перехода на GitHub. */
                const direct = /\/releases\/(latest\/)?download\//.test(l.href);
                return (
                  <a class:list={['btn', { 'btn-primary': i === 0 }]} href={l.href} {...(direct ? { download: '' } : { target: '_blank', rel: 'noopener' })} data-kind={l.kind} data-install={l.install ? i : undefined}>
                    <Icon name={linkIcon[l.kind]} />
                    {pick(lang, l.label)}
                  </a>
                );
              })
            }
          </div>
          <dl class="spec" data-reveal>
            <div>
              <dt>{ru ? 'Статус' : 'Status'}</dt>
              <dd><span class={`stag ${app.status}`}><i class="sq" />{pick(lang, STATUS[app.status])}</span></dd>
            </div>
            <div><dt>{ru ? 'Платформа' : 'Platform'}</dt><dd>{app.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · ')}</dd></div>
            {app.version && <div><dt>{tr(lang, 'page.version')}</dt><dd>{app.version}</dd></div>}
            {app.openSource && <div><dt>{ru ? 'Код' : 'Code'}</dt><dd>{tr(lang, 'page.source')}</dd></div>}
            <div><dt>{ru ? 'Автор' : 'Author'}</dt><dd><a href={path(lang, 'about')} rel="author">{pick(lang, CONTACTS.name)}</a></dd></div>
            <div><dt>{ru ? 'Обновлено' : 'Updated'}</dt><dd><time datetime={app.updated}>{updatedText}</time></dd></div>
          </dl>
        </div>
        <div class="ap-plate" data-reveal>
          <span class="crop tl"></span><span class="crop tr"></span><span class="crop bl"></span><span class="crop br"></span>
          <AppIcon slug={app.slug} name={app.name} size={260} eager vt style="view-transition-name: app-icon" class="ap-icon" />
          <span class="plate-lbl">{ru ? 'Изд.' : 'Item'} {no} · {app.name}</span>
        </div>
      </div>
    </section>

    <section class="ap-about container" aria-label={tr(lang, 'page.for')} data-spy={ru ? 'Описание' : 'About'}>
      <div class="sec-bar"><span>A / {ru ? 'Описание' : 'Description'}</span><span>{tr(lang, 'page.for')}</span></div>
      <div class="about-grid">
        <p class="ap-about-text">{pick(lang, app.about)}</p>
        <p class="ap-for"><span class="mono">{tr(lang, 'page.for')}</span>{pick(lang, app.audience)}</p>
      </div>
    </section>

    <section class="features container" aria-labelledby="feat-title" data-spy={tr(lang, 'page.features')}>
      <div class="sec-bar"><span>B / {tr(lang, 'page.features')}</span><span>{pad(n)} {ru ? 'функции' : 'features'}</span></div>
      <h2 class="sr-only" id="feat-title">{tr(lang, 'page.features')}</h2>
      {
        app.features.map((f, i) => (
          <article class="feat" data-reveal-group>
            <div class="feat-text" data-reveal>
              <span class="feat-no">{pad(i + 1)} / {pad(n)}</span>
              <h3 class="h2 feat-title">{f.title[lang]}</h3>
              <p class="lead">{pick(lang, f.text)}</p>
            </div>
            <div class="feat-plate" data-reveal>
              <div class="fp-bar">
                <span>{app.name} · {ru ? 'демо' : 'demo'} {pad(i + 1)}</span>
                <span>{tr(lang, 'page.demo')}</span>
              </div>
              <div class="fp-scene">
                <SceneSwitch id={f.scene} lang={lang} label={`${app.name}: ${pick(lang, f.title)}`} />
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <section class="how container" aria-labelledby="how-title" data-spy={tr(lang, 'page.how')}>
      <div class="sec-bar"><span>C / {tr(lang, 'page.how')}</span><span>03 {ru ? 'шага' : 'steps'}</span></div>
      <h2 class="h2" id="how-title">{tr(lang, 'page.how')}</h2>
      <ol class="steps">
        {
          app.steps.map((s, i) => (
            <li>
              <span class="pixel step-n">{pad(i + 1)}</span>
              <p>{pick(lang, s)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="faq-req container" data-spy={tr(lang, 'page.faq')}>
      <div class="sec-bar"><span>D / {tr(lang, 'page.faq')}</span><span>E / {tr(lang, 'page.req')}</span></div>
      <div class="fr-grid" data-reveal-group>
        <div class="faq" data-reveal>
          <h2 class="h2">{tr(lang, 'page.faq')}</h2>
          <div class="faq-list">
            {
              app.faq.map((q) => (
                <details>
                  <summary>
                    {pick(lang, q.q)}
                    <span class="pm" aria-hidden="true" />
                  </summary>
                  <p>{pick(lang, q.a)}</p>
                </details>
              ))
            }
          </div>
        </div>
        <aside class="req" aria-labelledby="req-title" data-reveal>
          <h2 class="h3" id="req-title">{tr(lang, 'page.req')}</h2>
          <ul>
            {
              app.requirements.map((r, i) => (
                <li>
                  <span class="mono">{pad(i + 1)}</span>
                  {pick(lang, r)}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <section class="others container" aria-labelledby="others-title" data-spy={tr(lang, 'page.other')}>
      <div class="sec-bar"><span>F / {tr(lang, 'page.other')}</span><span>{pad(others.length)}</span></div>
      <h2 class="h2" id="others-title">{tr(lang, 'page.other')}</h2>
      <div class="o-grid bleed">
        {others.map(({ a, i }) => <AppWindow app={a} lang={lang} index={i} compact />)}
      </div>
    </section>

    <section class="ap-contact container" data-spy={tr(lang, 'cc.title')}>
      <div class="sec-bar"><span>G / {tr(lang, 'cc.title')}</span><span>@{CONTACTS.telegram}</span></div>
      <div class="c-grid">
        <div>
          <h2 class="h2">{tr(lang, 'contact.title')}</h2>
          <p class="lead">{tr(lang, 'contact.lead')}</p>
        </div>
        <div class="c-cta">
          <a class="btn btn-primary" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
          <a class="btn" href={CONTACTS.order} target="_blank" rel="noopener"><Icon name="briefcase" />{tr(lang, 'contact.order')}</a>
        </div>
      </div>
    </section>
    <Footer lang={lang} />
  </div>
  {
    guides.length > 0 && (
      <dialog class="install" id="install-dialog" aria-labelledby="install-title">
        <form method="dialog" class="install-x"><button class="install-close" aria-label={ru ? 'Закрыть' : 'Close'}>×</button></form>
        {guides.map(({ i, g, l }) => (
          <section class="install-body" data-install-for={i} hidden>
            <p class="install-kicker">{app.name} · {ru ? 'первый запуск' : 'first launch'}</p>
            <h2 class="install-title" id={`install-title-${i}`}>{fill(pick(lang, g!.title))}</h2>
            <p class="install-lead">{fill(pick(lang, g!.lead))}</p>
            <ol class="install-steps">
              {g!.steps.map((st) => <li>{fill(pick(lang, st))}</li>)}
            </ol>
            {g!.note && <p class="install-note">{fill(pick(lang, g!.note))}</p>}
            {g!.command && (
              <div class="install-cmd">
                {g!.commandNote && <p>{fill(pick(lang, g!.commandNote))}</p>}
                <div class="cmd-row"><code>{fill(g!.command)}</code><button type="button" class="btn cmd-copy" data-copy={fill(g!.command)} data-done={ru ? 'Скопировано' : 'Copied'}>{ru ? 'Копировать' : 'Copy'}</button></div>
              </div>
            )}
            <div class="install-foot">
              <button type="button" class="btn btn-primary" data-install-close>{ru ? 'Понятно' : 'Got it'}</button>
              <a class="install-again" href={l.href} download>{ru ? 'Загрузка не началась? Скачать ещё раз' : 'Download didn’t start? Try again'}</a>
            </div>
          </section>
        ))}
      </dialog>
    )
  }
</Layout>

<script>
  // Окно с инструкцией первого запуска: скачивание идёт как обычно, окно открывается поверх страницы.
  const dlg = document.getElementById('install-dialog') as HTMLDialogElement | null;
  if (dlg) {
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('a[data-install]') as HTMLElement | null;
      if (!a) return;
      const id = a.dataset.install!;
      dlg.querySelectorAll<HTMLElement>('[data-install-for]').forEach((el) => {
        const on = el.dataset.installFor === id;
        el.hidden = !on;
        if (on) dlg.setAttribute('aria-labelledby', `install-title-${id}`);
      });
      if (!dlg.open) dlg.showModal();
      dlg.querySelector<HTMLElement>('[data-install-for]:not([hidden]) [data-install-close]')?.focus();
    });
    dlg.addEventListener('click', (e) => {
      const el = e.target as Element;
      if (el === dlg || el.closest('[data-install-close]')) dlg.close();
    });
    dlg.addEventListener('click', async (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!b) return;
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const old = b.textContent;
        b.textContent = b.dataset.done!;
        setTimeout(() => (b.textContent = old), 1800);
      } catch {
        /* буфер недоступен — команду можно выделить вручную */
      }
    });
  }
</script>

<style>
  .ap-hero {
    padding-top: calc(var(--menubar) + 24px);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--text-2);
    transition: color var(--fast) var(--ease);
  }
  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--accent);
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
  .ap-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }
  .ap-hero + section { margin-top: 0; }
  @media (min-width: 960px) {
    .ap-grid {
      grid-template-columns: 7fr 5fr;
    }
  }
  .ap-pass {
    display: grid;
    align-content: start;
    gap: 22px;
    padding: clamp(24px, 4vw, 56px) 0 32px var(--rail-pad);
    min-width: 0;
  }
  @media (min-width: 960px) {
    .ap-pass {
      padding-right: 40px;
      border-right: 1px solid var(--line);
    }
  }
  .ap-no {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ap-no-big {
    color: var(--tint);
    font-size: 28px;
    line-height: 1;
  }
  .ap-name {
    font-size: clamp(3.4rem, 1.6rem + 7vw, 8rem);
  }
  .ap-tag {
    max-width: 30ch;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-2);
    text-wrap: balance;
  }
  .ap-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .spec {
    margin: 8px 0 0;
    border-top: 1px solid var(--line-strong);
    max-width: 560px;
  }
  .spec div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .spec dt {
    color: var(--faint);
    font: 500 10.5px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .spec dd {
    margin: 0;
    font: 400 13px/1.5 var(--font-mono);
  }
  .ap-plate {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 340px;
    background: var(--plate);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .ap-plate {
      border-top: 0;
    }
  }
  .ap-plate :global(.ap-icon) {
    width: min(260px, 60vw);
    height: auto;
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.28));
  }
  .plate-lbl {
    position: absolute;
    left: 28px;
    bottom: 13px;
    color: var(--faint);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  section + section {
    margin-top: 80px;
  }
  .about-grid {
    display: grid;
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 8fr 4fr;
      gap: 40px;
    }
  }
  .ap-about-text {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .ap-for {
    display: grid;
    gap: 8px;
    align-content: start;
    padding-left: 16px;
    border-left: 2px solid var(--tint);
    color: var(--text-2);
  }
  .ap-for .mono {
    color: var(--faint);
  }

  /* Функции: строка с текстом и рамкой демо */
  .feat {
    display: grid;
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .feat {
      grid-template-columns: 4fr 8fr;
      gap: 40px;
      align-items: start;
    }
  }
  .feat-no {
    display: inline-block;
    color: var(--tint);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .feat-title {
    margin: 14px 0 14px;
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
  }
  @media (min-width: 960px) {
    .feat-text {
      position: sticky;
      top: calc(var(--menubar) + 64px); /* под прилипшей полосой раздела */
    }
  }
  .feat-plate {
    border: 1px solid var(--line-strong);
    background: var(--plate);
    min-width: 0;
  }
  .fp-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
    font: 500 10px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .fp-scene {
    position: relative;
  }

  /* Как это работает */
  .how .h2 {
    padding: 24px 0 28px;
    border-top: 1px solid var(--line);
  }
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: 20px 18px 26px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--cell);
  }
  .step-n {
    color: var(--tint);
    font-size: 44px;
    line-height: 1;
  }
  .steps p {
    font-size: 16.5px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* FAQ + требования */
  .fr-grid {
    display: grid;
    gap: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .fr-grid {
      grid-template-columns: 8fr 4fr;
      gap: 40px;
    }
  }
  .faq-list {
    margin-top: 24px;
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    transition: color var(--fast) var(--ease);
  }
  summary:hover {
    color: var(--accent);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pm {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 12px;
    height: 2px;
    background: currentColor;
    transition: transform var(--fast) var(--ease);
  }
  .pm::after {
    transform: rotate(90deg);
  }
  details[open] .pm::after {
    transform: rotate(0);
  }
  details p {
    padding: 0 0 20px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
    max-width: 64ch;
  }
  .req {
    align-self: start;
    padding: 20px;
    border: 1px solid var(--line-strong);
    background: var(--cell);
  }
  .req ul {
    display: grid;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .req li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.45;
  }
  .req li .mono {
    color: var(--tint);
    padding-top: 3px;
  }

  /* Другие приложения */
  .others .h2 {
    padding: 24px 0 28px;
    border-top: 1px solid var(--line);
  }
  .o-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);

---
import Layout from '../layouts/Layout.astro';
import type { App, Lang } from '../content/apps';
import { apps } from '../content/apps';
import { tr, path, pick, PLATFORM, STATUS, CONTACTS } from '../i18n';
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import SceneSwitch from './scenes/SceneSwitch.astro';

interface Props {
  app: App;
  lang: Lang;
}
const { app, lang } = Astro.props;
const others = apps.filter((a) => a.slug !== app.slug);
const linkIcon = { download: 'download', open: 'external', github: 'github', releases: 'external' } as const;
const pIcon = { macos: 'apple', windows: 'windows', web: 'web' } as const;
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => v / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const lightAccent = lum(app.accent) > 0.8;
const title = `${app.name} — ${pick(lang, app.short)}`;
const site = Astro.site!;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': app.platforms.includes('web') ? 'WebApplication' : 'SoftwareApplication',
  name: app.name,
  description: pick(lang, app.about),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: app.platforms.map((p) => PLATFORM[p].en).join(', '),
  ...(app.version ? { softwareVersion: app.version } : {}),
  url: new URL(path(lang, app.slug), site).href,
  image: new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icons/${app.slug}-512.png`, site).href,
  author: { '@type': 'Person', name: 'Ehroz', url: new URL(path(lang), site).href },
  ...(app.status === 'ready' ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } } : {}),
};
const n = app.features.length;
---

<Layout
  lang={lang}
  title={title}
  description={pick(lang, app.about).slice(0, 158)}
  slug={app.slug}
  og={`og/${lang}/${app.slug}.png`}
  glow={app.glow}
  accent={app.accent}
  onAccent={app.onAccent}
  jsonld={jsonld}
>
  <div class="app-page" data-light-accent={lightAccent ? '' : undefined}>
    <section class="ap-hero container">
      <a class="back" href={`${path(lang)}#apps`}><Icon name="arrow-left" size={16} />{tr(lang, 'page.back')}</a>
      <div class="ap-icon">
        <AppIcon slug={app.slug} name={app.name} size={220} eager vt style="view-transition-name: app-icon" class="ap-icon-img" />
        <AppIcon slug={app.slug} name="" size={220} decorative class="ap-icon-refl" />
      </div>
      <h1 class="display ap-name">{app.name}</h1>
      <p class="ap-tag">{pick(lang, app.tagline)}</p>
      <div class="ap-cta">
        {
          app.links.map((l, i) => (
            <a class:list={['btn magnetic', { 'btn-primary': i === 0 }]} href={l.href} target="_blank" rel="noopener">
              <Icon name={linkIcon[l.kind]} />
              {pick(lang, l.label)}
            </a>
          ))
        }
      </div>
      <div class="ap-meta">
        <span class={`chip ${app.status}`}><i class="dot"></i>{pick(lang, STATUS[app.status])}</span>
        {app.platforms.map((p) => <span class="chip"><Icon name={pIcon[p]} size={12} />{pick(lang, PLATFORM[p])}</span>)}
        {app.version && <span class="chip">{tr(lang, 'page.version')} {app.version}</span>}
        {app.openSource && <span class="chip">{tr(lang, 'page.source')}</span>}
      </div>
    </section>

    <section class="ap-about container reveal" aria-label={tr(lang, 'page.for')}>
      <p class="ap-about-text">{pick(lang, app.about)}</p>
      <p class="ap-for"><b>{tr(lang, 'page.for')}:</b> {pick(lang, app.audience)}</p>
    </section>

    <section class="features" aria-label={tr(lang, 'page.features')}>
      <h2 class="sr-only">{tr(lang, 'page.features')}</h2>
      {
        app.features.map((f, i) => (
          <article class="slide">
            <div class="slide-in container">
              <div class="slide-text">
                <span class="slide-num">
                  {String(i + 1).padStart(2, '0')}
                  <i>/ {String(n).padStart(2, '0')}</i>
                </span>
                <h3 class="h2 slide-title">{pick(lang, f.title)}</h3>
                <p class="lead">{pick(lang, f.text)}</p>
              </div>
              <div class="slide-win">
                <div class="sw-bar">
                  <span class="lights"><i /><i /><i /></span>
                  <span class="sw-title">{app.name}</span>
                  <span class="sw-demo">{tr(lang, 'page.demo')}</span>
                </div>
                <SceneSwitch id={f.scene} lang={lang} label={`${app.name}: ${pick(lang, f.title)}`} />
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <section class="how container" aria-labelledby="how-title">
      <h2 class="h2 reveal" id="how-title">{tr(lang, 'page.how')}</h2>
      <ol class="steps">
        {
          app.steps.map((s, i) => (
            <li class="step glass reveal" style={`--d:${i * 90}ms`}>
              <span class="step-n">{i + 1}</span>
              <p>{pick(lang, s)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="faq-req container">
      <div class="faq reveal">
        <h2 class="h2">{tr(lang, 'page.faq')}</h2>
        <div class="faq-list">
          {
            app.faq.map((q) => (
              <details>
                <summary>
                  {pick(lang, q.q)}
                  <span class="pm" aria-hidden="true" />
                </summary>
                <p>{pick(lang, q.a)}</p>
              </details>
            ))
          }
        </div>
      </div>
      <aside class="req glass reveal" aria-labelledby="req-title">
        <h2 class="h3" id="req-title">{tr(lang, 'page.req')}</h2>
        <ul>
          {app.requirements.map((r) => <li><Icon name="check" size={16} />{pick(lang, r)}</li>)}
        </ul>
      </aside>
    </section>

    <section class="others container" aria-labelledby="others-title">
      <h2 class="h3 reveal" id="others-title">{tr(lang, 'page.other')}</h2>
      <ul class="mini-dock glass reveal">
        {
          others.map((a) => (
            <li>
              <a href={path(lang, a.slug)} data-app-link={a.slug}>
                <AppIcon slug={a.slug} name={a.name} size={72} decorative vt />
                <b>{a.name}</b>
                <small>{pick(lang, a.short)}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="ap-contact container reveal">
      <div>
        <h2 class="h3">{tr(lang, 'contact.title')}</h2>
        <p class="lead">{tr(lang, 'contact.lead')}</p>
      </div>
      <div class="ap-contact-cta">
        <a class="btn btn-primary magnetic" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
        <a class="btn magnetic" href={CONTACTS.order} target="_blank" rel="noopener"><Icon name="briefcase" />{tr(lang, 'contact.order')}</a>
      </div>
    </section>
    <footer class="foot container">
      <span>© 2026 Ehroz · ehroz.pro</span>
      <span>{tr(lang, 'foot.made')}</span>
    </footer>
  </div>
</Layout>

<style>
  .app-page {
    --accent: var(--app-accent);
    --on-accent: var(--app-on-accent);
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .app-page[data-light-accent] {
      --accent: #1d1d1f;
      --on-accent: #fff;
    }
  }
  :global(:root[data-theme='light']) .app-page[data-light-accent] {
    --accent: #1d1d1f;
    --on-accent: #fff;
  }

  .ap-hero {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: calc(var(--menubar) + 36px) 0 40px;
  }
  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px 0 10px;
    border-radius: 999px;
    background: var(--chip);
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 560;
    transition: color 0.2s, background 0.2s;
  }
  .back:hover {
    color: var(--text);
    background: var(--hover);
  }
  .ap-icon {
    position: relative;
    margin-top: 20px;
    width: 220px;
    height: 220px;
  }
  .ap-icon :global(.ap-icon-img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 220px;
    height: 220px;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 60px color-mix(in srgb, var(--wall-a) 45%, transparent));
    animation: icon-in 1s var(--spring) both;
  }
  .ap-icon :global(.ap-icon-refl) {
    position: absolute;
    left: 0;
    top: 100%;
    width: 220px;
    height: 220px;
    margin-top: -26px;
    transform: scaleY(-1);
    opacity: 0.14;
    filter: blur(2px);
    -webkit-mask-image: linear-gradient(to top, #000, transparent 45%);
    mask-image: linear-gradient(to top, #000, transparent 45%);
    pointer-events: none;
  }
  @keyframes icon-in {
    from {
      transform: translateY(16px) scale(0.92);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (view-transition-name: a) {
      /* при переходе со страницы иконку анимирует View Transition, а не собственная анимация */
      :global(html:active-view-transition) .ap-icon :global(.ap-icon-img) {
        animation: none;
      }
    }
  }
  .ap-name {
    position: relative;
    z-index: 1;
    margin-top: 6px;
    font-size: clamp(3.2rem, 2rem + 6vw, 7rem);
    animation: rise 0.9s 0.1s var(--ease-out) both;
  }
  .ap-tag {
    max-width: 680px;
    margin-top: 14px;
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--muted);
    text-wrap: balance;
    animation: rise 0.9s 0.18s var(--ease-out) both;
  }
  .ap-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
    animation: rise 0.9s 0.26s var(--ease-out) both;
  }
  .ap-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 18px;
    animation: rise 0.9s 0.32s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .ap-about {
    max-width: 900px;
    margin-top: 60px;
    text-align: center;
  }
  .ap-about-text {
    font-size: clamp(1.2rem, 1.02rem + 0.8vw, 1.7rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }
  .ap-for {
    margin-top: 16px;
    color: var(--muted);
  }
  .ap-for b {
    color: var(--text);
    font-weight: 600;
  }

  /* Слайды-фичи */
  .features {
    margin-top: 80px;
  }
  .slide {
    position: relative;
  }
  .slide-in {
    display: grid;
    gap: 28px;
    padding: 50px 0;
  }
  .slide-num {
    display: inline-flex;
    gap: 6px;
    font: 600 13px/1 var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .slide-num i {
    font-style: normal;
    color: var(--faint);
  }
  .slide-text .lead {
    color: color-mix(in srgb, var(--text) 80%, transparent);
  }
  .slide-text {
    text-shadow: 0 1px 18px color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .slide-title {
    margin: 14px 0 16px;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
  }
  .slide-win {
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: 0 0 0 0.5px var(--line-strong), var(--shadow-2);
  }
  .sw-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 14px;
    background: var(--glass-strong);
    border-bottom: 0.5px solid var(--line);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .sw-bar .lights {
    position: absolute;
    left: 14px;
  }
  .sw-bar .lights i {
    width: 11px;
    height: 11px;
  }
  .sw-demo {
    position: absolute;
    right: 14px;
    font-weight: 500;
    font-size: 11.5px;
    color: var(--faint);
  }
  @media (max-width: 520px) {
    .sw-demo {
      display: none;
    }
  }
  @media (min-width: 960px) {
    .slide {
      height: 165vh;
      view-timeline-name: --slide;
    }
    .slide-in {
      position: sticky;
      top: calc(var(--menubar) + max(16px, (100vh - var(--menubar) - min(78vh, 640px)) / 2 - 20px));
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: 20px;
      padding: 0;
    }
    .slide-text {
      grid-column: 1 / span 4;
    }
    .slide-win {
      grid-column: 6 / span 7;
    }
    .slide:nth-child(even) .slide-text {
      grid-column: 9 / span 4;
      grid-row: 1;
    }
    .slide:nth-child(even) .slide-win {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .slide-text,
        .slide-win {
          animation: slide-in linear both;
          animation-timeline: --slide;
          animation-range: entry 5% entry 75%;
        }
        .slide-win {
          animation-name: win-in;
        }
      }
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
  }
  @keyframes win-in {
    from {
      opacity: 0;
      transform: translateY(80px) scale(0.92) rotateX(8deg);
    }
  }

  /* Как это работает */
  .how {
    margin-top: 80px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    padding: 26px 24px 28px;
    border-radius: 22px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--on-accent);
    font: 700 18px/1 var(--font-display);
    margin-bottom: 18px;
  }
  .step p {
    font-size: 16.5px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* FAQ + требования */
  .faq-req {
    display: grid;
    gap: 24px;
    margin-top: 120px;
  }
  @media (min-width: 960px) {
    .faq-req {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .faq {
      grid-column: span 7;
    }
    .req {
      grid-column: 9 / span 4;
      align-self: start;
      position: sticky;
      top: calc(var(--menubar) + 24px);
    }
  }
  .faq-list {
    margin-top: 24px;
    border-top: 0.5px solid var(--line);
  }
  details {
    border-bottom: 0.5px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 2px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pm {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: var(--muted);
    transition: transform 0.35s var(--spring);
  }
  .pm::after {
    transform: rotate(90deg);
  }
  details[open] .pm::after {
    transform: rotate(0);
  }
  details p {
    padding: 0 2px 22px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
    max-width: 640px;
  }
  details[open] p {
    animation: rise 0.4s var(--ease-out);
  }
  .req {
    padding: 26px;
    border-radius: 22px;
  }
  .req ul {
    display: grid;
    gap: 12px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }
  .req li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }
  .req li :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--ok);
  }

  /* Другие приложения */
  .others {
    margin-top: 120px;
  }
  .mini-dock {
    display: flex;
    gap: 8px;
    margin-top: 22px;
    padding: 10px;
    border-radius: 26px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .mini-dock li {
    flex: 1 0 150px;
  }
  .mini-dock a {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 14px 10px 16px;
    border-radius: 18px;
    text-align: center;
    transition: background 0.2s;
  }
  .mini-dock a:hover {
    background: var(--hover);
  }
  .mini-dock :global(img) {
    width: 72px;
    height: 72px;
    margin-bottom: 4px;
    transition: transform 0.45s var(--spring);
  }
  .mini-dock a:hover :global(img) {
    transform: translateY(-6px) scale(1.08);
  }
  .mini-dock b {
    font-size: 14.5px;
  }
  .mini-dock small {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.35;
  }

  .ap-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 100px;
    padding: 34px 0;
  }
  .ap-contact .lead {
    margin-top: 6px;
  }
  .ap-contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: 40px;
    padding: 28px 0 130px;
    border-top: 0.5px solid var(--line);
    color: var(--faint);
    font-size: 13px;
  }
</style>

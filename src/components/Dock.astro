---
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { path, tr, pick, CONTACTS } from '../i18n';
import AppIcon from './AppIcon.astro';
import Mark from './Mark.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  current?: string;
}
const { lang, current = '' } = Astro.props;
---

<nav class="dock-wrap" aria-label="Dock" style="view-transition-name: dock">
  <ul class="dock glass" data-dock>
    <li class="dock-item" data-label={tr(lang, 'menu.home')}>
      <a href={path(lang)} aria-label={tr(lang, 'menu.home')} aria-current={current === '' ? 'page' : undefined}>
        <span class="dock-tile tile-home"><Mark size={26} /></span>
      </a>
      <span class="dock-tip" aria-hidden="true">{tr(lang, 'menu.home')}</span>
      {current === '' && <i class="dock-dot" />}
    </li>
    <li class="dock-sep" aria-hidden="true"></li>
    {
      apps.map((a) => (
        <li class="dock-item" data-label={a.name}>
          <a href={path(lang, a.slug)} aria-label={`${a.name} — ${pick(lang, a.short)}`} aria-current={current === a.slug ? 'page' : undefined} data-app-link={a.slug}>
            <AppIcon slug={a.slug} name={a.name} size={64} class="dock-icon" decorative />
          </a>
          <span class="dock-tip" aria-hidden="true">{a.name}</span>
          {current === a.slug && <i class="dock-dot" />}
        </li>
      ))
    }
    <li class="dock-sep" aria-hidden="true"></li>
    <li class="dock-item" data-label="Telegram">
      <a href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener" aria-label={`Telegram @${CONTACTS.telegram}`}>
        <span class="dock-tile tile-tg"><Icon name="telegram" size={26} /></span>
      </a>
      <span class="dock-tip" aria-hidden="true">Telegram</span>
    </li>
  </ul>
</nav>

<style>
  .dock-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 10px;
    z-index: 45;
    display: flex;
    justify-content: center;
    pointer-events: none;
    padding: 0 8px;
  }
  .dock {
    --base: 54px;
    pointer-events: auto;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: calc(var(--base) + 16px);
    padding: 8px 8px;
    margin: 0;
    list-style: none;
    border-radius: 24px;
    max-width: 100%;
    background: color-mix(in srgb, var(--glass) 85%, transparent);
  }
  .dock-item {
    --s: 1;
    position: relative;
    width: calc(var(--base) * var(--s));
    height: calc(var(--base) * var(--s));
    flex: none;
    transition: width 0.18s var(--ease-out), height 0.18s var(--ease-out);
  }
  .dock.live .dock-item {
    transition: none;
  }
  .dock-item a {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
  }
  .dock-item a:active :global(img),
  .dock-item a:active .dock-tile {
    filter: brightness(0.75);
  }
  .dock-item :global(.dock-icon) {
    display: block;
    width: 116%;
    height: 116%;
    margin: -8%;
    max-width: none;
  }
  .dock-tile {
    position: absolute;
    inset: 8%;
    display: grid;
    place-items: center;
    border-radius: 23%;
    color: #fff;
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.2), 0 3px 8px rgba(0, 0, 0, 0.25);
  }
  .dock-tile :global(svg) {
    width: 46%;
    height: 46%;
  }
  .tile-home {
    background: linear-gradient(160deg, #2a2a33, #0e0e12);
  }
  .tile-tg {
    background: linear-gradient(180deg, #37aee2, #1e96c8);
  }
  .dock-sep {
    width: 1px;
    align-self: stretch;
    margin: 4px 5px;
    background: var(--line-strong);
    flex: none;
  }
  .dock-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    translate: -50% 4px;
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: var(--glass-edge), var(--shadow-1);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s, translate 0.25s var(--spring);
  }
  .dock-item:hover .dock-tip,
  .dock-item:focus-within .dock-tip {
    opacity: 1;
    translate: -50% 0;
  }
  .dock-dot {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--text);
    opacity: 0.8;
  }
  .dock-item.bounce {
    animation: bounce 0.9s var(--ease-out);
  }
  @keyframes bounce {
    0%,
    100% {
      transform: none;
    }
    25% {
      transform: translateY(-26px);
    }
    50% {
      transform: none;
    }
    70% {
      transform: translateY(-12px);
    }
  }

  @media (max-width: 760px), (pointer: coarse) {
    .dock-wrap {
      bottom: max(8px, env(safe-area-inset-bottom));
    }
    .dock {
      --base: 46px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      justify-content: flex-start;
      border-radius: 22px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 10px, #000 calc(100% - 10px), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 10px, #000 calc(100% - 10px), transparent);
    }
    .dock::-webkit-scrollbar {
      display: none;
    }
    .dock-tip {
      display: none;
    }
    .dock-dot {
      bottom: -5px;
    }
  }
</style>

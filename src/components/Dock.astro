---
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { path, tr, pick, CONTACTS } from '../i18n';
import AppIcon from './AppIcon.astro';
import Mark from './Mark.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  current?: string;
}
const { lang, current = '' } = Astro.props;
---

<nav class="dock-wrap" aria-label="Dock" style="view-transition-name: dock">
  <ul class="dock" data-dock>
    <li class="dock-item">
      <a href={path(lang)} aria-current={current === '' ? 'page' : undefined}>
        <span class="no">00</span>
        <span class="tile"><Mark size={22} /></span>
        <span class="lbl">{tr(lang, 'menu.home')}</span>
      </a>
    </li>
    {
      apps.map((a, i) => (
        <li class="dock-item" data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
          <a href={path(lang, a.slug)} aria-label={`${a.name} — ${pick(lang, a.short)}`} aria-current={current === a.slug ? 'page' : undefined} data-app-link={a.slug}>
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <AppIcon slug={a.slug} name={a.name} size={64} class="dock-icon" decorative />
            <span class="lbl">{a.name}</span>
          </a>
        </li>
      ))
    }
    <li class="dock-item">
      <a href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener" aria-label={`Telegram @${CONTACTS.telegram}`}>
        <span class="no">TG</span>
        <span class="tile"><Icon name="telegram" size={20} /></span>
        <span class="lbl">Telegram</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  .dock-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 45;
    display: flex;
    justify-content: center;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .dock {
    display: flex;
    height: var(--dock-h);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    border-left: 1px solid var(--line);
  }
  .dock::-webkit-scrollbar {
    display: none;
  }
  .dock-item {
    flex: none;
    border-right: 1px solid var(--line);
  }
  .dock-item a {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    width: 76px;
    height: 100%;
    padding: 5px 4px 7px;
    transition: background var(--fast) var(--ease);
  }
  .dock-item a:hover {
    background: var(--hover);
  }
  .dock-item a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--tint, var(--text));
  }
  .no {
    justify-self: start;
    color: var(--faint);
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.06em;
  }
  .dock-item a[aria-current='page'] .no {
    color: var(--tint, var(--text));
  }
  .dock-item :global(.dock-icon),
  .tile {
    width: 40px;
    height: 40px;
    margin-top: -4px;
    transition: transform var(--fast) var(--ease);
  }
  .dock-item :global(.dock-icon) {
    width: 46px;
    height: 46px;
    margin: -7px 0 -3px;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: -2px 0 2px;
    border: 1px solid var(--line-strong);
    color: var(--text);
  }
  .dock-item a:hover :global(.dock-icon),
  .dock-item a:hover .tile {
    transform: translateY(-3px);
  }
  .lbl {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font: 500 9.5px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .dock-item a {
      width: 64px;
    }
  }
</style>

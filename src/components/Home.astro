---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../content/apps';
import { apps, homeUpdated } from '../content/apps';
import { tr, path, pick, asset, CONTACTS, PLATFORM } from '../i18n';
import { graph, webpage, appList, website, person, schemaIds } from '../lib/schema';
import AppWindow from './AppWindow.astro';
import AppIcon from './AppIcon.astro';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ru = lang === 'ru';
const site = Astro.site!;
const homeUrl = new URL(path(lang), site).href;
const jsonld = graph(
  webpage({
    site, lang, url: homeUrl, type: 'CollectionPage', name: tr(lang, 'meta.title'), description: tr(lang, 'meta.description'),
    updated: homeUpdated(), image: new URL(asset(`og/${lang}/home.png`), site).href, imageAlt: tr(lang, 'meta.title'),
    about: schemaIds(site).person, mainEntity: `${homeUrl}#apps`,
  }),
  appList(site, lang, apps, homeUrl),
  website(site),
  person(site, lang),
);
// Эта карточка в каталоге шире остальных и лежит горизонтально.
const WIDE = 'sukhan';
---

<Layout lang={lang} title={tr(lang, 'meta.title')} description={tr(lang, 'meta.description')} jsonld={jsonld} updated={homeUpdated()}>
  <section class="hero container" aria-labelledby="hero-title" data-spy={ru ? 'Главная' : 'Home'}>
    <div class="hero-grid bleed">
      <div class="hero-main">
        <h1 class="hero-title" id="hero-title">{tr(lang, 'hero.title')}</h1>
        <p class="hero-lead">{tr(lang, 'hero.lead')}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#apps"><Icon name="arrow" />{tr(lang, 'hero.cta')}</a>
        </div>
      </div>
      <nav class="hero-index" aria-label={ru ? 'Каталог приложений' : 'App index'}>
        <ol>
          {
            apps.map((a) => (
              <li>
                <a href={path(lang, a.slug)} data-app-link={a.slug}>
                  <AppIcon slug={a.slug} name={a.name} size={64} decorative eager vt />
                  <span class="hi-name">{a.name}</span>
                  <span class="hi-plat">{a.platforms.map((p) => pick(lang, PLATFORM[p])).join(', ')}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <section class="apps container" id="apps" aria-labelledby="apps-title" data-spy={ru ? 'Приложения' : 'Apps'}>
    <header class="sec-head">
      <h2 class="h2" id="apps-title">{tr(lang, 'apps.title')}</h2>
      <p class="lead">{tr(lang, 'apps.lead')}</p>
    </header>
    <div class="cards bleed">
      {apps.map((a, i) => <AppWindow app={a} lang={lang} featured={i === 0} wide={a.slug === WIDE} index={i} />)}
    </div>
  </section>

  <section class="about container" id="about" aria-labelledby="about-title" data-spy={ru ? 'Об Ehroz' : 'About'}>
    <div class="about-grid">
      <div class="about-who">
        <Avatar size={72} />
        <h2 class="h3" id="about-title">{tr(lang, 'about.title')}</h2>
      </div>
      <p class="about-text">{tr(lang, 'about.text')} <a href={path(lang, 'about')}>{ru ? 'Подробнее обо мне' : 'More about me'}</a></p>
    </div>
  </section>

  <section class="contact container" id="contact" aria-labelledby="contact-title" data-spy={ru ? 'Контакты' : 'Contact'}>
    <div class="contact-grid">
      <div>
        <h2 class="h2" id="contact-title">{tr(lang, 'contact.title')}</h2>
        <p class="lead">{tr(lang, 'contact.lead')}</p>
      </div>
      <div class="contact-cta">
        <a class="btn btn-primary" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{ru ? 'Написать в Telegram' : 'Message on Telegram'}</a>
        <p class="contact-alt">
          {ru ? 'Или на почту ' : 'Or by email at '}<a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a>.
          {ru ? ' Все способы связи на странице ' : ' Every other way to reach me is on the '}<a href={path(lang, 'contacts')}>{ru ? 'контактов' : 'contacts page'}</a>.
        </p>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .hero {
    padding-top: calc(var(--menubar) + 24px);
  }
  .hero-grid {
    display: grid;
    border-top: 1px solid var(--line);
    grid-template-columns: minmax(0, 1fr);
  }
  /* следующий раздел начинается сразу под первым экраном — общая линия */
  .hero + section { margin-top: 0; }
  .hero-main {
    display: grid;
    align-content: center;
    padding: clamp(36px, 7vw, 96px) var(--rail-pad) clamp(32px, 5vw, 80px);
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .hero-main { padding-right: 48px; }
  }
  .hero-title {
    margin: 0 0 28px;
    font-family: var(--font-sans);
    max-width: 18ch;
    font-size: clamp(2rem, 0.6rem + 2.4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hero-lead {
    max-width: 640px;
    margin: 0 0 36px;
    color: var(--muted);
    font-size: clamp(16px, 0.5vw + 12px, 19px);
    line-height: 1.6;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-index { border-top: 1px solid var(--line); }
  @media (min-width: 1000px) {
    .hero-index { border-top: 0; border-left: 1px solid var(--line); }
  }
  .hero-index ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) and (max-width: 999px) {
    .hero-index ol { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hero-index li:nth-child(4n) { border-right: 0; }
  }
  .hero-index li { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  @media (max-width: 559px), (min-width: 1000px) {
    .hero-index li:nth-child(3n) { border-right: 0; }
  }
  @media (min-width: 1000px) {
    .hero-index li:nth-last-child(-n + 3) { border-bottom: 0; }
  }
  .hero-index a {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 2px;
    height: 100%;
    padding: 22px 8px 18px;
    text-align: center;
    transition: background var(--fast) var(--ease);
  }
  .hero-index a:hover { background: var(--hover); }
  .hero-index :global(img) {
    width: 64px;
    height: 64px;
    margin: -6px 0 2px;
    transition: transform var(--mid) var(--ease);
  }
  .hero-index a:hover :global(img) { transform: translateY(-4px); }
  .hi-name { font-weight: 650; font-size: 14.5px; }
  .hi-plat {
    color: var(--faint);
    font-size: 12px;
    line-height: 1.4;
  }

  section + section {
    margin-top: 96px;
  }
  .sec-head {
    display: grid;
    gap: 14px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .sec-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
    .cards > :global(.featured),
    .cards > :global(.wide) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* Morfus занимает квадрат 2×2, Sukhan лежит горизонтально на две колонки */
    .cards > :global(.featured) {
      grid-row: span 2;
    }
  }

  .about-grid {
    display: grid;
    gap: 24px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 5fr 7fr;
    }
  }
  .about-who {
    display: grid;
    align-content: start;
    gap: 16px;
  }
  .about-text {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .contact-grid {
    display: grid;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .contact-grid .lead {
    margin-top: 12px;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
  .contact-cta {
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .contact-alt {
    max-width: 44ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .contact-alt a,
  .about-text a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .contact-alt a:hover,
  .about-text a:hover {
    text-decoration-color: currentColor;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { tr, path, pick, CONTACTS, PLATFORM } from '../i18n';
import AppWindow from './AppWindow.astro';
import AppIcon from './AppIcon.astro';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ru = lang === 'ru';
const platforms = new Set(apps.flatMap((a) => a.platforms)).size;
const ready = apps.filter((a) => a.status === 'ready').length;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ehroz',
  jobTitle: 'Designer & Developer',
  url: new URL(path(lang), Astro.site).href,
  email: `mailto:${CONTACTS.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Astana', addressCountry: 'KZ' },
  sameAs: [`https://t.me/${CONTACTS.telegram}`, `https://instagram.com/${CONTACTS.instagram}`, `https://github.com/${CONTACTS.github}`],
};
const stats = [
  [String(apps.length).padStart(2, '0'), ru ? 'продуктов' : 'products'],
  [String(ready).padStart(2, '0'), ru ? 'уже доступны' : 'available now'],
  [String(platforms).padStart(2, '0'), ru ? 'платформы' : 'platforms'],
  ['RU·EN·KZ', ru ? 'языки речи в BLA-БЛА и Sukhan' : 'speech languages in BLA-БЛА & Sukhan'],
];
---

<Layout lang={lang} title={tr(lang, 'meta.title')} description={tr(lang, 'meta.description')} jsonld={jsonld}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="sec-bar">
      <span>01 / {ru ? 'Мастерская Ehroz' : 'Ehroz workshop'}</span>
      <span>{tr(lang, 'hero.eyebrow')}</span>
    </div>
    <div class="hero-grid">
      <div class="hero-main">
        <h1 class="display hero-title" id="hero-title">
          <span class="t1">{tr(lang, 'hero.title1')}</span>
          <span class="t2">{tr(lang, 'hero.title2')} <span class="hl">{tr(lang, 'hero.title3')}</span></span>
        </h1>
        <p class="lead hero-lead">{tr(lang, 'hero.lead')}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#apps">{tr(lang, 'hero.cta')} <Icon name="arrow" /></a>
          <a class="btn" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{tr(lang, 'hero.contact')}</a>
          <button class="btn" type="button" data-open="spotlight"><Icon name="search" />⌘K {tr(lang, 'hero.spotlight')}</button>
        </div>
        <p class="hero-note">macOS · Windows · {ru ? 'Веб' : 'Web'} — {apps.length} {ru ? 'изделий' : 'products'} · {ru ? 'без cookies и трекеров' : 'no cookies, no trackers'}</p>
      </div>
      <nav class="hero-index" aria-label={tr(lang, 'apps.title')}>
        <ol>
          {
            apps.map((a, i) => (
              <li data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
                <a href={path(lang, a.slug)} data-app-link={a.slug}>
                  <AppIcon slug={a.slug} name={a.name} size={64} decorative eager vt />
                  <span class="hi-no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="hi-name">{a.name}</span>
                  <span class="hi-plat">{a.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · ')}</span>
                </a>
              </li>
            ))
          }
          <li class="hi-more">
            <a href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener">
              <span class="hi-no">08</span>
              <span class="hi-plus" aria-hidden="true">+</span>
              <span class="hi-name">{ru ? 'Новые изделия' : 'More on the way'}</span>
              <span class="hi-plat">{ru ? 'Следите в Telegram' : 'Follow on Telegram'}</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <section class="apps container" id="apps" aria-labelledby="apps-title">
    <div class="sec-bar">
      <span>02 / {tr(lang, 'apps.title')}</span>
      <span>{ru ? 'Выберите изделие' : 'Pick a product'}</span>
    </div>
    <header class="sec-head">
      <h2 class="h2" id="apps-title">{tr(lang, 'apps.title')}</h2>
      <p class="lead">{tr(lang, 'apps.lead')}</p>
    </header>
    <div class="cards">
      {apps.map((a, i) => <AppWindow app={a} lang={lang} featured={i === 0} index={i} />)}
    </div>
  </section>

  <section class="about container" id="about" aria-labelledby="about-title">
    <div class="sec-bar">
      <span>03 / {tr(lang, 'about.title')}</span>
      <span>{CONTACTS.city[lang]} · UTC+5</span>
    </div>
    <div class="about-grid">
      <div class="about-who">
        <Avatar size={72} />
        <h2 class="h3" id="about-title">Ehroz · designer &amp; developer</h2>
      </div>
      <p class="about-text">{tr(lang, 'about.text')}</p>
    </div>
    <dl class="stats">
      {
        stats.map(([n, l], i) => (
          <div data-i={String(i + 1).padStart(2, '0')}>
            <dt class:list={['pixel', { long: n.length > 3 }]}>{n}</dt>
            <dd>{l}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="contact container" id="contact" aria-labelledby="contact-title">
    <div class="sec-bar">
      <span>04 / {tr(lang, 'cc.title')}</span>
      <span>@{CONTACTS.telegram}</span>
    </div>
    <div class="contact-grid">
      <div>
        <h2 class="h2" id="contact-title">{tr(lang, 'contact.title')}</h2>
        <p class="lead">{tr(lang, 'contact.lead')}</p>
      </div>
      <div class="contact-cta">
        <a class="btn btn-primary" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />@{CONTACTS.telegram}</a>
        <a class="btn" href={CONTACTS.order} target="_blank" rel="noopener"><Icon name="briefcase" />{tr(lang, 'contact.order')}</a>
        <a class="btn" href={`mailto:${CONTACTS.email}`}><Icon name="mail" />Email</a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .hero {
    padding-top: calc(var(--menubar) + 24px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .hero-main {
    grid-column: span 12;
    display: grid;
    align-content: start;
    gap: 24px;
    padding: clamp(28px, 5vw, 64px) 0 clamp(28px, 4vw, 48px);
    min-width: 0;
  }
  .hero-index {
    grid-column: span 12;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .hero-main {
      grid-column: span 8;
      padding-right: 40px;
      border-right: 1px solid var(--line);
    }
    .hero-index {
      grid-column: span 4;
      border-top: 0;
    }
  }
  .hero-title {
    display: grid;
    gap: 0.06em;
    font-size: clamp(2.3rem, 0.9rem + 3.9vw, 4.6rem);
  }
  .t1 {
    font-size: 1.9em;
    letter-spacing: -0.055em;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hero-note {
    color: var(--faint);
    font: 500 10.5px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-index ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) and (max-width: 999px) {
    .hero-index ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hero-index li {
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  @media (min-width: 1000px) {
    .hero-index li:nth-child(2n) {
      border-right: 0;
    }
  }
  .hero-index a {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 16px 8px 14px;
    text-align: center;
    transition: background var(--fast) var(--ease);
  }
  .hero-index a:hover {
    background: var(--hover);
  }
  .hero-index :global(img) {
    width: 64px;
    height: 64px;
    margin: -6px 0 2px;
    transition: transform var(--mid) var(--ease);
  }
  .hero-index a:hover :global(img) {
    transform: translateY(-4px);
  }
  .hi-no {
    position: absolute;
    top: 8px;
    left: 10px;
    color: var(--tint);
    font: 500 10px/1 var(--font-mono);
  }
  .hi-plus {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 0 8px;
    border: 1px dashed var(--line-strong);
    color: var(--faint);
    font: 300 28px/1 var(--font-mono);
  }
  .hi-more .hi-no {
    color: var(--faint);
  }
  .hi-name {
    font-weight: 650;
    font-size: 14.5px;
  }
  .hi-plat {
    color: var(--faint);
    font: 500 9.5px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  section + section {
    margin-top: 96px;
  }
  .sec-head {
    display: grid;
    gap: 14px;
    padding: 24px 0 32px;
  }
  @media (min-width: 900px) {
    .sec-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards > :global(.featured) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .about-grid {
    display: grid;
    gap: 24px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 5fr 7fr;
    }
  }
  .about-who {
    display: grid;
    align-content: start;
    gap: 16px;
  }
  .about-text {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stats div {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 36px 16px 18px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--cell);
    min-width: 0;
  }
  .stats div::before {
    content: attr(data-i);
    position: absolute;
    top: 12px;
    right: 14px;
    color: var(--faint);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .stats dt {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
  }
  .stats dt.long {
    font-size: clamp(24px, 2.6vw, 34px);
    padding-block: 0.4em;
  }
  .stats dd {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .contact-grid {
    display: grid;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .contact-grid .lead {
    margin-top: 12px;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (min-width: 900px) {
    .contact-cta {
      justify-content: flex-end;
    }
  }
</style>

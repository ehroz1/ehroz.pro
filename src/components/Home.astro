---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { tr, path, CONTACTS } from '../i18n';
import AppWindow from './AppWindow.astro';
import AppIcon from './AppIcon.astro';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const featured = apps[0];
const rest = apps.slice(1);
// Позиции «плавающих» иконок вокруг заголовка: x/y в %, глубина параллакса, размер.
const floaters = [
  { slug: 'morfus', x: 8, y: 22, z: 1.2, s: 96, r: -8 },
  { slug: 'pachaq', x: 86, y: 16, z: 0.8, s: 84, r: 9 },
  { slug: 'sukhan', x: 92, y: 62, z: 1.4, s: 76, r: -6 },
  { slug: 'morfu', x: 4, y: 70, z: 0.7, s: 72, r: 7 },
  { slug: 'picta', x: 74, y: 86, z: 1, s: 64, r: -10 },
  { slug: 'bla-bla', x: 20, y: 90, z: 0.9, s: 60, r: 8 },
  { slug: 'radius', x: 64, y: 6, z: 0.6, s: 56, r: -4 },
];
const platforms = new Set(apps.flatMap((a) => a.platforms)).size;
const ready = apps.filter((a) => a.status === 'ready').length;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ehroz',
  jobTitle: 'Designer & Developer',
  url: new URL(path(lang), Astro.site).href,
  email: `mailto:${CONTACTS.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Astana', addressCountry: 'KZ' },
  sameAs: [`https://t.me/${CONTACTS.telegram}`, `https://instagram.com/${CONTACTS.instagram}`, `https://github.com/${CONTACTS.github}`],
};
---

<Layout lang={lang} title={tr(lang, 'meta.title')} description={tr(lang, 'meta.description')} jsonld={jsonld}>
  <section class="hero" data-hero>
    <div class="floaters" aria-hidden="true">
      {
        floaters.map((f, i) => (
          <span class="fl" style={`left:${f.x}%;top:${f.y}%;--z:${f.z};--r:${f.r}deg;--i:${i}`}>
            <AppIcon slug={f.slug} name="" size={f.s} decorative eager={i < 3} />
          </span>
        ))
      }
    </div>
    <div class="hero-in container">
      <button class="hero-eyebrow" type="button" data-open="cc">
        <Avatar size={22} />
        <span>{tr(lang, 'hero.eyebrow')}</span>
        <span class="live" aria-hidden="true"></span>
      </button>
      <h1 class="display hero-title">
        <span class="ln"><span class="grad-text">{tr(lang, 'hero.title1')}</span></span>
        <span class="ln"><span>{tr(lang, 'hero.title2')}</span></span>
        <span class="ln"><span class="dim">{tr(lang, 'hero.title3')}</span></span>
      </h1>
      <p class="lead hero-lead">{tr(lang, 'hero.lead')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary magnetic" href="#apps">
          {tr(lang, 'hero.cta')}
          <Icon name="arrow" />
        </a>
        <a class="btn magnetic" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener">
          <Icon name="telegram" />
          {tr(lang, 'hero.contact')}
        </a>
        <button class="kbd-hint" type="button" data-open="spotlight">
          <kbd>⌘</kbd><kbd>K</kbd>
          <span>{tr(lang, 'hero.spotlight')}</span>
        </button>
      </div>
    </div>
    <a class="scroll-cue" href="#apps" aria-label={tr(lang, 'hero.cta')}><span></span></a>
  </section>

  <section class="apps container" id="apps" aria-labelledby="apps-title">
    <header class="sec-head reveal">
      <p class="eyebrow">{apps.length} · macOS · Windows · Web</p>
      <h2 class="h2" id="apps-title">{tr(lang, 'apps.title')}</h2>
      <p class="lead">{tr(lang, 'apps.lead')}</p>
    </header>
    <div class="grid-12 apps-grid">
      <AppWindow app={featured} lang={lang} featured index={0} />
      {rest.map((a, i) => <AppWindow app={a} lang={lang} index={i + 1} />)}
    </div>
  </section>

  <section class="about container" id="about" aria-labelledby="about-title">
    <div class="about-card glass reveal">
      <div class="about-left">
        <Avatar size={88} />
        <div>
          <p class="eyebrow">{tr(lang, 'about.title')}</p>
          <h2 class="h3" id="about-title">Ehroz · designer &amp; developer</h2>
        </div>
      </div>
      <p class="about-text">{tr(lang, 'about.text')}</p>
      <dl class="stats">
        <div><dt>{apps.length}</dt><dd>{lang === 'ru' ? 'продуктов' : 'products'}</dd></div>
        <div><dt>{ready}</dt><dd>{lang === 'ru' ? 'уже доступны' : 'available now'}</dd></div>
        <div><dt>{platforms}</dt><dd>{lang === 'ru' ? 'платформы' : 'platforms'}</dd></div>
        <div><dt>RU · EN · KZ</dt><dd>{lang === 'ru' ? 'языки речи в BLA-БЛА и Sukhan' : 'speech languages in BLA-БЛА & Sukhan'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="contact container" id="contact" aria-labelledby="contact-title">
    <div class="contact-card reveal">
      <h2 class="h2" id="contact-title">{tr(lang, 'contact.title')}</h2>
      <p class="lead">{tr(lang, 'contact.lead')}</p>
      <div class="contact-cta">
        <a class="btn btn-primary magnetic" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />@{CONTACTS.telegram}</a>
        <a class="btn magnetic" href={CONTACTS.order} target="_blank" rel="noopener"><Icon name="briefcase" />{tr(lang, 'contact.order')}</a>
        <a class="btn magnetic" href={`mailto:${CONTACTS.email}`}><Icon name="mail" />Email</a>
      </div>
    </div>
  </section>

  <footer class="foot container">
    <span>© 2026 Ehroz · ehroz.pro</span>
    <span>{tr(lang, 'foot.made')}</span>
    <span class="foot-links">
      <a href={`https://github.com/${CONTACTS.github}`} target="_blank" rel="noopener">GitHub</a>
      <a href={`https://instagram.com/${CONTACTS.instagram}`} target="_blank" rel="noopener">Instagram</a>
      <a href={`https://www.behance.net/${CONTACTS.behance}`} target="_blank" rel="noopener">Behance</a>
    </span>
  </footer>
</Layout>

<script>
  // Параллакс плавающих иконок за курсором
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0, x = 0, y = 0;
    hero.addEventListener('pointermove', (e) => {
      x = e.clientX / innerWidth - 0.5;
      y = e.clientY / innerHeight - 0.5;
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          hero.style.setProperty('--mx', x.toFixed(3));
          hero.style.setProperty('--my', y.toFixed(3));
        });
    });
  }
</script>

<style>
  .hero {
    --mx: 0;
    --my: 0;
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--menubar) + 48px) 0 120px;
    overflow: clip;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    padding: 0 14px 0 6px;
    border: 0;
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: var(--glass-edge);
    color: var(--muted);
    font: inherit;
    font-size: 13.5px;
    font-weight: 560;
    cursor: pointer;
    animation: rise 0.9s var(--ease-out) both;
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    animation: ping 2.4s infinite;
  }
  @keyframes ping {
    70%, 100% { box-shadow: 0 0 0 8px transparent; }
  }
  .hero-title {
    margin-top: 26px;
    font-size: clamp(2.5rem, 1.1rem + 4.6vw, 5.6rem);
    display: grid;
    justify-items: center;
    text-wrap: balance;
  }
  .hero-title .ln:first-child {
    font-size: 1.75em;
    margin-bottom: 0.02em;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding: 0 0.04em 0.08em;
    margin-bottom: -0.08em;
  }
  .ln > span {
    display: inline-block;
    animation: mask-up 1.1s var(--ease-out) both;
  }
  .ln:nth-child(2) > span { animation-delay: 0.09s; }
  .ln:nth-child(3) > span { animation-delay: 0.18s; }
  .ln .dim { color: color-mix(in srgb, var(--text) 52%, transparent); }
  .ln:first-child .grad-text {
    background-size: 200% 100%;
    animation: mask-up 1.1s var(--ease-out) both, sheen 8s 1.2s ease-in-out infinite;
  }
  @keyframes mask-up {
    from { transform: translateY(105%) rotate(2deg); }
  }
  @keyframes sheen {
    50% { background-position: 100% 0; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
  }
  .hero-lead {
    max-width: 640px;
    margin-top: 26px;
    animation: rise 1s 0.35s var(--ease-out) both;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    animation: rise 1s 0.45s var(--ease-out) both;
  }
  .kbd-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 6px;
    border: 0;
    background: none;
    color: var(--faint);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .kbd-hint kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 6px;
    background: var(--chip);
    box-shadow: inset 0 -1px 0 var(--line-strong);
    font: inherit;
    font-size: 12px;
    color: var(--muted);
  }
  .kbd-hint span { margin-left: 4px; }
  @media (pointer: coarse) { .kbd-hint { display: none; } }

  .floaters {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fl {
    position: absolute;
    translate: calc(var(--mx) * var(--z) * -60px) calc(var(--my) * var(--z) * -40px);
    transition: translate 0.8s var(--ease-out);
    animation: pop 1s calc(0.35s + var(--i) * 0.07s) var(--spring) both;
  }
  .fl :global(img) {
    display: block;
    rotate: var(--r);
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
    animation: float 9s calc(var(--i) * -1.3s) ease-in-out infinite;
    opacity: 0.92;
  }
  @keyframes float {
    50% { transform: translateY(-14px) rotate(3deg); }
  }
  @keyframes pop {
    from { opacity: 0; scale: 0.6; }
  }
  @media (max-width: 900px) {
    .fl { scale: 0.7; }
    .fl:nth-child(n + 5) { display: none; }
    .fl:nth-child(1) { left: -2% !important; top: 12% !important; }
    .fl:nth-child(2) { left: 80% !important; top: 10% !important; }
    .fl:nth-child(3) { left: 82% !important; top: 80% !important; }
    .fl:nth-child(4) { left: 2% !important; top: 82% !important; }
  }
  @media (max-width: 640px) {
    .floaters { display: none; }
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 104px;
    translate: -50% 0;
    width: 26px;
    height: 40px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    animation: rise 1s 0.8s both;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--muted);
    animation: wheel 1.8s infinite;
  }
  @keyframes wheel {
    60% { transform: translateY(12px); opacity: 0; }
    61% { transform: none; opacity: 0; }
  }
  @media (max-height: 700px) { .scroll-cue { display: none; } }

  .sec-head {
    display: grid;
    gap: 12px;
    max-width: 720px;
    margin-bottom: 40px;
  }
  .apps { padding-top: 40px; }
  .apps-grid { align-items: stretch; }

  .about { margin-top: 140px; }
  .about-card {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 28px 20px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 28px;
  }
  .about-left {
    grid-column: span 12;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .about-left .eyebrow { margin-bottom: 6px; }
  .about-text {
    grid-column: span 12;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .stats {
    grid-column: span 12;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .stats div {
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--chip);
  }
  .stats dt {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .stats dd { color: var(--muted); font-size: 13.5px; }
  @media (min-width: 900px) {
    .about-left { grid-column: span 5; align-items: flex-start; flex-direction: column; }
    .about-text { grid-column: span 7; }
  }

  .contact { margin-top: 140px; }
  .contact-card {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: clamp(40px, 7vw, 90px) 20px;
    text-align: center;
    border-radius: 32px;
    background:
      radial-gradient(70% 90% at 20% 0%, color-mix(in srgb, var(--wall-a) 45%, transparent), transparent 70%),
      radial-gradient(70% 90% at 90% 100%, color-mix(in srgb, var(--wall-c) 40%, transparent), transparent 70%),
      var(--glass);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    box-shadow: var(--glass-edge), var(--shadow-2);
  }
  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: 80px;
    padding: 28px 0 130px;
    border-top: 0.5px solid var(--line);
    color: var(--faint);
    font-size: 13px;
  }
  .foot-links { display: flex; gap: 16px; }
  .foot a:hover { color: var(--text); }
</style>

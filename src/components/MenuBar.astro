---
import type { Lang } from '../content/apps';
import { tr, path, CONTACTS } from '../i18n';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Avatar from './Avatar.astro';

interface Props {
  lang: Lang;
  /** slug текущего приложения — чтобы переключатель языка вёл на ту же страницу. */
  slug?: string;
}
const { lang, slug = '' } = Astro.props;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const c = CONTACTS;
const links = [
  { id: 'telegram', label: 'Telegram', value: `@${c.telegram}`, href: `https://t.me/${c.telegram}` },
  { id: 'mail', label: 'Email', value: c.email, href: `mailto:${c.email}`, copy: c.email },
  { id: 'instagram', label: 'Instagram', value: `@${c.instagram}`, href: `https://instagram.com/${c.instagram}` },
  { id: 'github', label: 'GitHub', value: c.github, href: `https://github.com/${c.github}` },
  { id: 'behance', label: 'Behance', value: c.behance, href: `https://www.behance.net/${c.behance}` },
];
---

<header class="menubar" style="view-transition-name: menubar">
  <a class="mb-logo" href={path(lang)} aria-label="ehroz.pro" data-logo>
    <Mark size={16} />
    <span>ehroz.pro</span>
  </a>
  <nav class="mb-nav hide-sm" aria-label={tr(lang, 'menu.apps')}>
    <a class="mb-item" href={`${path(lang)}#apps`}>{tr(lang, 'menu.apps')}</a>
    <button class="mb-item" type="button" data-open="about">{tr(lang, 'menu.about')}</button>
  </nav>
  <span class="mb-sp"></span>
  <button class="mb-item" type="button" data-open="spotlight" aria-label={tr(lang, 'menu.search')} title={tr(lang, 'menu.search')}>
    <Icon name="search" size={14} />
    <span class="hide-sm">⌘K</span>
  </button>
  <a class="mb-item" href={path(other, slug)} hreflang={other} lang={other} aria-label={tr(lang, 'menu.lang')} title={tr(lang, 'menu.lang')} data-lang-switch>
    {other.toUpperCase()}
  </a>
  <button class="mb-item" type="button" data-theme-toggle aria-label={tr(lang, 'menu.theme')} title={tr(lang, 'menu.theme')}>
    <Icon name="auto" size={14} class="ti ti-auto" />
    <Icon name="moon" size={14} class="ti ti-dark" />
    <Icon name="sun" size={14} class="ti ti-light" />
  </button>
  <time class="mb-item mb-clock hide-xs" data-clock data-lang={lang} aria-label={lang === 'ru' ? 'Время в Астане' : 'Time in Astana'}>&nbsp;</time>
  <button class="mb-badge" type="button" data-open="cc" aria-haspopup="dialog" aria-expanded="false" aria-controls="cc">
    <Avatar size={20} />
    <span class="hide-sm">Ehroz · {c.role}</span>
  </button>
</header>

<!-- Панель контактов -->
<div class="cc" id="cc" role="dialog" aria-modal="false" aria-label={tr(lang, 'cc.title')} hidden>
  <div class="cc-head">
    <Avatar size={48} />
    <div>
      <div class="cc-name">{c.name[lang]}</div>
      <div class="cc-meta">{c.role}</div>
      <div class="cc-meta">{c.city[lang]} · <time data-clock data-lang={lang} data-short>&nbsp;</time></div>
    </div>
  </div>
  <ul class="cc-list">
    {
      links.map((l) => (
        <li class="cc-row">
          <a class="cc-link" href={l.href} target="_blank" rel="noopener me">
            <Icon name={l.id} size={16} />
            <span class="cc-label">{l.label}</span>
            <span class="cc-value">{l.value}</span>
          </a>
          {l.copy && (
            <button class="cc-copy" type="button" data-copy={l.copy} aria-label={`${tr(lang, 'cc.copy')}: ${l.copy}`} title={tr(lang, 'cc.copy')}>
              <Icon name="copy" size={14} />
            </button>
          )}
        </li>
      ))
    }
  </ul>
  <div class="cc-seg" role="group" aria-label={tr(lang, 'menu.theme')}>
    <button type="button" data-set-theme="auto">{tr(lang, 'theme.auto')}</button>
    <button type="button" data-set-theme="dark">{tr(lang, 'theme.dark')}</button>
    <button type="button" data-set-theme="light">{tr(lang, 'theme.light')}</button>
  </div>
  <a class="btn btn-primary cc-order" href={c.order} target="_blank" rel="noopener">
    <Icon name="briefcase" />
    {tr(lang, 'contact.order')}
  </a>
  <div class="cc-toast" role="status" aria-live="polite"></div>
</div>

<!-- «About this Mac» → «About Ehroz»: паспорт мастера -->
<dialog class="about" id="about" aria-label={tr(lang, 'about.mac.title')}>
  <div class="about-bar">
    <span>{tr(lang, 'about.mac.title')}</span>
    <form method="dialog"><button class="about-x" aria-label="Close">×</button></form>
  </div>
  <div class="about-body">
    <Avatar size={96} />
    <p class="about-name">Ehroz</p>
    <p class="about-sub">{c.role} · ehroz.pro</p>
    <dl class="about-spec">
      <div><dt>{tr(lang, 'about.mac.chip')}</dt><dd>{tr(lang, 'about.mac.chipv')}</dd></div>
      <div><dt>{tr(lang, 'about.mac.mem')}</dt><dd>{tr(lang, 'about.mac.memv')}</dd></div>
      <div><dt>{tr(lang, 'about.mac.disk')}</dt><dd>{tr(lang, 'about.mac.diskv')}</dd></div>
      <div><dt>{tr(lang, 'about.mac.os')}</dt><dd>{tr(lang, 'about.mac.osv')}</dd></div>
    </dl>
    <a class="btn btn-sm" href={`${path(lang)}#about`} data-close-about>{tr(lang, 'about.mac.more')}</a>
    <p class="about-egg">{tr(lang, 'about.mac.egg')}</p>
  </div>
</dialog>

<style>
  .menubar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--menubar);
    display: flex;
    align-items: stretch;
    padding-left: max(0px, env(safe-area-inset-left, 0px));
    padding-right: max(0px, env(safe-area-inset-right, 0px));
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mb-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border-right: 1px solid var(--line);
    font: 700 14px/1 var(--font-sans);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .mb-logo :global(.mark) {
    transition: transform var(--mid) var(--ease);
  }
  .mb-logo:hover :global(.mark) {
    transform: rotate(60deg);
  }
  .mb-nav {
    display: flex;
  }
  .mb-sp {
    flex: 1;
  }
  .mb-item,
  .mb-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--text-2);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .mb-sp + .mb-item {
    border-left: 1px solid var(--line);
  }
  .mb-item:hover,
  .mb-badge:hover,
  .mb-badge[aria-expanded='true'] {
    background: var(--hover);
    color: var(--text);
  }
  .mb-clock {
    cursor: default;
    font-variant-numeric: tabular-nums;
  }
  .mb-clock:hover {
    background: transparent;
  }
  .mb-badge {
    border-right: 0;
    background: var(--btn);
    color: var(--on-btn);
    padding: 0 14px 0 10px;
  }
  .mb-badge:hover,
  .mb-badge[aria-expanded='true'] {
    background: var(--hover);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  :global(.ti) {
    display: none;
  }
  :global(html[data-theme-pref='auto'] .ti-auto),
  :global(html:not([data-theme-pref]) .ti-auto),
  :global(html[data-theme-pref='dark'] .ti-dark),
  :global(html[data-theme-pref='light'] .ti-light) {
    display: block;
  }
  @media (max-width: 760px) {
    .hide-sm {
      display: none !important;
    }
    .mb-item,
    .mb-badge {
      padding: 0 11px;
    }
    .mb-logo {
      padding: 0 12px;
    }
  }
  @media (max-width: 400px) {
    .hide-xs {
      display: none !important;
    }
  }

  /* Панель контактов */
  .cc {
    position: fixed;
    z-index: 55;
    top: calc(var(--menubar) - 1px);
    right: max(0px, env(safe-area-inset-right, 0px));
    width: min(380px, 100vw);
    display: grid;
    background: var(--cell);
    border: 1px solid var(--line-strong);
    animation: cc-in var(--mid) var(--ease);
  }
  .cc[hidden] {
    display: none;
  }
  @keyframes cc-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .cc-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .cc-name {
    font: 700 20px/1.1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .cc-meta {
    color: var(--muted);
    font: 400 12px/1.5 var(--font-mono);
  }
  .cc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cc-row {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .cc-link {
    display: grid;
    grid-template-columns: 16px 90px 1fr;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    min-width: 0;
    transition: background var(--fast) var(--ease);
  }
  .cc-link:hover {
    background: var(--hover);
  }
  .cc-label {
    font: 500 11px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .cc-value {
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cc-row:has(.cc-copy) .cc-link {
    padding-right: 48px;
  }
  .cc-copy {
    position: absolute;
    right: 8px;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    background: var(--cell);
    color: var(--muted);
    cursor: pointer;
  }
  .cc-copy:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .cc-seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .cc-seg button {
    height: 38px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 500 10.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  .cc-seg button:last-child {
    border-right: 0;
  }
  .cc-seg button[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }
  .cc-order {
    margin: 12px 16px 16px;
  }
  .cc-toast {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: -40px;
    padding: 9px 12px;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 11px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0;
    transition: opacity var(--fast) var(--ease);
    pointer-events: none;
  }
  .cc-toast:global(.on) {
    opacity: 1;
  }

  /* Об Ehroz */
  .about {
    width: min(360px, calc(100vw - 32px));
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--cell);
    color: var(--text);
  }
  .about[open] {
    animation: cc-in var(--mid) var(--ease);
  }
  .about::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }
  .about-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding-left: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font: 500 11px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .about-x {
    width: 36px;
    height: 35px;
    border: 0;
    border-left: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-size: 18px;
    cursor: pointer;
  }
  .about-x:hover {
    background: var(--hover);
  }
  .about-body {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 24px;
    text-align: center;
  }
  .about-name {
    margin-top: 10px;
    font: 750 30px/1 var(--font-sans);
    letter-spacing: -0.035em;
  }
  .about-sub {
    color: var(--muted);
    font: 400 12px/1.5 var(--font-mono);
    margin-bottom: 12px;
  }
  .about-spec {
    width: 100%;
    margin: 0 0 16px;
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .about-spec div {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .about-spec dt {
    color: var(--faint);
    font: 500 10.5px/1.5 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .about-spec dd {
    margin: 0;
    font: 400 12.5px/1.5 var(--font-mono);
  }
  .about-egg {
    margin-top: 12px;
    color: var(--faint);
    font: 400 11px/1.5 var(--font-mono);
  }
</style>

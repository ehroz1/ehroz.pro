---
// Вариант D «Паспорт изделия»: слева тихий заголовок, справа одно изделие крупно на подложке
// с выносными линиями, как на техническом листе. Изделия листаются сами или по полоске внизу.
import type { Lang } from '../../content/apps';
import { apps } from '../../content/apps';
import { tr, path, pick, PLATFORM, STATUS, CONTACTS } from '../../i18n';
import AppIcon from '../AppIcon.astro';
import Icon from '../Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="hero container" aria-labelledby="hero-title" data-sheet>
  <div class="sec-bar">
    <span>01 / {ru ? 'Мастерская Ehroz' : 'Ehroz workshop'}</span>
    <span>{tr(lang, 'hero.eyebrow')}</span>
  </div>
  <div class="grid">
    <div class="intro">
      <p class="who">Ehroz<span>·</span>{ru ? 'изделия для Mac, Windows и браузера' : 'tools for Mac, Windows and the browser'}</p>
      <h1 class="title" id="hero-title">
        {tr(lang, 'hero.title2')}<br /><span class="hl">{tr(lang, 'hero.title3')}</span>
      </h1>
      <p class="lead">{tr(lang, 'hero.lead')}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#apps">{tr(lang, 'hero.cta')} <Icon name="arrow" /></a>
        <a class="btn" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{tr(lang, 'hero.contact')}</a>
      </div>
      <div class="count" aria-hidden="true">
        <span class="pix" data-cur>01</span><span class="of">/ {n(apps.length - 1)}</span>
      </div>
    </div>

    <div class="sheet">
      <div class="plate">
        <svg class="leads" viewBox="0 0 1000 620" aria-hidden="true">
          <path d="M150 128 H330 L392 196" />
          <path d="M850 128 H670 L608 196" />
          <path d="M150 492 H330 L392 424" />
          <path d="M850 492 H670 L608 424" />
          <rect x="388" y="192" width="8" height="8" /><rect x="604" y="192" width="8" height="8" />
          <rect x="388" y="420" width="8" height="8" /><rect x="604" y="420" width="8" height="8" />
          <path class="axis" d="M500 60 V560 M60 310 H940" />
        </svg>
        <span class="crop tl" /><span class="crop tr" /><span class="crop bl" /><span class="crop br" />
        {
          apps.map((a, i) => (
            <a class:list={['item', { on: i === 0 }]} data-item={i} href={path(lang, a.slug)} data-app-link={a.slug} data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`} tabindex={i === 0 ? 0 : -1} aria-hidden={i === 0 ? undefined : 'true'}>
              <span class="obj">
                <AppIcon slug={a.slug} name={a.name} size={240} decorative eager={i < 2} />
                <i class="floor" />
              </span>
              <span class="c c1">
                <span class="tag-no">{n(i)}</span>
                <b>{a.name}</b>
              </span>
              <span class="c c2"><small>{ru ? 'Категория' : 'Category'}</small>{pick(lang, a.kind)}</span>
              <span class="c c3"><small>{ru ? 'Платформа' : 'Platform'}</small>{a.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · ')}</span>
              <span class="c c4"><small>{ru ? 'Статус' : 'Status'}</small>{pick(lang, STATUS[a.status])}{a.version && ` · v${a.version}`}</span>
            </a>
          ))
        }
      </div>
      <div class="foot">
        {apps.map((a, i) => (
          <p class:list={['short', { on: i === 0 }]} data-short={i}>{pick(lang, a.short)} <a href={path(lang, a.slug)} tabindex="-1">{tr(lang, 'apps.open')} ↗</a></p>
        ))}
      </div>
      <div class="strip" role="tablist" aria-label={ru ? 'Изделия' : 'Products'}>
        {apps.map((a, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pick={i} data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`} title={a.name}>
            <AppIcon slug={a.slug} name={a.name} size={32} decorative />
            <span class="sr-only">{a.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-sheet]');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-item]'));
    const shorts = Array.from(root.querySelectorAll<HTMLElement>('[data-short]'));
    const picks = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pick]'));
    const cur = root.querySelector<HTMLElement>('[data-cur]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;
    const show = (k: number) => {
      i = (k + items.length) % items.length;
      items.forEach((el, j) => {
        el.classList.toggle('on', j === i);
        el.tabIndex = j === i ? 0 : -1;
        j === i ? el.removeAttribute('aria-hidden') : el.setAttribute('aria-hidden', 'true');
      });
      shorts.forEach((el, j) => el.classList.toggle('on', j === i));
      picks.forEach((el, j) => el.setAttribute('aria-selected', String(j === i)));
      cur.textContent = String(i + 1).padStart(2, '0');
    };
    const loop = () => {
      clearInterval(timer);
      if (!reduced) timer = window.setInterval(() => show(i + 1), 5000);
    };
    picks.forEach((b, k) => b.addEventListener('click', () => { show(k); loop(); }));
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', loop);
    loop();
  }
</script>

<style>
  .hero { padding-top: calc(var(--menubar) + 24px); }
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    border-bottom: 1px solid var(--line);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 56px 48px 40px 0;
    border-right: 1px solid var(--line);
  }
  .who {
    margin: 0;
    color: var(--muted);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .who span { margin: 0 8px; color: var(--faint); }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1rem + 2.4vw, 3.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lead { max-width: 34ch; margin: 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; }
  .count { margin-top: auto; display: flex; align-items: baseline; gap: 10px; color: var(--faint); }
  .pix { font: 400 64px/0.9 var(--font-pixel); color: var(--text); }
  .of { font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; }

  .sheet { display: grid; gap: 0; padding: 32px 0 0 32px; }
  .plate {
    position: relative;
    aspect-ratio: 1000 / 620;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1.2px) 0 0 / 20px 20px,
      var(--plate);
    overflow: hidden;
  }
  .leads { position: absolute; inset: 0; width: 100%; height: 100%; }
  .leads path { fill: none; stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .leads .axis { stroke: var(--line); stroke-dasharray: 2 6; }
  .leads rect { fill: var(--plate); stroke: var(--faint); vector-effect: non-scaling-stroke; }
  .item { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity var(--mid) var(--ease), visibility 0s var(--mid); }
  .item.on { opacity: 1; visibility: visible; transition: opacity var(--mid) var(--ease); }
  .obj {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 36%;
    aspect-ratio: 1;
    translate: -50% -50%;
    display: grid;
    place-items: center;
  }
  .obj :global(img) { position: relative; z-index: 1; width: 100%; height: auto; transition: translate var(--mid) var(--ease); }
  .item:hover .obj :global(img) { translate: 0 -6px; }
  .floor {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.55), transparent);
  }
  .c {
    position: absolute;
    display: grid;
    gap: 6px;
    font: 500 11.5px/1.35 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-2, var(--text));
  }
  .c small { color: var(--faint); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; }
  .c1 { left: 6%; bottom: calc(100% - 128 / 620 * 100% + 10px); justify-items: start; }
  .c1 b { font: 600 26px/1 var(--font-sans); letter-spacing: -0.02em; color: var(--text); }
  .c2 { right: 6%; bottom: calc(100% - 128 / 620 * 100% + 10px); justify-items: end; text-align: right; }
  .c3 { left: 6%; top: calc(492 / 620 * 100% + 10px); }
  .c4 { right: 6%; top: calc(492 / 620 * 100% + 10px); justify-items: end; text-align: right; color: var(--tint); }

  .foot { position: relative; min-height: 64px; border-bottom: 1px solid var(--line); }
  .short {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font-size: 15px;
    opacity: 0;
    transition: opacity var(--mid) var(--ease);
  }
  .short.on { opacity: 1; }
  .short a { color: var(--text); font: 500 11px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .strip { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); }
  .strip button {
    display: grid;
    place-items: center;
    height: 56px;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--line);
    background: none;
    cursor: pointer;
    box-shadow: inset 0 0 0 0 var(--tint);
    transition: background var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
  }
  .strip button:last-child { border-right: 0; }
  .strip button:hover { background: var(--hover); }
  .strip button[aria-selected='true'] { box-shadow: inset 0 2px 0 0 var(--tint); background: var(--hover); }
  .strip :global(img) { width: 32px; height: 32px; opacity: 0.7; transition: opacity var(--fast) var(--ease); }
  .strip button:hover :global(img), .strip button[aria-selected='true'] :global(img) { opacity: 1; }
</style>

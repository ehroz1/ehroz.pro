---
// Вариант G — по референсу (рамка-чертёж): рельсы по краям контента с крестиками на стыках,
// линейка и указатель раздела в правом поле, крупная подпись справа сверху,
// слева заголовок «Одиннадцать изделий. Одна мастерская.», справа сетка иконок с подписями.
import type { Lang } from '../../content/apps';
import { apps } from '../../content/apps';
import { tr, path, pick, PLATFORM, CONTACTS } from '../../i18n';
import AppIcon from '../AppIcon.astro';
import Icon from '../Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const sections = ru
  ? [['apps', 'Изделия'], ['about', 'Об Ehroz'], ['contact', 'Контакты']]
  : [['apps', 'Products'], ['about', 'About'], ['contact', 'Contact']];
---

<!-- Рамка страницы: рельсы, линейка, указатель раздела (только на широких экранах) -->
<div class="frame" aria-hidden="true">
  <div class="container"><div class="rails" /></div>
  <div class="gutter">
    <div class="ruler" data-ruler>
      {[...Array(80)].map((_, i) => <span style={`top:${i * 300}px`}>{i * 5}</span>)}
    </div>
    <div class="spy">
      <span class="spy-cur" data-spy-cur>{ru ? 'Начало' : 'Start'}</span>
      <ul data-spy-list>
        {sections.map(([id, t]) => <li data-spy={id}>{t}</li>)}
      </ul>
    </div>
  </div>
</div>

<section class="hero container" aria-labelledby="hero-title" data-spy-sec={ru ? 'Начало' : 'Start'}>
  <div class="sec-bar">
    <span>01 / <b>{ru ? 'Мастерская Ehroz' : 'Ehroz workshop'}</b></span>
    <span>{apps.length} {ru ? 'изделий' : 'products'} · macOS · Windows · {ru ? 'веб' : 'web'} · <em>{ru ? 'Астана' : 'Astana'}</em></span>
  </div>
  <div class="grid">
    <div class="main">
      <h1 class="title" id="hero-title">
        {ru ? 'Небольшие инструменты.' : 'Small tools.'}<br />
        {ru ? 'Одна ' : 'One '}<span class="hl">{ru ? 'мастерская' : 'workshop'}</span>.
      </h1>
      <p class="lead">
        {ru
          ? 'Конвертеры, работа с картинками, видео и речью, утилиты для Mac и расширения для браузера. Делаю их сам, пользуюсь каждый день — и каталог постоянно пополняется.'
          : 'Converters, tools for images, video and speech, Mac utilities and browser extensions. I make them myself, use them every day — and the catalogue keeps growing.'}
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#apps"><Icon name="arrow" />{tr(lang, 'hero.cta')}</a>
        <a class="btn" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{ru ? 'Написать в Telegram' : 'Message on Telegram'}</a>
        <a class="btn" href={`https://github.com/${CONTACTS.github}`} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
      </div>
      <p class="note">macOS · Windows · {ru ? 'веб · расширения браузера' : 'web · browser extensions'}</p>
    </div>
    <nav class="hero-index" aria-label={tr(lang, 'apps.title')}>
      <ol>
        {
          apps.map((a, i) => (
            <li data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
              <a href={path(lang, a.slug)} data-app-link={a.slug}>
                <AppIcon slug={a.slug} name={a.name} size={64} decorative eager vt />
                <span class="hi-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="hi-name">{a.name}</span>
                <span class="hi-plat">{a.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · ')}</span>
              </a>
            </li>
          ))
        }
        <li class="hi-more">
          <a href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener">
            <span class="hi-no">{String(apps.length + 1).padStart(2, '0')}</span>
            <span class="hi-plus" aria-hidden="true">+</span>
            <span class="hi-name">{ru ? 'Новые изделия' : 'More on the way'}</span>
            <span class="hi-plat">{ru ? 'Следите в Telegram' : 'Follow on Telegram'}</span>
          </a>
        </li>
      </ol>
    </nav>
  </div>
</section>

<script>
  // Линейка едет вместе со страницей, указатель показывает текущий раздел
  const ruler = document.querySelector<HTMLElement>('[data-ruler]');
  const cur = document.querySelector<HTMLElement>('[data-spy-cur]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-spy]'));
  const start = document.querySelector<HTMLElement>('[data-spy-sec]')?.dataset.spySec ?? '';
  const secs = items.map((li) => document.querySelector<HTMLElement>(`section#${li.dataset.spy}`)).filter(Boolean) as HTMLElement[];
  let raf = 0;
  const tick = () => {
    raf = 0;
    if (ruler) ruler.style.transform = `translateY(${-scrollY}px)`;
    let idx = -1;
    secs.forEach((s, i) => { if (s.getBoundingClientRect().top < innerHeight * 0.45) idx = i; });
    if (cur) cur.textContent = idx < 0 ? start : items[idx].textContent;
    items.forEach((li, i) => (li.hidden = i <= idx));
  };
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
  tick();
</script>

<style>
  /* цвета референса — только для тёмной темы */
  :global(html:not([data-theme='light'])) {
    --bg: #111315;
    --cell: #16181b;
    --plate: #1f2228;
    --plate-2: #272a30;
    --line: #2e3032;
    --line-strong: #44474b;
    --hover: #1a1d21;
  }
  /* ── рамка ── */
  .frame { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  .frame > .container { height: 100%; }
  .rails { height: 100%; border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
  .gutter {
    position: absolute;
    top: var(--menubar);
    bottom: var(--dock-h);
    right: 0;
    width: calc((100vw - min(100vw, 1440px)) / 2 + var(--gutter));
    overflow: hidden;
  }
  @media (max-width: 1499px) { .gutter { display: none; } }
  .ruler {
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 24000px;
    background: repeating-linear-gradient(180deg, var(--line-strong) 0 1px, transparent 1px 60px) right / 12px 100% no-repeat;
  }
  .ruler span {
    position: absolute;
    right: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    translate: 0 -50%;
    color: var(--faint);
    font: 500 9.5px/1 var(--font-mono);
  }
  .ruler span::after { content: ''; width: 24px; height: 1px; background: var(--faint); }
  .spy {
    position: absolute;
    right: 56px;
    bottom: 32px;
    display: grid;
    justify-items: end;
    gap: 18px;
  }
  .spy-cur {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--muted);
    font: 700 22px/1 var(--font-sans);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .spy ul { margin: 0; padding: 0; list-style: none; text-align: right; }
  .spy li { color: var(--faint); font: 700 15px/1.15 var(--font-sans); text-transform: uppercase; letter-spacing: 0.02em; }
  .spy li[hidden] { display: none; }
  .hero { position: relative; }
  /* внутри рельс — поля, как у референса */
  :global(main .sec-bar),
  :global(main .sec-head.sec-head) { padding-inline: 24px; }

  /* ── первый экран ── */
  .hero { padding-top: calc(var(--menubar) + 24px); }
  .hero .sec-bar b { color: var(--text-2, var(--text)); font-weight: 500; }
  .hero .sec-bar em { font-style: normal; color: var(--faint); opacity: 0.6; }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    padding: 0 0 0 24px !important;
    border-bottom: 1px solid var(--line);
  }
  /* крестики на стыке рельс и нижней линии */
  .grid::before,
  .grid::after {
    content: '+';
    position: absolute;
    bottom: -9px;
    color: var(--faint);
    font: 300 18px/1 var(--font-mono);
  }
  .grid::before { left: 0; translate: -50% 0; }
  .grid::after { right: 0; translate: 50% 0; }
  .main { display: grid; gap: 0; max-width: 780px; padding: 96px 48px 80px 0; }
  .title {
    margin: 0 0 32px;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 0.6rem + 2.7vw, 3.9rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .lead { margin: 0 0 40px; font-size: clamp(17px, 0.6vw + 12px, 20px); line-height: 1.6; color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .cta .btn { height: 52px; padding: 0 26px; }
  .note {
    margin: 14px 0 0;
    color: var(--faint);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-index { align-self: stretch; border-left: 1px solid var(--line); }
  .hero-index ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; height: 100%; margin: 0; padding: 0; list-style: none; }
  .hero-index li:nth-last-child(-n + 3) { border-bottom: 0; }
  .hero-index li { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  .hero-index li:nth-child(3n) { border-right: 0; }
  .hero-index a {
    position: relative;
    height: 100%;
    align-content: center;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 22px 8px 18px;
    text-align: center;
    transition: background var(--fast) var(--ease);
  }
  .hero-index a:hover { background: var(--hover); }
  .hero-index :global(img) { width: 64px; height: 64px; margin: -6px 0 2px; transition: transform var(--mid) var(--ease); }
  .hero-index a:hover :global(img) { transform: translateY(-4px); }
  .hi-no { position: absolute; top: 8px; left: 10px; color: var(--tint); font: 500 10px/1 var(--font-mono); }
  .hi-plus {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 0 8px;
    border: 1px dashed var(--line-strong);
    color: var(--faint);
    font: 300 28px/1 var(--font-mono);
  }
  .hi-more .hi-no { color: var(--faint); }
  .hi-name { font-weight: 650; font-size: 14.5px; }
  .hi-plat { color: var(--faint); font: 500 9.5px/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }

</style>

---
// Вариант E «Разворот каталога»: левая полоса — заголовок и оглавление с отточиями,
// правая — журнальная раскладка из трёх живых демо с подписями «Рис. 1–3».
import type { Lang } from '../../content/apps';
import { apps } from '../../content/apps';
import { tr, path, pick, CONTACTS } from '../../i18n';
import Icon from '../Icon.astro';
import SceneSwitch from '../scenes/SceneSwitch.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const n = (i: number) => String(i + 1).padStart(2, '0');
const figs = ['morfus', 'sukhan', 'padbridge'].map((s) => {
  const i = apps.findIndex((a) => a.slug === s);
  return { a: apps[i], i };
});
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="sec-bar">
    <span>01 / {ru ? 'Мастерская Ehroz' : 'Ehroz workshop'}</span>
    <span>{tr(lang, 'hero.eyebrow')}</span>
  </div>
  <div class="spread">
    <div class="page left">
      <p class="issue"><span>{ru ? 'Каталог изделий' : 'Product catalogue'}</span><span>2026</span></p>
      <h1 class="title" id="hero-title">
        <span class="name">Ehroz.</span>
        {tr(lang, 'hero.title2')} <span class="hl">{tr(lang, 'hero.title3')}</span>
      </h1>
      <p class="lead">{tr(lang, 'hero.lead')}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#apps">{tr(lang, 'hero.cta')} <Icon name="arrow" /></a>
        <a class="btn" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{tr(lang, 'hero.contact')}</a>
      </div>
      <nav class="toc" aria-label={ru ? 'Содержание' : 'Contents'}>
        <p class="toc-h">{ru ? 'Содержание' : 'Contents'}</p>
        <ol>
          {
            apps.map((a, i) => (
              <li data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
                <a href={path(lang, a.slug)} data-app-link={a.slug}>
                  <span class="t-name">{a.name}</span>
                  <span class="t-kind">{pick(lang, a.kind)}</span>
                  <span class="t-dots" aria-hidden="true" />
                  <span class="t-no">{n(i)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
    <div class="page right">
      {
        figs.map(({ a, i }, k) => (
          <figure class:list={['fig', `f${k}`]} data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
            <a class="plate" href={path(lang, a.slug)} tabindex="-1" aria-hidden="true">
              <span class="crop tl" /><span class="crop tr" /><span class="crop bl" /><span class="crop br" />
              <SceneSwitch fit id={a.features[0].scene} lang={lang} label={`${a.name}: ${pick(lang, a.features[0].title)}`} />
            </a>
            <figcaption>
              <span class="fig-no">{ru ? 'Рис.' : 'Fig.'} {k + 1}</span>
              <span><b>{a.name}</b> — {pick(lang, a.features[0].title).replace(/^./, (c) => c.toLowerCase())}</span>
              <span class="tag-no">{n(i)}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--menubar) + 24px); }
  .spread {
    display: grid;
    grid-template-columns: 5fr 7fr;
    border-bottom: 1px solid var(--line);
  }
  .page { min-width: 0; }
  .left {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: 40px 48px 40px 0;
    border-right: 1px solid var(--line);
  }
  .issue {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 1rem + 2vw, 3.1rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }
  .name { display: block; margin-bottom: 0.12em; font-size: 1.9em; font-weight: 700; letter-spacing: -0.055em; line-height: 0.9; }
  .lead { margin: 0; max-width: 40ch; font-size: 16px; }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; }
  .toc { margin-top: 8px; }
  .toc-h {
    margin: 0 0 6px;
    color: var(--faint);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .toc ol { margin: 0; padding: 0; list-style: none; columns: 2; column-gap: 28px; }
  .toc li { break-inside: avoid; }
  .toc a {
    display: grid;
    grid-template-columns: auto minmax(12px, 1fr) auto;
    align-items: baseline;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .t-name { font-weight: 600; font-size: 14px; }
  .t-kind { display: none; }
  .t-dots { border-bottom: 1px dotted var(--line-strong); transform: translateY(-3px); }
  .t-no { color: var(--tint); font: 500 11px/1 var(--font-mono); }
  .toc a:hover .t-name { color: var(--tint); }

  .right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 28px 24px;
    padding: 40px 0 40px 32px;
    align-content: start;
  }
  .fig { margin: 0; display: grid; gap: 10px; min-width: 0; }
  .f0 { grid-column: 1 / -1; }
  .plate {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--plate);
    overflow: hidden;
  }
  .f0 .plate { aspect-ratio: 16 / 7.4; }
  .plate :global(.scene-host[data-fit]) { inset: 22px; }
  .f0 .plate :global(.scene-host[data-fit]) { inset: 28px; }
  figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    color: var(--muted);
    font-size: 13.5px;
  }
  figcaption b { color: var(--text); font-weight: 600; }
  .fig-no { color: var(--faint); font: 500 10.5px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
</style>

---
// Вариант F «Линейка мастерской»: спокойный заголовок, под ним все изделия стоят в ряд
// на полке-линейке с делениями и номерами. При наведении изделие приподнимается, над ним — подпись.
import type { Lang } from '../../content/apps';
import { apps } from '../../content/apps';
import { tr, path, pick, CONTACTS } from '../../i18n';
import AppIcon from '../AppIcon.astro';
import Icon from '../Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="sec-bar">
    <span>01 / {ru ? 'Мастерская Ehroz' : 'Ehroz workshop'}</span>
    <span>{tr(lang, 'hero.eyebrow')}</span>
  </div>
  <div class="top">
    <h1 class="title" id="hero-title">
      <span class="name">Ehroz</span> — {tr(lang, 'hero.title2').replace(/^./, (c) => c.toLowerCase())}
      <span class="hl">{tr(lang, 'hero.title3')}</span>
    </h1>
    <p class="lead">{tr(lang, 'hero.lead')}</p>
  </div>

  <ol class="shelf" style={`--n:${apps.length}`}>
    {
      apps.map((a, i) => (
        <li data-tint style={`--tint-d:${a.tint.dark};--tint-l:${a.tint.light}`}>
          <a href={path(lang, a.slug)} data-app-link={a.slug}>
            <span class="label" aria-hidden="true">{pick(lang, a.kind)}</span>
            <span class="obj">
              <AppIcon slug={a.slug} name={a.name} size={96} decorative eager vt />
              <i class="floor" />
            </span>
            <span class="tick" aria-hidden="true" />
            <span class="no">{n(i)}</span>
            <span class="nm">{a.name}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <div class="ruler" aria-hidden="true" />

  <div class="bottom">
    <div class="cta">
      <a class="btn btn-primary" href="#apps">{tr(lang, 'hero.cta')} <Icon name="arrow" /></a>
      <a class="btn" href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener"><Icon name="telegram" />{tr(lang, 'hero.contact')}</a>
    </div>
    <p class="note">
      {String(apps.length).padStart(2, '0')} {ru ? 'изделий на полке' : 'products on the shelf'} · {ru ? 'новые — в' : 'new ones on'}
      <a href={`https://t.me/${CONTACTS.telegram}`} target="_blank" rel="noopener">Telegram ↗</a>
    </p>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--menubar) + 24px); }
  .top {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 80px;
    align-items: end;
    padding: 64px 0 24px;
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.3rem, 1rem + 2.8vw, 4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .name { font-weight: 700; }
  .lead { margin: 0; font-size: 16.5px; }

  .shelf {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    padding: 70px 0 0;
    list-style: none;
    border-bottom: 1px solid var(--text);
  }
  .shelf a { position: relative; display: grid; justify-items: center; }
  .label {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    translate: -50% 4px;
    width: max-content;
    max-width: 160px;
    padding: 5px 8px;
    background: var(--tint);
    color: var(--bg);
    font: 600 10px/1.25 var(--font-mono);
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--fast) var(--ease), translate var(--fast) var(--ease);
  }
  .obj { position: relative; display: grid; justify-items: center; padding-bottom: 4px; }
  .obj :global(img) {
    position: relative;
    z-index: 1;
    width: clamp(64px, 6.2vw, 104px);
    height: auto;
    transition: translate var(--mid) var(--ease);
  }
  .floor {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 0;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.7), transparent);
    transition: transform var(--mid) var(--ease), opacity var(--mid) var(--ease);
  }
  :global(:root[data-theme='light']) .floor { background: radial-gradient(closest-side, rgba(0, 0, 0, 0.25), transparent); }
  .shelf a:hover .label,
  .shelf a:focus-visible .label { opacity: 1; translate: -50% 0; }
  .shelf a:hover .obj :global(img),
  .shelf a:focus-visible .obj :global(img) { translate: 0 -10px; }
  .shelf a:hover .floor { transform: scale(0.8); opacity: 0.6; }
  .tick { position: absolute; bottom: -15px; width: 1px; height: 14px; background: var(--text); }
  .no {
    position: absolute;
    top: calc(100% + 22px);
    color: var(--tint);
    font: 500 11px/1 var(--font-mono);
  }
  .nm {
    position: absolute;
    top: calc(100% + 40px);
    width: max-content;
    font-weight: 600;
    font-size: 13.5px;
    color: var(--muted);
    transition: color var(--fast) var(--ease);
  }
  .shelf a:hover .nm { color: var(--text); }
  .ruler {
    height: 9px;
    background:
      repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 12px);
    mask: linear-gradient(#000, #000);
  }
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 78px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; }
  .note {
    margin: 0;
    color: var(--faint);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .note a { color: var(--text); }
</style>

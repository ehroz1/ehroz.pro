---
// Сцены Morfu: строка меню с «m», панель очереди, островок у чёлки, векторизация.
// Подписи и примеры чисел — из README Morfu; размеры файлов — примеры для демонстрации.
import Scene from './Scene.astro';
import Cursor from './Cursor.astro';

interface Props {
  id: string;
  lang: 'ru' | 'en';
  label: string;
}
const { id, lang, label } = Astro.props;
const ru = lang === 'ru';
const mb = (s: string) => (ru ? s : s.replace(',', '.').replace('МБ', 'MB').replace('ГБ', 'GB'));
const clock = ru ? 'Вт 21:45' : 'Tue 9:45 PM';

// «Растровый» логотип для сцены векторизации: клетки 24×24 по форме листа.
const N = 24;
const cells: string[] = [];
for (let y = 0; y < N; y++)
  for (let x = 0; x < N; x++) {
    const u = (x + 0.5) / N - 0.5,
      v = (y + 0.5) / N - 0.5;
    const leaf = Math.abs(u) < 0.36 * Math.cos(v * 2.6) && Math.abs(v) < 0.42 && !(Math.abs(u) < 0.03 && v > -0.3);
    const ring = Math.abs(Math.hypot(u, v) - 0.47) < 0.03;
    if (leaf || ring) cells.push(`<rect x="${x}" y="${y}" width="1.04" height="1.04"/>`);
  }
---

{
  (id === 'morfu-menubar' || id === 'morfu-savings') && (
    <Scene id={id} label={label}>
      <div class="mbar">
        <span class="apple"></span>
        <b>Finder</b>
        <span class="sp" />
        <span class="m-icon" data-el="micon">m</span>
        <span class="mbi">
          <svg width="16" height="12" viewBox="0 0 16 12"><path d="M8 11.2 1 4.6a10 10 0 0 1 14 0Z" fill="currentColor" opacity=".9" /></svg>
        </span>
        <span class="mbi batt"><i /></span>
        <span class="mbi">{clock}</span>
      </div>
      <div class="panel" data-el="panel">
        <div class="p-head">
          <b>Morfu</b>
          <span class="p-fmt">{id === 'morfu-savings' ? (ru ? 'Сжать' : 'Compress') : 'MP4'} ▾</span>
        </div>
        <div class="p-rows" data-el="rows">
          {id === 'morfu-menubar' ? (
            <div class="p-row" data-el="row">
              <span class="p-thumb vid" />
              <span class="p-txt">
                <b>{ru ? 'Отпуск.mov' : 'Trip.mov'}</b>
                <small data-el="rowsub">MOV → MP4 · H.264</small>
                <span class="p-prog">
                  <i data-el="prog" />
                </span>
              </span>
              <span class="p-pct" data-el="pct" />
            </div>
          ) : (
            [
              ['vid', ru ? 'Отпуск.mp4' : 'Trip.mp4', '12,4 МБ → 3,1 МБ', '−75%'],
              ['photo', 'IMG_2231.webp', '4,8 МБ → 0,9 МБ', '−81%'],
              ['pdf', ru ? 'Договор.pdf' : 'Contract.pdf', '9,6 МБ → 2,2 МБ', '−77%'],
              ['photo', ru ? 'Скриншот.png' : 'Screenshot.png', '2,1 МБ → 0,6 МБ', '−71%'],
            ].map(([k, n, s, p], i) => (
              <div class="p-row done" style={`--i:${i}`} data-done-row>
                <span class={`p-thumb ${k}`} />
                <span class="p-txt">
                  <b>{n}</b>
                  <small>{mb(s)}</small>
                </span>
                <span class="p-save">{p}</span>
              </div>
            ))
          )}
        </div>
        {id === 'morfu-savings' && (
          <div class="p-stats">
            <div>
              <small>{ru ? 'За месяц' : 'This month'}</small>
              <b data-count="2.4" data-unit={ru ? 'ГБ' : 'GB'}>0</b>
            </div>
            <div>
              <small>{ru ? 'За всё время' : 'All time'}</small>
              <b data-count="18.7" data-unit={ru ? 'ГБ' : 'GB'}>0</b>
            </div>
          </div>
        )}
      </div>
      {id === 'morfu-menubar' && (
        <>
          <div class="dfile" data-el="file" style="left:110px;top:360px">
            <span class="p-thumb vid big" />
            <span class="fname">{ru ? 'Отпуск.mov' : 'Trip.mov'}</span>
          </div>
          <div class="dfile out" data-el="out" style="left:150px;top:180px">
            <span class="p-thumb vid big" />
            <span class="fname">{ru ? 'Отпуск.mp4' : 'Trip.mp4'}</span>
          </div>
          <div class="ghost2" data-el="ghost">
            <span class="p-thumb vid big" />
          </div>
          <Cursor x={300} y={460} />
        </>
      )}
    </Scene>
  )
}

{
  id === 'morfu-notch' && (
    <Scene id={id} label={label}>
      <div class="screen">
        <div class="notch" data-el="notch">
          <div class="isl">
            <span class="isl-ring">
              <svg width="34" height="34" viewBox="0 0 36 36">
                <circle cx="18" cy="18" r="15" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="3.5" />
                <circle data-el="ring" cx="18" cy="18" r="15" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 18 18)" />
              </svg>
            </span>
            <span class="isl-txt">
              <b>{ru ? 'Презентация.pdf' : 'Deck.pdf'}</b>
              <small data-el="islsub">{ru ? 'Сжатие PDF…' : 'Compressing PDF…'}</small>
            </span>
            <span class="isl-res" data-el="islres">−62%</span>
          </div>
        </div>
        <div class="dfile" data-el="file" style="left:340px;top:380px">
          <span class="p-thumb pdf big" />
          <span class="fname">{ru ? 'Презентация.pdf' : 'Deck.pdf'}</span>
        </div>
        <div class="ghost2" data-el="ghost">
          <span class="p-thumb pdf big" />
        </div>
        <Cursor x={600} y={470} />
      </div>
    </Scene>
  )
}

{
  id === 'morfu-trace' && (
    <Scene id={id} label={label}>
      <div class="trace">
        <div class="tr-head">
          <span class="lights">
            <i />
            <i />
            <i />
          </span>
          <div class="tr-seg">
            <span data-el="bw" class="on">
              {ru ? 'SVG ч/б' : 'SVG b/w'}
            </span>
            <span data-el="col">{ru ? 'SVG цвет' : 'SVG colour'}</span>
          </div>
        </div>
        <div class="tr-cols">
          <div class="tr-pane">
            <svg viewBox={`0 0 ${N} ${N}`} class="raster" shape-rendering="crispEdges" set:html={`<g fill="#1d1d22">${cells.join('')}</g>`} />
            <small>logo.png · 24 × 24</small>
          </div>
          <div class="tr-arrow">→</div>
          <div class="tr-pane">
            <svg viewBox="-60 -60 120 120" class="vector" data-el="vec">
              <circle r="56" fill="none" stroke="currentColor" stroke-width="7" class="v-ring" />
              <path class="v-leaf" d="M0 -50 C 34 -30 40 10 0 50 C -40 10 -34 -30 0 -50 Z" />
              <path class="v-vein" d="M0 -36 L0 50" />
            </svg>
            <small>logo.svg · 1,2 {ru ? 'КБ' : 'KB'}</small>
          </div>
        </div>
        <div class="tr-sliders">
          {(ru ? ['Цвета', 'Детали', 'Сглаживание'] : ['Colours', 'Detail', 'Smoothing']).map((n, i) => (
            <label>
              <span>{n}</span>
              <span class="trk">
                <i data-el={`s${i}`} style={`--v:${[30, 60, 45][i]}%`} />
              </span>
            </label>
          ))}
        </div>
      </div>
    </Scene>
  )
}


---
// Указатель macOS для сцен. Двигается из timeline: el.style.translate = 'x y'.
interface Props { x?: number; y?: number; id?: string }
const { x = 0, y = 0, id = 'cursor' } = Astro.props;
---
<div class="s-cursor" data-el={id} style={`translate:${x}px ${y}px`}>
  <svg class="arrow" width="26" height="30" viewBox="0 0 26 30"><path d="M3 2v22.5l5.6-5.3 3.6 8.3 3.9-1.7-3.6-8.1 7.7-.2Z" fill="#000" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg>
  <svg class="grab" width="28" height="28" viewBox="0 0 28 28"><path d="M8.5 13V8.6a1.6 1.6 0 0 1 3.2 0V12m0-1.6V6.8a1.6 1.6 0 0 1 3.2 0V12m0-4.2a1.6 1.6 0 0 1 3.2 0V12.6m0-2.6a1.6 1.6 0 0 1 3.2 0v6.2c0 4.6-2.8 8-7.4 8-3.4 0-5-1.7-6.7-4.4l-2.3-3.7a1.6 1.6 0 0 1 2.6-1.8l1.4 1.8V13" fill="#fff" stroke="#000" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
</div>
<style>
  .s-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    pointer-events: none;
    transition: translate 0.9s cubic-bezier(0.45, 0, 0.2, 1);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35));
  }
  .s-cursor .grab { display: none; margin: -4px 0 0 -6px; }
  :global(.s-cursor.grabbing) .arrow { display: none; }
  :global(.s-cursor.grabbing) .grab { display: block; }
  :global(.s-cursor.fast) { transition-duration: 0.45s; }
  :global(.s-cursor.slow) { transition-duration: 1.3s; }
</style>

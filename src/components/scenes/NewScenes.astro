---
// Сцены PadBridge, Moss Pocket, Peecube и ANY CAMERA.
// PadBridge — по Views/NewGamePopup.swift, Genre.swift и строкам Localizable.xcstrings;
// Moss Pocket — по README (панель у Dock, увеличение); Peecube — по скриншотам store/firefox;
// ANY CAMERA — по popup/popup.html и popup.css. Оранжевые цвета заменены по концепции сайта.
import Scene from './Scene.astro';
import Cursor from './Cursor.astro';
import { asset } from '../../i18n';

interface Props {
  id: string;
  lang: 'ru' | 'en';
  label: string;
}
const { id, lang, label } = Astro.props;
const ru = lang === 'ru';

// PadBridge: жанры и цвета профилей (платформер — жёлтый вместо оранжевого #FFB020)
const genres: [string, string, string][] = [
  [ru ? 'Платформер' : 'Platformer', '#F2CC4E', ru ? 'Стрелки на левом стике, прыжок — пробел, действия — Z / X / C.' : 'Arrow keys on the left stick, Space to jump, Z / X / C for actions.'],
  [ru ? 'Шутер / экшен' : 'Shooter / action', '#FF4D5E', ru ? 'WASD на левом стике, мышь на правом, курки — клики.' : 'WASD on the left stick, mouse on the right, triggers click.'],
  [ru ? 'Стратегия' : 'Strategy', '#3DD68C', ru ? 'Курсор на левом стике, клики на кнопках, прокрутка карты на правом стике, масштаб на курках.' : 'Cursor on the left stick, clicks on the buttons, map scrolling on the right stick, zoom on the triggers.'],
  [ru ? 'Визуальная новелла' : 'Visual novel', '#C77DFF', ru ? '«Дальше» и «Назад» на кнопках, меню — на Options.' : '“Next” and “Back” on buttons, menu on Options.'],
  [ru ? 'Браузерная игра' : 'Browser game', '#2EC5FF', ru ? 'Стрелки и пробел, WASD на крестовине, мышь на правом стике.' : 'Arrow keys and Space, WASD on the D-pad, mouse on the right stick.'],
];
const mapRows: [string, string, string][] = [
  ['south', '✕', ru ? 'Пробел' : 'Space'],
  ['east', '○', 'X'],
  ['west', '□', 'Z'],
  ['north', '△', 'C'],
  ['l1', 'L1', 'Q'],
  ['r1', 'R1', 'E'],
  ['ls', ru ? 'Левый стик' : 'Left stick', ru ? 'Стрелки' : 'Arrow keys'],
  ['rs', ru ? 'Правый стик' : 'Right stick', ru ? 'Мышь' : 'Mouse'],
];
const kb = ru ? ['ЙЦУКЕНГШЩЗХ', 'ФЫВАПРОЛДЖЭ', 'ЯЧСМИТЬБЮ'] : ['QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM'];
const files: [string, string, string][] = [
  ['pdf', ru ? 'Договор.pdf' : 'Contract.pdf', '#c7313b'],
  ['jpg', 'IMG_2231.jpg', '#4f8fb0'],
  ['zip', ru ? 'Шрифты.zip' : 'Fonts.zip', '#8e8b85'],
  ['dmg', 'Figma.dmg', '#6e8bff'],
  ['mp4', 'Sequence 01.mp4', '#2f6f5b'],
];
const dockApps = ['#e8e8ec', '#3a7bd5', '#34c759', '#ff375f', '#5856d6'];
const swatches: [string, string, string][] = [
  ['#FBF8F3', ru ? 'фон' : 'background', '#1F2433'],
  ['#1F2433', ru ? 'текст, фон' : 'text, bg', '#ffffff'],
  ['#3B4252', ru ? 'текст' : 'text', '#ffffff'],
  ['#2E5BD8', ru ? 'акцент' : 'accent', '#ffffff'],
];
const media: [string, string][] = [
  [ru ? 'Тёплый полдень' : 'Warm noon', 'linear-gradient(135deg,#a6c48a,#6a9fc4)'],
  [ru ? 'Ночной город' : 'Night city', 'linear-gradient(135deg,#1f2433,#7c3aed)'],
  [ru ? 'Туман над морем' : 'Sea fog', 'linear-gradient(135deg,#c9d6e2,#7b93a8)'],
  [ru ? 'Коралл' : 'Coral', 'linear-gradient(135deg,#f3c1d2,#c2477a)'],
  [ru ? 'Осень в горах' : 'Autumn hills', 'linear-gradient(135deg,#d9cfb0,#5b6b3a)'],
];
const toggles: [string, string][] = ru
  ? [
      ['Ссылки из выделенного текста', 'Выделите текст и нажмите ⌥⌘L — все ссылки откроются'],
      ['Блокировка рекламы и cookie-баннеров', 'Около 60 рекламных сетей и счётчиков, баннеры о cookie'],
      ['Автоотказ от cookie', 'Нажимает «Отклонить» в баннерах о cookie — сайты меньше следят'],
      ['Без запросов от сайтов', 'Никаких «Разрешите уведомления» и геолокации'],
      ['YouTube без отвлечений', 'Без рекомендаций, комментариев и Shorts — только видео'],
      ['Перевод страниц', 'Через Google Переводчик · ⌘⇧L'],
    ]
  : [
      ['Links from selected text', 'Select text and press ⌥⌘L — every link opens'],
      ['Ad and cookie-banner blocking', 'About 60 ad networks and trackers, cookie banners'],
      ['Automatic cookie refusal', 'Clicks “Reject” on cookie banners'],
      ['No site prompts', 'No “Allow notifications” or location requests'],
      ['Distraction-free YouTube', 'No recommendations, comments or Shorts — just the video'],
      ['Page translation', 'Via Google Translate · ⌘⇧L'],
    ];
---

{
  id === 'padbridge-map' && (
    <Scene id={id} label={label}>
      <div class="pb-win">
        <div class="pb-head">
          <span class="dot" style="background:#F2CC4E" />
          <b>Celeste</b>
          <span class="muted">· {ru ? 'Платформер' : 'Platformer'}</span>
          <span class="pb-auto">{ru ? 'Авто: Celeste' : 'Auto: Celeste'}</span>
        </div>
        <div class="pb-body">
          <svg class="pad" viewBox="0 0 300 200">
            <path d="M70 40h160c26 0 40 18 46 44l18 72c5 22-18 36-34 20l-34-36H74l-34 36c-16 16-39 2-34-20l18-72c6-26 20-44 46-44z" fill="#e8e9f3" />
            <g class="pd" data-p="dpad">
              <rect x="56" y="78" width="14" height="40" rx="3" fill="#2a2d3a" />
              <rect x="43" y="91" width="40" height="14" rx="3" fill="#2a2d3a" />
            </g>
            <circle class="pd" data-p="ls" cx="104" cy="132" r="17" fill="#2a2d3a" />
            <circle class="pd" data-p="rs" cx="196" cy="132" r="17" fill="#2a2d3a" />
            <g font-family="-apple-system,system-ui" font-size="11" font-weight="700" text-anchor="middle">
              <circle class="pd" data-p="north" cx="240" cy="78" r="11" fill="#2a2d3a" /><text x="240" y="82" fill="#e8e9f3">△</text>
              <circle class="pd" data-p="west" cx="222" cy="98" r="11" fill="#2a2d3a" /><text x="222" y="102" fill="#e8e9f3">□</text>
              <circle class="pd" data-p="east" cx="258" cy="98" r="11" fill="#2a2d3a" /><text x="258" y="102" fill="#e8e9f3">○</text>
              <circle class="pd" data-p="south" cx="240" cy="118" r="11" fill="#2a2d3a" /><text x="240" y="122" fill="#e8e9f3">✕</text>
            </g>
            <rect class="pd" data-p="l1" x="62" y="30" width="44" height="10" rx="5" fill="#2a2d3a" />
            <rect class="pd" data-p="r1" x="194" y="30" width="44" height="10" rx="5" fill="#2a2d3a" />
          </svg>
          <div class="pb-rows">
            {mapRows.map(([k, b, a]) => (
              <div class="pb-row" data-r={k}>
                <span class="pb-b">{b}</span>
                <span class="pb-arr">→</span>
                <span class="pb-k">{a}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'padbridge-newgame' && (
    <Scene id={id} label={label} bg="none" class="pb-game">
      <div class="game">
        <div class="g-sky" />
        {[...Array(9)].map((_, i) => (
          <span class="g-block" style={`left:${i * 92}px;top:${380 + (i % 3) * 18}px`} />
        ))}
        <span class="g-hero" />
      </div>
      <div class="ng">
        <div class="ng-top">
          <span class="ng-spark">✦</span>
          <div>
            <b>{ru ? 'Новая игра: Celeste' : 'New game: Celeste'}</b>
            <small>{ru ? 'Выберите тип — раскладка уже готова. Лежит в папке с играми.' : 'Pick a type — the layout is ready. Found in a games folder.'}</small>
          </div>
          <span class="ng-x">✕</span>
        </div>
        <div class="ng-opts">
          {genres.map(([n, c], i) => (
            <div class:list={['ng-opt', { sel: i === 0 }]} data-opt={i} style={`--c:${c}`}>
              <i />
              <span>{n}</span>
            </div>
          ))}
        </div>
        <p class="ng-det" data-el="det" data-texts={JSON.stringify(genres.map((g) => g[2]))}>
          {genres[0][2]}
        </p>
        <div class="ng-btns">
          <span class="ng-b prim" data-el="apply">✕ {ru ? 'Применить' : 'Apply'}</span>
          <span class="ng-b">△ {ru ? 'Научить' : 'Teach'}</span>
          <span class="ng-b">○ {ru ? 'Не сейчас' : 'Not now'}</span>
          <span class="ng-hint">← →</span>
        </div>
      </div>
      <div class="ng-toast" data-el="toast">{ru ? 'Профиль «Celeste» включён' : 'Profile “Celeste” is on'}</div>
    </Scene>
  )
}

{
  id === 'padbridge-learn' && (
    <Scene id={id} label={label}>
      <div class="lr">
        <div class="lr-l">
          <b>{ru ? 'Научить' : 'Learn mode'}</b>
          <small>{ru ? 'Играйте на клавиатуре — PadBridge считает нажатия' : 'Play on the keyboard — PadBridge counts presses'}</small>
          {[
            ['W A S D', 92, 'ls'],
            [ru ? 'Мышь' : 'Mouse', 80, 'rs'],
            [ru ? 'Пробел' : 'Space', 64, 'south'],
            ['Shift', 38, 'r2'],
            ['E', 26, 'west'],
            ['Q', 14, 'north'],
          ].map(([k, v, t]) => (
            <div class="lr-k" data-t={t}>
              <span>{k}</span>
              <span class="lr-bar">
                <i data-v={v} />
              </span>
            </div>
          ))}
        </div>
        <div class="lr-r">
          {[
            ['ls', ru ? 'Левый стик' : 'Left stick', 'W A S D'],
            ['rs', ru ? 'Правый стик' : 'Right stick', ru ? 'Прицел (мышь)' : 'Aim (mouse)'],
            ['south', '✕', ru ? 'Прыжок' : 'Jump'],
            ['r2', 'R2', 'Shift'],
            ['west', '□', 'E'],
            ['north', '△', 'Q'],
          ].map(([k, b, a]) => (
            <div class="lr-m" data-m={k}>
              <span class="pb-b">{b}</span>
              <span class="pb-arr">→</span>
              <span>{a}</span>
            </div>
          ))}
          <span class="lr-done" data-el="done">{ru ? 'Готово — построить раскладку' : 'Done — build the layout'}</span>
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'padbridge-couch' && (
    <Scene id={id} label={label}>
      <div class="couch-hint">{ru ? 'Режим «Диван» · L3 + R3' : 'Couch mode · L3 + R3'}</div>
      <div class="couch-field">
        <span data-el="typed" />
        <i class="caret2" />
      </div>
      <div class="osk">
        {kb.map((row, r) => (
          <div class="osk-row">
            {[...row].map((ch) => (
              <span class="osk-k" data-ch={ch.toLowerCase()}>
                {ch}
              </span>
            ))}
            {r === 2 && <span class="osk-k wide">⌫</span>}
          </div>
        ))}
        <div class="osk-row">
          <span class="osk-k wide">RU / EN</span>
          <span class="osk-k space" data-ch=" ">{ru ? 'Пробел' : 'Space'}</span>
          <span class="osk-k wide">↵</span>
        </div>
      </div>
      <script type="application/json" data-word set:html={JSON.stringify(ru ? 'привет' : 'hello')} />
    </Scene>
  )
}

{
  (id === 'moss-panel' || id === 'moss-drag' || id === 'moss-magnify') && (
    <Scene id={id} label={label}>
      {id === 'moss-drag' && (
        <div class="chat">
          <div class="chat-h">
            <span class="lights">
              <i />
              <i />
              <i />
            </span>
            <b>{ru ? 'Команда продукта' : 'Product team'}</b>
          </div>
          <div class="chat-b">
            <p class="msg">{ru ? 'Скинь договор, пожалуйста' : 'Please send the contract'}</p>
            <p class="msg me att" data-el="att">
              <i style="background:#c7313b" />
              {ru ? 'Договор.pdf · 1,2 МБ' : 'Contract.pdf · 1.2 MB'}
            </p>
          </div>
        </div>
      )}
      <div class="dockrow" data-el="row">
        <div class="mdock">
          {dockApps.map((c) => (
            <span class="mi app" style={`--c:${c}`} />
          ))}
        </div>
        <div class="mpanel" data-el="panel">
          {files.map(([e, n, c], i) => (
            <span class="mi file" data-f={i} style={`--c:${c}`} title={n}>
              <em>{e.toUpperCase()}</em>
            </span>
          ))}
          <span class="mi file new" data-el="new" style="--c:#9ccb7a">
            <em>ZIP</em>
            <b class="spin" />
          </span>
        </div>
      </div>
      <div class="mtip" data-el="tip">
        {files[0][1]}
      </div>
      {id === 'moss-drag' && (
        <div class="ghost3" data-el="ghost">
          <span class="mi file" style="--c:#c7313b">
            <em>PDF</em>
          </span>
        </div>
      )}
      <Cursor x={620} y={300} />
    </Scene>
  )
}

{
  id === 'peecube-popup' && (
    <Scene id={id} label={label} bg="none" class="pc-bg">
      <div class="msgr">
        <div class="msgr-bar">
          <span class="lights">
            <i />
            <i />
            <i />
          </span>
          <span class="url">{ru ? 'Мессенджер' : 'Messenger'}</span>
        </div>
        <div class="msgr-body">
          <aside>
            {(ru ? [['Дизайн-дайджест', 'Палитры осени: 30 сочетаний…'], ['Команда продукта', 'Созвон в 15:00'], ['Путешествия', 'Билеты в Стамбул']] : [['Design digest', 'Autumn palettes: 30 combos…'], ['Product team', 'Call at 3 pm'], ['Travel', 'Tickets to Istanbul']]).map(([t, s], i) => (
              <div class:list={['ch', { on: i === 0 }]}>
                <i />
                <span>
                  <b>{t}</b>
                  <small>{s}</small>
                </span>
              </div>
            ))}
          </aside>
          <section>
            <div class="post">
              <b>{ru ? 'Дизайн-дайджест' : 'Design digest'}</b>
              <p>{ru ? 'Студия «Ветер» показала работы за десять лет:' : 'Studio “Veter” shows ten years of work:'}</p>
              <u data-el="link">veter.studio/vystavka</u>
            </div>
            <div class="post">
              <b>{ru ? 'Дизайн-дайджест' : 'Design digest'}</b>
              <p>{ru ? 'Подборка: 12 шрифтов для интерфейсов' : 'Picks: 12 typefaces for interfaces'}</p>
              <u>fonts.example</u>
            </div>
          </section>
        </div>
      </div>
      <div class="keychip" data-el="chip">⌥ + {ru ? 'правый клик' : 'right-click'}</div>
      <div class="pop" data-el="pop">
        <div class="pop-bar">
          <span class="lights">
            <i />
            <i />
            <i />
          </span>
          <span class="url">veter.studio/vystavka</span>
        </div>
        <div class="pop-tools">
          {['⬡', '⊙', '☆', '⇄', '⬇', '↗', '✕'].map((t) => (
            <span>{t}</span>
          ))}
        </div>
        <div class="site">
          <b class="site-logo">{ru ? 'Ветер' : 'Veter'}</b>
          <div class="art">
            <i class="a1" />
            <i class="a2" />
            <i class="a3" />
            <i class="a4" />
          </div>
          <small class="site-k">{ru ? 'ВЫСТАВКА · ДО 30 НОЯБРЯ' : 'EXHIBITION · UNTIL 30 NOV'}</small>
          <b class="site-h">{ru ? 'Форма и цвет' : 'Form and colour'}</b>
        </div>
      </div>
      <Cursor x={620} y={460} />
    </Scene>
  )
}

{
  (id === 'peecube-analysis' || id === 'peecube-media') && (
    <Scene id={id} label={label} bg="none" class="pc-bg">
      <div class="page">
        <div class="msgr-bar">
          <span class="lights">
            <i />
            <i />
            <i />
          </span>
          <span class="url">veter.studio</span>
        </div>
        <div class="site wide">
          <b class="site-logo">{ru ? 'Ветер' : 'Veter'}</b>
          <div class="art">
            <i class="a1" />
            <i class="a2" />
            <i class="a3" />
            <i class="a4" />
          </div>
          <small class="site-k">{ru ? 'ВЫСТАВКА · ДО 30 НОЯБРЯ' : 'EXHIBITION · UNTIL 30 NOV'}</small>
          <b class="site-h">{ru ? 'Форма и цвет' : 'Form and colour'}</b>
        </div>
      </div>
      <div class="side" data-el="side">
        <div class="side-h">
          <img src={asset('icons/peecube-160.webp')} width="22" height="22" alt="" />
          <b>{id === 'peecube-analysis' ? (ru ? 'Анализ страницы' : 'Page analysis') : ru ? 'Фото, видео и аудио' : 'Photos, video & audio'}</b>
          <span>✕</span>
        </div>
        {id === 'peecube-analysis' ? (
          <>
            <div class="tabs3">
              {(ru ? ['Дизайн', 'Технологии', 'Картинки'] : ['Design', 'Tech', 'Images']).map((t, i) => (
                <span class:list={{ on: i === 0 }}>{t}</span>
              ))}
            </div>
            <small class="side-l">{ru ? 'ШРИФТЫ' : 'FONTS'}</small>
            <div class="font-card">
              <b style="font-family:Georgia,serif">Georgia</b>
              <small>{ru ? '74% текста · начертания 400 · размеры 18, 21 px' : '74% of text · weight 400 · sizes 18, 21 px'}</small>
            </div>
            <div class="font-card">
              <b>-apple-system</b>
              <small>{ru ? '26% текста · начертания 600, 700, 800' : '26% of text · weights 600, 700, 800'}</small>
            </div>
            <small class="side-l">{ru ? 'ЦВЕТА · КЛИК — СКОПИРОВАТЬ' : 'COLOURS · CLICK TO COPY'}</small>
            <div class="sws2">
              {swatches.map(([c, r], i) => (
                <span data-sw={i}>
                  <i style={`background:${c}`} />
                  <b>{c}</b>
                  <small>{r}</small>
                </span>
              ))}
            </div>
            <div class="copied" data-el="copied">
              {ru ? 'Скопировано: ' : 'Copied: '}
              <b data-el="cval" />
            </div>
          </>
        ) : (
          <>
            <span class="dl-all">⬇ {ru ? 'Скачать видео с этой страницы' : 'Download video from this page'}</span>
            <span class="dl-count">{ru ? 'Все картинки (7)' : 'All images (7)'}</span>
            {media.map(([n, g], i) => (
              <div class="mrow" data-m={i}>
                <i style={`background:${g}`} />
                <span>
                  <b>{n}</b>
                  <small>{ru ? 'Картинка · 1200×800' : 'Image · 1200×800'}</small>
                </span>
                <em class="mbtn">⬇</em>
              </div>
            ))}
          </>
        )}
      </div>
    </Scene>
  )
}

{
  id === 'peecube-features' && (
    <Scene id={id} label={label} bg="none" class="pc-bg">
      <div class="pset">
        <aside>
          <span class="brand2">
            <img src={asset('icons/peecube-160.webp')} width="26" height="26" alt="" />
            Peecube
          </span>
          {(ru ? ['Основные', 'Окно', 'Функции', 'Настроение', 'Сайты', 'Слежение', 'Статистика', 'История', 'Лицензия'] : ['General', 'Window', 'Features', 'Mood', 'Sites', 'Watching', 'Stats', 'History', 'License']).map((n, i) => (
            <span class:list={['ps-l', { on: i === 2 }]}>{n}</span>
          ))}
        </aside>
        <section>
          <b class="ps-h">{ru ? 'Функции' : 'Features'}</b>
          <small class="ps-d">{ru ? 'Всё, что Peecube умеет делать со страницами.' : 'Everything Peecube can do with pages.'}</small>
          <div class="ps-g">
            {toggles.map(([t, d], i) => (
              <div class="ps-row">
                <span>
                  <b>{t}</b>
                  <small>{d}</small>
                </span>
                <i class="tg on" data-tg={i} />
              </div>
            ))}
          </div>
        </section>
      </div>
    </Scene>
  )
}

{
  id === 'anycam-call' && (
    <Scene id={id} label={label} bg="none" class="ac-bg">
      <div class="call">
        <div class="call-top">
          <b>{ru ? 'Созвон · Демо продукта' : 'Call · Product demo'}</b>
          <span class="cam-sel" data-el="sel">
            <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m16 10 6-3v10l-6-3z"/></svg> <span data-el="camname">FaceTime HD</span> ▾
          </span>
        </div>
        <div class="tiles">
          <div class="tile me" data-el="me">
            <div class="off">{ru ? 'Камера выключена' : 'Camera off'}</div>

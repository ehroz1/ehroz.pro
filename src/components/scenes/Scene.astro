---
// Рамка сцены: рисуем интерфейс в фиксированных координатах (w×h) и масштабируем под контейнер,
// чтобы пропорции настоящего UI сохранялись на любом экране.
interface Props {
  id: string;
  w?: number;
  h?: number;
  label: string;
  class?: string;
  bg?: 'wall' | 'none';
}
const { id, w = 800, h = 560, label, class: cls, bg = 'wall' } = Astro.props;
---

<div class:list={['scene', `bg-${bg}`, cls]} data-scene={id} style={`--w:${w};--h:${h}`} role="img" aria-label={label}>
  <div class="scene-inner" aria-hidden="true">
    <slot />
  </div>
</div>

<style>
  .scene {
    --k: 1;
    position: relative;
    width: 100%;
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    border-radius: inherit;
    container-type: inline-size;
    contain: layout paint;
  }
  .scene.bg-wall {
    /* студийная подложка: ровный графит и точечная сетка 20 px — как стол для предметной съёмки */
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1.2px) 0 0 / 20px 20px,
      #1b1b1d;
  }
  .scene-inner {
    position: absolute;
    left: calc(var(--ox, 0) * 1px);
    top: calc(var(--oy, 0) * 1px);
    width: calc(var(--w) * 1px);
    height: calc(var(--h) * 1px);
    transform: scale(var(--k));
    transform-origin: 0 0;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* Пока сцена не видна — анимации на паузе */
  .scene :global(*) {
    animation-play-state: paused;
  }
  .scene:global(.playing) :global(*) {
    animation-play-state: running;
  }
</style>

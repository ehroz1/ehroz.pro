---
// Кольцо Morfus по ui/ring.css: диск, «дольки», центр со значком файла, плашка и подсказка.
import { ringSectors } from '../../lib/ring';

interface Props {
  labels: { t: string; s?: string }[];
  ext: string;
  hot?: number;
  theme?: 'light' | 'dark';
  pill?: string;
  hint?: 0 | 1 | 2 | -1;
  more?: number;
  class?: string;
  lang: 'ru' | 'en';
}
const { labels, ext, hot = -1, theme = 'light', pill, hint = 0, more, class: cls, lang } = Astro.props;
const S = 320;
const sectors = ringSectors(labels.length, S / 2, S / 2, 146, 58, 9, 12, labels.length % 2 ? 0 : 360 / labels.length / 2);
const modes = lang === 'ru' ? ['Конвертация', 'Сжатие', 'Инструменты'] : ['Convert', 'Compress', 'Tools'];
const keys = ['⌥', '⌘', '⌃'];
---

<div class:list={['mring', theme, cls]} data-ring>
  <div class="disc"></div>
  <svg class="sectors" viewBox={`0 0 ${S} ${S}`} width={S} height={S}>
    {sectors.map((s, i) => <path class:list={['sector', { hot: i === hot }]} d={s.d} style={`--delay:${i * 22}ms`} data-i={i} />)}
    <circle class="track" cx={S / 2} cy={S / 2} r="49" />
    <circle class="bar" cx={S / 2} cy={S / 2} r="49" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
  </svg>
  {
    sectors.map((s, i) => (
      <span class:list={['label', { hot: i === hot }]} style={`left:${s.lx}px;top:${s.ly}px;--delay:${i * 22}ms`} data-i={i}>
        <span class="l-title">{labels[i].t}</span>
        {labels[i].s && <span class="l-sub">{labels[i].s}</span>}
      </span>
    ))
  }
  <div class="hub">
    <div class="file">
      <svg class="glyph" width="30" height="36" viewBox="-2 -1 30 36">
        <path class="g-page" d="M3 1h15l7 7v23a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2z" />
        <path class="g-fold" d="M18 1v7h7" />
        <rect class="g-tag" x="3" y="17.5" width="20" height="9" rx="2" />
        <text x="13" y="24.3" text-anchor="middle" class="g-ext">{ext}</text>
      </svg>
    </div>
    <div class="mark">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
    </div>
    {more && <span class="more">+{more}</span>}
  </div>
  <div class="foot">
    {
      pill !== undefined && (
        <div class="pill" data-pill set:html={pill} />
      )
    }
    {
      hint >= 0 && (
        <div class="hint">
          {modes.map((m, i) => (
            <>
              {i > 0 && <span class="sep">·</span>}
              <span class:list={['mode', { on: i === hint }]} data-mode={i}>
                <b>{keys[i]}</b> {m}
              </span>
            </>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .mring {
    --disc: rgba(36, 36, 40, 0.62);
    --disc-line: rgba(255, 255, 255, 0.18);
    --sector: rgba(255, 255, 255, 0.14);
    --hub: rgba(255, 255, 255, 0.08);
    --text: #f5f5f7;
    --muted: #c7c7cc;
    --hot: #000000;
    --on-hot: #ffffff;
    --pill: rgba(44, 44, 48, 0.92);
    --page: #f5f5f7;
    --page-line: #8e8e93;
    --tag: #1d1d1f;
    --tag-text: #ffffff;
    position: absolute;
    width: 320px;
    height: 320px;
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, 'Inter', sans-serif;
    opacity: 0;
    transform: scale(0.9);
    transition: transform 220ms cubic-bezier(0.2, 1.3, 0.4, 1), opacity 140ms ease-out;
  }
  .mring.light {
    --disc: rgba(226, 224, 236, 0.66);
    --disc-line: rgba(255, 255, 255, 0.7);
    --sector: rgba(255, 255, 255, 0.86);
    --hub: rgba(255, 255, 255, 0.55);
    --text: #1d1d1f;
    --muted: #545458;
    --hot: #1d1d1f;
    --pill: rgba(246, 246, 248, 0.94);
    --page: #ffffff;
    --page-line: #c7c7cc;
  }
  .mring.shown {
    opacity: 1;
    transform: scale(1);
  }
  .mring.closing {
    opacity: 0;
    transform: scale(0.94);
    transition: transform 140ms ease-in, opacity 140ms ease-in;
  }
  .disc {
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--disc);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    box-shadow: inset 0 0 0 0.5px var(--disc-line), inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 2px 8px rgba(0, 0, 0, 0.18), 0 30px 60px -20px rgba(0, 0, 0, 0.45);
  }
  .sectors {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  .sector {
    fill: var(--sector);
    transition: fill 120ms, opacity 160ms;
  }
  .sector.hot {
    fill: var(--hot);
  }
  .label {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.15;
    transition: color 120ms, opacity 160ms;
    max-width: 92px;
  }
  .l-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }
  .l-sub {
    margin-top: 2px;
    font-size: 10.5px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
  }
  .label.hot,
  .label.hot .l-sub {
    color: var(--on-hot);
  }
  .hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 92px;
    height: 92px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--hub);
    box-shadow: inset 0 0 0 0.5px var(--disc-line);
    display: grid;
    place-items: center;
  }
  .file,
  .mark {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition: opacity 150ms, transform 150ms;
  }
  .mark {
    opacity: 0;
    color: var(--text);
  }
  .g-page {
    fill: var(--page);
    stroke: var(--page-line);
    stroke-width: 1;
  }
  .g-fold {
    fill: none;
    stroke: var(--page-line);
    stroke-width: 1;
  }
  .g-tag {
    fill: var(--tag);
  }
  .g-ext {
    fill: var(--tag-text);
    font: 700 6.5px -apple-system, system-ui, sans-serif;
  }
  .more {
    position: absolute;
    right: 8px;
    bottom: 10px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--hot);
    color: var(--on-hot);
    font-size: 10px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }
  .track,
  .bar {
    fill: none;
    stroke-width: 3;
    opacity: 0;
    transition: opacity 150ms;
    transform: rotate(-90deg);
    transform-origin: 160px 160px;
  }
  .track {
    stroke: color-mix(in srgb, var(--text) 16%, transparent);
  }
  .bar {
    stroke: var(--text);
    stroke-linecap: round;
    transition: stroke-dashoffset 900ms ease-out, opacity 150ms;
  }
  .mring.busy .track,
  .mring.busy .bar,
  .mring.done .bar {
    opacity: 1;
  }
  .mring.busy .sector:not(.hot),
  .mring.busy .label:not(.hot),
  .mring.done .sector:not(.hot),
  .mring.done .label:not(.hot) {
    opacity: 0.25;
  }
  .mring.busy .sector.hot {
    animation: pulse 1.1s ease-in-out infinite;
  }
  .mring.done .file {
    opacity: 0;
    transform: scale(0.8);
  }
  .mring.done .mark {
    opacity: 1;
  }
  @keyframes pulse {
    50% {
      opacity: 0.6;
    }
  }
  .foot {
    position: absolute;
    left: -60px;
    right: -60px;
    top: calc(100% + 6px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 12px;
    background: var(--pill);
    box-shadow: inset 0 0 0 0.5px var(--disc-line), 0 4px 14px rgba(0, 0, 0, 0.22);
    color: var(--text);
    font-size: 13px;
    white-space: nowrap;
  }
  .pill :global(.p-name) {
    font-weight: 500;
  }
  .pill :global(.p-target) {
    font-weight: 700;
  }
  .pill :global(.p-muted) {
    color: var(--muted);
  }
  .pill :global(.p-ok) {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hint {
    display: flex;
    gap: 2px 6px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55), 0 0 6px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
  }
  .hint .mode {
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .hint .mode b {
    font-weight: 600;
  }
  .hint .mode.on {
    opacity: 1;
    font-weight: 600;
  }
  .hint .sep {
    opacity: 0.6;
  }
  .mring.busy .hint,
  .mring.done .hint {
    opacity: 0;
  }
</style>

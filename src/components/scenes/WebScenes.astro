---
// Сцены radius, BLA-БЛА и Picta.
// BLA-БЛА — по скриншотам docs/assets и таблице сервисов из README; Picta — по css/styles.css и README.
import Scene from './Scene.astro';
import { asset } from '../../i18n';

interface Props {
  id: string;
  lang: 'ru' | 'en';
  label: string;
}
const { id, lang, label } = Astro.props;
const ru = lang === 'ru';
const dots = (n: number) => '●●●'.slice(0, n) + '○○○'.slice(0, 3 - n);
const providers: [string, string, number, number, boolean][] = [
  ['Groq Whisper', 'Groq', 2, 1, false],
  ['Google Gemini', 'Google AI Studio', 3, 2, false],
  ['ElevenLabs Scribe', 'ElevenLabs', 3, 3, false],
  ['Speechmatics', 'Speechmatics', 3, 0, false],
  ['AssemblyAI', 'AssemblyAI', 2, 0, false],
  ['Gladia', 'Gladia', 3, 2, false],
  ['Mistral Voxtral', 'Mistral', 2, 0, false],
  ['Deepgram Nova-3', 'Deepgram', 3, 0, false],
  ['Soniox', 'Soniox', 3, 3, true],
  ['Yandex SpeechKit', 'Yandex Cloud', 2, 3, true],
  ['OpenAI', 'OpenAI', 3, 1, true],
];
const tiles = [
  [180, 'linear-gradient(160deg,#f5c28a,#d97a4a)', 'pixabay'],
  [120, 'linear-gradient(160deg,#9fb7c9,#4d6a85)', 'pexels'],
  [150, 'linear-gradient(160deg,#e8d9c5,#a88d6c)', 'unsplash'],
  [200, 'linear-gradient(160deg,#bfc8a8,#6f7d52)', 'wikimedia'],
  [130, 'linear-gradient(160deg,#f0b8a0,#b05f4a)', 'openverse'],
  [170, 'linear-gradient(160deg,#d6d0e8,#7d6fa8)', 'pexels'],
  [140, 'linear-gradient(160deg,#f4dfa0,#c99b3b)', 'pixabay'],
  [190, 'linear-gradient(160deg,#a8c4b8,#4f7d6c)', 'unsplash'],
  [120, 'linear-gradient(160deg,#c7c9cf,#6e7180)', 'wikimedia'],
  [160, 'linear-gradient(160deg,#f2c9c0,#c4776a)', 'openverse'],
  [150, 'linear-gradient(160deg,#b3d1ef,#5a86b8)', 'pixabay'],
  [130, 'linear-gradient(160deg,#e6cfa8,#9b7a45)', 'pexels'],
] as const;
const src: Record<string, string> = { pixabay: '#2ecc71', pexels: '#05a081', unsplash: '#101114', wikimedia: '#3366cc', openverse: '#ff6428' };
// простые иконки для режима «Иконки» (stroke, 24×24)
const icons = [
  '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  '<path d="M4 12l8-8 8 8v8H4z"/><path d="M10 20v-5h4v5"/>',
  '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  '<rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 6l1.5-2h5L16 6"/>',
  '<path d="M4 6h16M4 12h16M4 18h10"/>',
  '<circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5"/>',
  '<path d="M12 3l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 16.7 6.7 19.5l1.1-6L3.4 9.3l6-.8z"/>',
  '<path d="M5 12h14M13 6l6 6-6 6"/>',
  '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M4 15l4-4 4 4 3-3 5 5"/><circle cx="15" cy="9" r="1.5"/>',
  '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M10 21h4"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
];
const palette = ['#0b3d5c', '#1b6a8f', '#3fa1c4', '#8fd3e8', '#e8f4f6', '#d9c8a6'];
---

{
  id === 'radius-matte' && (
    <Scene id={id} label={label} bg="none" class="rad">
      <div class="split" data-el="split" style="--x:50%">
        <div class="layer orig">
          <svg viewBox="0 0 800 560" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="rb" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e9d7c3" />
                <stop offset="1" stop-color="#9a8b7c" />
              </linearGradient>
            </defs>
            <rect width="800" height="560" fill="url(#rb)" />
            <rect x="80" y="60" width="180" height="300" rx="6" fill="#c9b49c" />
            <rect x="560" y="120" width="140" height="80" rx="4" fill="#b8a189" />
            <circle cx="640" cy="420" r="60" fill="#8c9a6a" opacity=".7" />
          </svg>
        </div>
        <div class="layer cut">
          <span class="checker" />
        </div>
        <svg class="subject" viewBox="0 0 800 560">
          <defs>
            <filter id="soft">
              <feGaussianBlur stdDeviation="1.2" />
            </filter>
          </defs>
          <path d="M250 560 C 260 430 320 380 400 380 C 480 380 540 430 550 560 Z" fill="#2e3a4f" />
          <rect x="378" y="320" width="44" height="70" rx="18" fill="#d6a385" />
          <ellipse cx="400" cy="250" rx="78" ry="92" fill="#e2b293" />
          <path d="M306 262 C 292 160 340 118 400 116 C 462 116 510 160 496 262 C 488 230 470 206 400 200 C 332 204 314 232 306 262 Z" fill="#3b2a22" />
          <g filter="url(#soft)" stroke="#3b2a22" stroke-width="1.6" fill="none" stroke-linecap="round" opacity=".9">
            {Array.from({ length: 60 }, (_, i) => {
              const a = Math.PI * (1.02 + (i / 59) * 0.96);
              const r0x = 100, r0y = 136;
              const x0 = 400 + Math.cos(a) * r0x * 0.96, y0 = 236 + Math.sin(a) * r0y * 0.88;
              const len = 8 + ((i * 7) % 11);
              const x1 = x0 + Math.cos(a) * len + ((i % 3) - 1) * 3, y1 = y0 + Math.sin(a) * len;
              return <path d={`M${x0.toFixed(1)} ${y0.toFixed(1)} Q ${((x0 + x1) / 2 + ((i % 2) - 0.5) * 6).toFixed(1)} ${((y0 + y1) / 2).toFixed(1)} ${x1.toFixed(1)} ${y1.toFixed(1)}`} />;
            })}
          </g>
        </svg>
        <div class="handle">
          <span>‹ ›</span>
        </div>
        <span class="lbl l">{ru ? 'Исходник' : 'Original'}</span>
        <span class="lbl r">{ru ? 'Альфа-маска' : 'Alpha matte'}</span>
      </div>
    </Scene>
  )
}

{
  id === 'radius-local' && (
    <Scene id={id} label={label} class="rad2">
      <div class="pipe">
        {[
          [ru ? 'Вход' : 'Input', 'RGB', '1 × 3 × 2048 × 2048', '[0, 1]'],
          [ru ? 'Модель' : 'Model', 'BiRefNet HR-matting', 'Core ML · fp16', ru ? 'нормализация и сигмоида внутри' : 'normalisation + sigmoid baked in'],
          [ru ? 'Выход' : 'Output', ru ? 'Альфа-маска' : 'Alpha matte', '1 × 1 × 2048 × 2048', '[0, 1]'],
        ].map(([h, t, s, n], i) => (
          <>
            {i > 0 && <span class="arr" data-step />}
            <div class="node" data-step>
              <small>{h}</small>
              <b>{t}</b>
              <span>{s}</span>
              <em>{n}</em>
            </div>
          </>
        ))}
      </div>
      <div class="offline" data-step>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 8.8a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 20h.01M3 3l18 18" />
        </svg>
        {ru ? 'Работает без интернета — фото не покидает Mac' : 'Works offline — the photo never leaves the Mac'}
      </div>
    </Scene>
  )
}

{
  id === 'bla-upload' && (
    <Scene id={id} label={label} bg="none" class="bla">
      <div class="card">
        <div class="c-h">
          <span class="ok">✓</span>
          <span>
            <b>{ru ? 'Файл' : 'File'}</b>
            <small>{ru ? 'Любое аудио или видео — звук извлечём сами.' : 'Any audio or video — we’ll extract the sound.'}</small>
          </span>
        </div>
        <div class="file" data-el="file">
          <span class="fic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m10 9 5 3-5 3z" />
            </svg>
          </span>
          <span class="fmeta">
            <b>lecture.mp4</b>
            <span>
              <i>412 {ru ? 'МБ' : 'MB'}</i>
              <i>1:48:20</i>
              <i>h264 · aac</i>
            </span>
          </span>
          <span class="x">✕</span>
        </div>
        <div class="lbl2">{ru ? 'Подготовка файла' : 'File preparation'}</div>
        <div class="select">{ru ? 'Сжать в MP3 16 кГц моно — рекомендуется (≈0,35 МБ/мин, авто-нарезка)' : 'Compress to 16 kHz mono MP3 — recommended (≈0.35 MB/min, auto-split)'}</div>
        <div class="prep">
          <div class="st" data-el="status" data-steps={JSON.stringify(ru ? ['Файл выбран', 'Сжимаю в MP3 16 кГц моно…', 'Режу под лимит Groq — 25 МБ на запрос', 'Готово: 2 части, таймкоды склеятся'] : ['File selected', 'Compressing to 16 kHz mono MP3…', 'Splitting for Groq’s 25 MB limit', 'Done: 2 parts, timestamps will be merged'])}>
            {ru ? 'Файл выбран' : 'File selected'}
          </div>
          <div class="pb">
            <i data-el="bar" />
          </div>
          <div class="chunks">
            <span data-chunk>
              {ru ? 'Часть 1' : 'Part 1'} · 0:00–54:10 · 19 {ru ? 'МБ' : 'MB'}
            </span>
            <span data-chunk>
              {ru ? 'Часть 2' : 'Part 2'} · 54:10–1:48:20 · 19 {ru ? 'МБ' : 'MB'}
            </span>
          </div>
        </div>
        <p class="fine">{ru ? 'Обработка идёт прямо в браузере — файл никуда не загружается, кроме выбранного сервиса.' : 'Processing happens in your browser — the file goes nowhere except the service you pick.'}</p>
      </div>
    </Scene>
  )
}

{
  id === 'bla-providers' && (
    <Scene id={id} label={label} bg="none" class="bla">
      <div class="prov">
        <div class="c-h">
          <span class="ok">✓</span>
          <span>
            <b>{ru ? 'Сервис' : 'Service'}</b>
            <small>{ru ? 'Точки — качество распознавания по языкам.' : 'Dots show recognition quality per language.'}</small>
          </span>
        </div>
        <div class="tabs">
          {[
            ['all', ru ? 'Все' : 'All'],
            ['mix', 'RU + EN'],
            ['kz', 'Қазақша'],
            ['free', ru ? 'Без карты' : 'No card'],
          ].map(([k, t], i) => (
            <span data-tab={k} class:list={{ on: i === 0 }}>
              {t}
            </span>
          ))}
        </div>
        <div class="pgrid">
          {providers.map(([n, c, mix, kz, card], i) => (
            <div class:list={['pc', { sel: i === 0 }]} data-p={[mix >= 3 ? 'mix' : '', kz >= 2 ? 'kz' : '', card ? '' : 'free'].join(' ')}>
              <b>{n}</b>
              <small>{c}</small>
              <span class="dots">
                <i>RU+EN {dots(mix)}</i>
                <i>KZ {kz ? dots(kz) : '—'}</i>
              </span>
            </div>
          ))}
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'bla-result' && (
    <Scene id={id} label={label} bg="none" class="bla">
      <div class="res">
        <div class="res-h">
          <b>{ru ? 'Результат' : 'Result'}</b>
          <span class="tags">
            <i>Groq Whisper</i>
            <i>whisper-large-v3</i>
            <i>{ru ? 'пример' : 'sample'}</i>
          </span>
        </div>
        <div class="lines">
          {(ru
            ? [
                ['00:00:02', '1', 'Добрый день! Сегодня поговорим про onboarding новых сотрудников.'],
                ['00:00:09', '2', 'Да, и про то, какие tools мы используем в первую неделю.'],
                ['00:00:16', '1', 'Начнём с чек-листа: доступы, Slack, Notion и встреча с ментором.'],
                ['00:00:24', '2', 'Сәлеметсіз бе! Мен де қосыламын.'],
                ['00:00:29', '1', 'Отлично, тогда по порядку.'],
              ]
            : [
                ['00:00:02', '1', 'Good afternoon! Today we’ll talk about onboarding new hires.'],
                ['00:00:09', '2', 'Yes, and which tools we use during the first week.'],
                ['00:00:16', '1', 'Let’s start with the checklist: access, Slack, Notion and a mentor call.'],
                ['00:00:24', '2', 'Сәлеметсіз бе! I’ll join too.'],
                ['00:00:29', '1', 'Great, let’s go step by step.'],
              ]
          ).map(([t, s, txt]) => (
            <p data-line>
              <time>{t}</time>
              <em class={`sp s${s}`}>{ru ? 'Спикер' : 'Speaker'} {s}</em>
              <span>{txt}</span>
            </p>
          ))}
        </div>
        <div class="dl">
          <span class="copy">{ru ? 'Копировать' : 'Copy'}</span>
          {['TXT', 'MD', 'SRT', 'VTT', 'JSON'].map((f) => (
            <span data-dl>{f}</span>
          ))}
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'picta-search' && (
    <Scene id={id} label={label} bg="none" class="picta">
      <div class="pt">
        <div class="pt-top">
          <img src={asset('icons/picta-160.webp')} width="34" height="34" alt="" />
          <div class="pt-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m21 21-4.35-4.35" />
            </svg>
            <span class="q" data-el="q" data-q={ru ? 'кот на подоконнике' : 'cat on a windowsill'} />
            <span class="caret" />
          </div>
        </div>
        <div class="pt-hint" data-el="hint">
          {ru ? (
            <>
              Ищем как: <b>cat on a windowsill</b> · <u>искать как есть</u>
            </>
          ) : (
            <>
              Searching for: <b>cat on a windowsill</b>
            </>
          )}
        </div>
        <div class="pt-chips">
          {Object.entries(src).map(([k, c]) => (
            <span>
              <i style={`background:${c}`} />
              {k[0].toUpperCase() + k.slice(1)}
            </span>
          ))}
          <span class="ext">Яндекс ↗</span>
          <span class="ext">Pinterest ↗</span>
        </div>
        <div class="masonry">
          {[0, 1, 2, 3].map((col) => (
            <div class="mcol">
              {tiles
                .filter((_, i) => i % 4 === col)
                .map(([h, bg, s]) => (
                  <span class="tile" data-tile style={`height:${h}px;background:${bg}`}>
                    <i style={`background:${src[s]}`} />
                  </span>
                ))}
            </div>
          ))}
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'picta-license' && (
    <Scene id={id} label={label} bg="none" class="picta dim">
      <div class="viewer" data-el="modal">
        <div class="v-img">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
            <rect width="400" height="300" fill="#cbb79c" />
            <rect x="40" y="30" width="320" height="190" rx="6" fill="#9fc1dc" />
            <rect x="196" y="30" width="8" height="190" fill="#e9e1d4" />
            <rect x="40" y="122" width="320" height="8" fill="#e9e1d4" />
            <rect y="220" width="400" height="80" fill="#e9e1d4" />
            <ellipse cx="200" cy="216" rx="64" ry="30" fill="#2f2f36" />
            <circle cx="236" cy="176" r="26" fill="#2f2f36" />
            <path d="M216 156l6-20 12 16M246 152l10-18 4 22" fill="#2f2f36" />
            <path d="M140 222c-30 6-34 26-14 30" stroke="#2f2f36" stroke-width="10" fill="none" stroke-linecap="round" />
          </svg>
        </div>
        <div class="v-side">
          <b class="v-t">{ru ? 'Кот на подоконнике' : 'Cat on a windowsill'}</b>
          <small class="v-a">Wikimedia Commons</small>
          <div class="v-tags">
            <span class="lic" data-tag>
              CC BY-SA 4.0 ↗
            </span>
            <span class="ok2" data-tag>
              ✓ {ru ? 'Можно для коммерции' : 'OK for commercial use'}
            </span>
            <span class="warn2" data-tag>
              ! {ru ? 'Нужна атрибуция' : 'Attribution required'}
            </span>
          </div>
          <div class="v-meta">
            <span>4032 × 3024</span>
            <span>{ru ? 'кот · окно · дом' : 'cat · window · home'}</span>
          </div>
          <div class="v-btns">
            <span class="pri">{ru ? 'Скачать' : 'Download'}</span>
            <span>{ru ? 'Копировать' : 'Copy'}</span>
            <span>{ru ? 'Поделиться' : 'Share'}</span>
            <span>♡</span>
          </div>
        </div>
      </div>
    </Scene>
  )
}

{
  id === 'picta-icons' && (
    <Scene id={id} label={label} bg="none" class="picta">
      <div class="pt">
        <div class="pt-top">
          <img src={asset('icons/picta-160.webp')} width="34" height="34" alt="" />
          <div class="modes">
            <span>{ru ? 'Фото' : 'Photos'}</span>
            <span data-mode="icons" class="on">
              {ru ? 'Иконки' : 'Icons'}
            </span>
            <span data-mode="colors">{ru ? 'Цвета' : 'Colours'}</span>
          </div>
        </div>
        <div class="panes">
          <div class="pane on" data-pane="icons">
            <div class="i-bar">
              <span class="i-q">{ru ? 'дом' : 'home'} · Iconify</span>
              <span class="sws">
                {['#101114', '#7c5cff', '#ff6428', '#05a081'].map((c, i) => (
                  <i data-sw={c} class:list={{ on: i === 0 }} style={`background:${c}`} />
                ))}
              </span>
              <span class="b">SVG</span>
              <span class="b">PNG 512</span>
            </div>
            <div class="igrid" data-el="grid">
              {icons.concat(icons).map((p) => (
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p} />
                </span>
              ))}
            </div>
          </div>
          <div class="pane" data-pane="colors">
            <div class="c-word">
              {ru ? 'море' : 'sea'}
              <small>{ru ? 'палитра по фото' : 'palette from photos'}</small>
            </div>
            <div class="pal">
              {palette.map((c) => (
                <span style={`background:${c}`}>
                  <i>{c}</i>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Scene>
  )
}

<style>
  /* radius */
  :global(.scene.rad) {
    background: #1b1e25;
  }
  .split {
    position: absolute;
    inset: 0;
  }
  .layer {
    position: absolute;
    inset: 0;
  }
  .layer svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .cut {
    clip-path: inset(0 0 0 var(--x));
    transition: clip-path 1.1s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .checker {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(#e9eaee 0 25%, #c9ccd4 0 50%) 0 0 / 28px 28px;
  }
  .subject {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    transition: left 1.1s cubic-bezier(0.6, 0, 0.2, 1);
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.35);
  }
  .handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: #101114;
    font: 700 16px -apple-system, system-ui;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  .lbl {
    position: absolute;
    top: 18px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(16, 17, 20, 0.7);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }
  .lbl.l {
    left: 18px;
  }
  .lbl.r {
    right: 18px;
  }
  :global(.scene.rad2) .pipe {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 150px;
    display: flex;
    align-items: center;
  }
  .node {
    flex: 1;
    display: grid;
    gap: 4px;
    padding: 18px;
    border-radius: 16px;
    background: rgba(20, 22, 28, 0.65);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    color: #f2f2f5;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    opacity: 0.35;
    transform: scale(0.96);
    transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 1.3, 0.4, 1), box-shadow 0.4s;

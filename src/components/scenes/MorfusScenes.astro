---
// Сцены Morfus. Подписи секторов — из src/actions/registry.rs (кольца по умолчанию) и ui/i18n/en.json.
import Scene from './Scene.astro';
import MorfusRing from './MorfusRing.astro';
import Cursor from './Cursor.astro';
import Key from './Key.astro';
import { asset } from '../../i18n';

interface Props {
  id: string;
  lang: 'ru' | 'en';
  label: string;
}
const { id, lang, label } = Astro.props;
const ru = lang === 'ru';
const arrow = '<svg width="14" height="10" viewBox="0 0 14 10"><path d="M1 5h11M8 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const pill = (name: string, target: string, muted = '') =>
  `<span class="p-name">${name}</span>${arrow}<span class="p-target">${target}</span>${muted ? `<span class="p-muted">${muted}</span>` : ''}`;

const convert = [
  { t: 'PNG', s: ru ? 'без потерь' : 'lossless' },
  { t: 'WebP', s: '82%' },
  { t: 'HEIC', s: '75%' },
  { t: 'AVIF', s: '60%' },
  { t: 'PDF', s: ru ? 'лист A4' : 'A4 page' },
  { t: 'SVG', s: ru ? 'цвет' : 'colour' },
  { t: 'ICO' },
];
const compress = [
  { t: ru ? 'Слегка' : 'Light', s: '≈ −40%' },
  { t: ru ? 'Средне' : 'Medium', s: '≤ 1080p' },
  { t: ru ? 'Сильно' : 'Strong', s: '≤ 720p' },
  { t: 'H.265' },
  { t: '720p', s: ru ? 'уменьшить' : 'downscale' },
  { t: ru ? '25 МБ' : '25 MB', s: ru ? 'не больше' : 'at most' },
];
const tools = [
  { t: ru ? 'Убрать фон' : 'Remove BG', s: 'PNG' },
  { t: ru ? 'Текст' : 'Text', s: 'OCR + QR' },
  { t: ru ? 'Без EXIF' : 'No EXIF', s: ru ? 'GPS, камера' : 'GPS, camera' },
  { t: ru ? 'Повернуть' : 'Rotate', s: '90°' },
  { t: ru ? 'Квадрат' : 'Square', s: ru ? 'размытый' : 'blurred' },
  { t: ru ? 'Один PDF' : 'One PDF', s: ru ? 'все вместе' : 'all together' },
];
const pills = convert.map((c) => pill('IMG_4021.jpg', c.t, c.s && /%/.test(c.s) ? c.s : ''));
const file = 'IMG_4021.jpg';
---

{
  id === 'morfus-ring' && (
    <Scene id={id} label={label}>
      <div class="desk-file" data-el="file" style="left:84px;top:372px">
        <span class="thumb photo" />
        <span class="fname">{file}</span>
      </div>
      <div class="ghost" data-el="ghost"><span class="thumb photo" /></div>
      <MorfusRing labels={convert} ext="JPG" lang={lang} pill={pills[1]} hint={0} class="at-center" />
      <div class="keys" style="right:40px;bottom:36px"><Key k="⌥" id="k0" /></div>
      <Cursor x={560} y={470} />
      <script type="application/json" data-pills set:html={JSON.stringify(pills)} />
    </Scene>
  )
}

{
  id === 'morfus-modes' && (
    <Scene id={id} label={label}>
      <MorfusRing labels={convert} ext="JPG" lang={lang} hot={1} pill={pill('IMG_4021.jpg', 'WebP', '82%')} hint={0} class="at-center m0" />
      <MorfusRing labels={compress} ext="MOV" lang={lang} hot={5} pill={pill(ru ? 'Отпуск.mov' : 'Trip.mov', ru ? '25 МБ' : '25 MB', ru ? 'не больше' : 'at most')} hint={1} class="at-center m1" />
      <MorfusRing labels={tools} ext="JPG" lang={lang} hot={0} theme="dark" pill={pill('IMG_4021.jpg', ru ? 'Убрать фон' : 'Remove BG', 'PNG')} hint={2} class="at-center m2" />
      <div class="keys vertical" style="right:44px;top:150px">
        <Key k="⌥" id="k0" />
        <Key k="⌘" id="k1" />
        <Key k="⌃" id="k2" />
      </div>
    </Scene>
  )
}

{
  id === 'morfus-result' && (
    <Scene id={id} label={label}>
      <div class="desk-file" data-el="file" style="left:84px;top:372px">
        <span class="thumb photo" />
        <span class="fname">{file}</span>
      </div>
      <div class="desk-file out" data-el="out" style="left:84px;top:252px">
        <span class="thumb photo">
          <i class="badge">WebP</i>
        </span>
        <span class="fname">IMG_4021.webp</span>
      </div>
      <MorfusRing labels={convert} ext="JPG" lang={lang} hot={1} pill={pills[1]} hint={-1} class="at-center" />
      <div class="hud" data-el="hud">
        <span class="hud-name">{ru ? 'Отпуск.mov → H.265' : 'Trip.mov → H.265'}</span>
        <span class="hud-bar"><i data-el="hudbar" /></span>
        <span class="hud-pct" data-el="hudpct">0%</span>
      </div>
      <Cursor x={400} y={250} />
    </Scene>
  )
}

{
  id === 'morfus-settings' && (
    <Scene id={id} label={label} w={936} h={648} bg="none" class="settings-scene">
      <div class="set" data-el="set">
        <nav class="set-nav">
          <div class="set-brand">
            <img src={asset('icons/morfus-160.webp')} width="40" height="40" alt="" />
            <div>
              <b>Morfus</b>
              <span>{ru ? 'версия 0.2.2' : 'version 0.2.2'}</span>
            </div>
          </div>
          {(ru ? ['Кольца', 'Клавиши', 'Результат', 'Вид', 'Свои действия', 'Программы', 'Справка'] : ['Rings', 'Keys', 'Output', 'Look', 'Custom actions', 'Tools', 'Help']).map((n, i) => (
            <span class:list={['set-link', { on: i === 0 }]}>
              <i />
              {n}
            </span>
          ))}
        </nav>
        <section class="set-main">
          <h3>{ru ? 'Кольца' : 'Rings'}</h3>
          <p class="set-desc">
            {ru
              ? 'Появляется вокруг курсора. Для каждого режима и типа файла — свой набор секторов: добавляйте, убирайте, меняйте порядок перетаскиванием.'
              : 'Appears around the cursor. Each mode and file type has its own sectors: add, remove and reorder them by dragging.'}
          </p>
          <div class="set-seg">
            <span class="on">{ru ? 'Конвертация' : 'Convert'} <kbd>⌥</kbd></span>
            <span>{ru ? 'Сжатие' : 'Compress'} <kbd>⌘</kbd></span>
            <span>{ru ? 'Инструменты' : 'Tools'} <kbd>⌃</kbd></span>
          </div>
          <div class="set-chips">
            {(ru ? [['Фото', 9], ['Видео', 8], ['Аудио', 6], ['PDF', 5], ['SVG', 5], ['Документы', 6]] : [['Photo', 9], ['Video', 8], ['Audio', 6], ['PDF', 5], ['SVG', 5], ['Documents', 6]]).map(([n, c], i) => (
              <span class:list={['chip2', { on: i === 0 }]}>
                {n} <em>{c}</em>
              </span>
            ))}
          </div>
          <div class="set-cols">
            <div class="set-preview">
              <MorfusRing
                labels={[{ t: 'JPG' }, { t: 'PNG' }, { t: 'WebP' }, { t: 'HEIC' }, { t: 'AVIF' }, { t: 'PDF' }, { t: 'SVG' }, { t: 'ICO' }, { t: 'MP4' }]}
                ext="JPG"
                lang={lang}
                hint={-1}
                class="mini shown"
              />
            </div>
            <div class="set-list">
              <div class="set-list-h">
                <span>{ru ? 'В КОЛЬЦЕ' : 'IN THE RING'}</span>
                <b>{ru ? 'Вернуть как было' : 'Restore defaults'}</b>
              </div>
              <div class="rows" data-el="rows">
                {[
                  ['JPG', '88%', ru ? 'Фото в JPG — открывается везде' : 'Photo to JPG — opens everywhere'],
                  ['PNG', ru ? 'без потерь' : 'lossless', ru ? 'PNG без потерь, с прозрачностью' : 'Lossless PNG with transparency'],
                  ['WebP', '82%', ru ? 'WebP — легче JPG при том же качестве' : 'WebP — lighter than JPG, same quality'],
                  ['HEIC', '75%', ru ? 'HEIC — как на iPhone, вдвое легче JPG' : 'HEIC — like on iPhone, half the size of JPG'],
                  ['AVIF', '60%', ru ? 'AVIF — самый лёгкий современный формат' : 'AVIF — the lightest modern format'],
                ].map(([t, s, d], i) => (
                  <div class="row" data-row={i} style={`--y:${i * 62}px`}>
                    <span class="grip">⋮⋮</span>
                    <span class="num">{i + 1}</span>
                    <span class="ext">{t}</span>
                    <span class="txt">
                      <b>
                        {t} <em>{s}</em>
                      </b>
                      <small>{d}</small>
                    </span>
                    <span class="x">✕</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>
    </Scene>
  )
}

{
  id === 'morfus-cli' && (
    <Scene id={id} label={label}>
      <div class="term" data-el="term">
        <div class="term-bar">
          <span class="lights"><i /><i /><i /></span>
          <span>zsh — 80×24</span>
        </div>
        <pre class="term-body" data-el="body" />
      </div>
      <script
        type="application/json"
        data-lines
        set:html={JSON.stringify([
          ['c', 'M=/Applications/Morfus.app/Contents/MacOS/morfus'],
          ['c', '$M run img.webp фото.jpg --set quality=70', ru ? '# действие с параметром' : '# action with a parameter'],
          ['c', '$M run vid.c.target видео.mov --set mb=10', ru ? '# уложить видео в 10 МБ' : '# fit a video into 10 MB'],
          ['c', '$M actions --mode compress --kind video', ru ? '# какие есть действия' : '# list available actions'],
          ['c', '$M ring tools документ.pdf', ru ? '# что покажет кольцо (JSON)' : '# what the ring will show (JSON)'],
          ['c', 'open "morfus://ring?mode=compress&path=…"', ''],
        ])}
      />
    </Scene>
  )
}

<style>
  :global(.mring.at-center) {
    left: 240px;
    top: 70px;
  }
  .desk-file {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 120px;
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 1.3, 0.4, 1);
  }
  .desk-file.out {
    opacity: 0;
    transform: scale(0.6);
  }
  :global(.desk-file.out.show) {
    opacity: 1;
    transform: none;
  }
  :global(.desk-file.lifted) {
    opacity: 0.45;
  }
  .thumb {
    position: relative;
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 6px;
    border: 3px solid #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  .thumb.photo {
    background:
      radial-gradient(circle at 70% 30%, #ffd88a 0 10%, transparent 11%),
      linear-gradient(180deg, #f6a96b 0%, #e2717d 45%, #4d3d7a 46%, #2b2d55 100%);
  }
  .thumb .badge {
    position: absolute;
    right: -10px;
    bottom: -8px;
    padding: 2px 6px;
    border-radius: 6px;
    background: #1d1d1f;
    color: #fff;
    font: 700 10px/1.2 -apple-system, system-ui, sans-serif;
    font-style: normal;
  }
  .fname {
    padding: 1px 6px;
    border-radius: 4px;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .ghost {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 29;
    opacity: 0;
    transition: translate 0.9s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.2s;
  }
  :global(.ghost.on) {
    opacity: 0.85;
  }
  .ghost .thumb {
    width: 52px;
    height: 52px;
    margin: 8px 0 0 10px;
    transform: rotate(-4deg);
  }
  .keys {
    position: absolute;
    display: flex;
    gap: 12px;
  }
  .keys.vertical {
    flex-direction: column;
    gap: 18px;
  }
  :global(.keys .s-key:not(.down)) {
    opacity: 0.55;
  }
  /* три кольца режимов */
  :global(.mring.m0),
  :global(.mring.m1),
  :global(.mring.m2) {
    transition: transform 260ms cubic-bezier(0.2, 1.3, 0.4, 1), opacity 160ms;
  }
  /* индикатор долгих задач */
  .hud {
    position: absolute;
    right: 22px;
    top: 22px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 10px;
    width: 230px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(36, 36, 40, 0.72);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    color: #f5f5f7;
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.18), 0 8px 24px rgba(0, 0, 0, 0.35);
    font-size: 12px;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 1.3, 0.4, 1);
  }
  :global(.hud.on) {
    opacity: 1;
    transform: none;
  }
  .hud-name {
    font-weight: 600;
  }
  .hud-pct {
    color: #c7c7cc;
    font-variant-numeric: tabular-nums;
  }
  .hud-bar {
    grid-column: 1 / -1;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }
  .hud-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    background: #f5f5f7;
    transition: width 0.4s linear;
  }

  /* Настройки — по docs/settings.jpg и ui/settings.css */
  :global(.scene.settings-scene) {
    background: #f5f5f7;
  }
  .set {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 192px 1fr;
    color: #1d1d22;
    font-size: 13px;
    background: #f5f5f7;
  }
  .set-nav {
    background: #ececf0;
    border-right: 1px solid rgba(0, 0, 0, 0.09);
    padding: 18px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .set-brand {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 2px 6px 16px;
  }
  .set-brand img {
    width: 40px;
    height: 40px;
    margin: -4px;
  }
  .set-brand b {
    display: block;
    font-size: 15px;
  }
  .set-brand span {
    color: #6e6e78;
    font-size: 11.5px;
  }
  .set-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    font-weight: 500;
  }
  .set-link i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.6px solid currentColor;
    opacity: 0.7;
  }
  .set-link.on {
    background: #1d1d1f;
    color: #fff;
  }
  .set-main {
    padding: 26px 28px;
    overflow: hidden;
  }
  .set-main h3 {
    margin: 0 0 6px;
    font-size: 21px;
    font-weight: 700;
  }
  .set-desc {
    margin: 0 0 14px;
    color: #6e6e78;
    line-height: 1.45;
    max-width: 620px;
  }
  .set-seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.06);
    margin-bottom: 12px;
  }
  .set-seg span {
    padding: 6px 14px;
    border-radius: 8px;
    color: #3a3a40;
    font-weight: 500;
  }
  .set-seg span.on {
    background: #fff;
    color: #1d1d22;
    font-weight: 650;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  .set-seg kbd {
    margin-left: 6px;
    padding: 0 5px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
    font: inherit;
    font-size: 11px;
  }
  .set-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .chip2 {
    padding: 5px 11px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.09);
    font-weight: 500;
  }
  .chip2 em {
    font-style: normal;
    color: #6e6e78;
    margin-left: 3px;
  }
  .chip2.on {
    background: #1d1d1f;
    color: #fff;
    box-shadow: none;
  }
  .chip2.on em {
    color: #c7c7cc;
  }
  .set-cols {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 22px;
  }
  .set-preview {
    position: relative;
    height: 352px;
    border-radius: 18px;
    background:
      radial-gradient(70% 70% at 20% 20%, #5b4a9c, transparent 70%),
      radial-gradient(60% 60% at 90% 40%, #2b6f8c, transparent 70%),
      radial-gradient(70% 70% at 50% 100%, #9c4a6b, transparent 70%),
      #25213a;
    overflow: hidden;
  }
  .set-preview :global(.mini) {
    left: -15px;
    top: 16px;
    transform: scale(0.8) !important;
  }
  .set-list-h {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: #6e6e78;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.04em;
  }
  .set-list-h b {
    color: #1d1d22;
    font-weight: 500;
    letter-spacing: 0;
    font-size: 12.5px;
  }
  .rows {
    position: relative;
    height: 312px;
    border-radius: 12px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 62px;
    transform: translateY(var(--y));
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    background: #fff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    transition: transform 0.45s cubic-bezier(0.2, 1.1, 0.4, 1), box-shadow 0.3s;
  }
  :global(.row.lift) {
    z-index: 2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    border-radius: 10px;
  }
  .grip {
    color: #a1a1ab;
    letter-spacing: -2px;
    font-size: 12px;
  }
  .num {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.07);
    font-size: 11px;
    font-weight: 600;
  }
  .ext {
    width: 38px;
    font-size: 10px;
    font-weight: 800;
  }
  .txt {
    flex: 1;
    display: grid;
    min-width: 0;
  }
  .txt b {
    font-weight: 650;
  }
  .txt em {
    margin-left: 4px;
    font-style: normal;
    color: #6e6e78;
    font-weight: 400;
    font-size: 12px;
  }
  .txt small {
    color: #6e6e78;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .x {
    color: #6e6e78;
  }

  /* Терминал */
  .term {
    position: absolute;
    left: 60px;
    top: 60px;
    right: 60px;
    bottom: 60px;
    border-radius: 12px;
    background: rgba(22, 22, 26, 0.88);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.16), 0 30px 70px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .term-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    color: #9a9aa5;
    font-size: 12.5px;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .term-bar .lights {
    position: absolute;
    left: 14px;
  }
  .term-body {
    margin: 0;
    padding: 18px 20px;
    color: #f2f2f5;
    font: 14px/1.75 ui-monospace, 'SF Mono', Menlo, monospace;
    white-space: pre-wrap;
  }
  .term-body :global(.pr) {
    color: #3ddc84;
  }
  .term-body :global(.cm) {
    color: #8a8a96;
  }
  .term-body :global(.caret) {
    display: inline-block;
    width: 8px;
    height: 17px;
    margin-bottom: -3px;
    background: #f2f2f5;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

---
// Окно macOS для сцен Snowpuff: сверху шапка снега, снизу (по желанию) сосульки.
// Классы на сцене: .bare — снег и сосульки сброшены (растут заново после снятия),
// .fall — сосульки падают и разбиваются, .hush — снег на окне исчезает.
// Класс .on на самом окне — тёплый свет активного окна.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  el?: string;
  ice?: number[];
  rows?: number[];
  class?: string;
}
const { x, y, w, h, title, el, ice = [], rows = [82, 64, 90, 48, 72, 58], class: cls } = Astro.props;
const shards = [
  [-22, -10],
  [-12, -18],
  [0, -22],
  [12, -16],
  [22, -8],
];
---

<div class:list={['sp-win', cls]} data-el={el} style={`left:${x}px;top:${y}px;width:${w}px;height:${h}px`}>
  <div class="cap" aria-hidden="true">
    <svg viewBox="0 0 100 12" preserveAspectRatio="none">
      <path d="M0 12C0 6 3 3 8 4 12 0 20 0 24 3c6-3 14-2 18 1 6-3 14-4 18-1 6-3 14-2 18 1 6-3 14-3 18 0 3 1 4 4 4 8Z" />
    </svg>
  </div>
  <div class="frame">
    <div class="tb">
      <span class="lights"><i></i><i></i><i></i></span>
      <b>{title}</b>
    </div>
    <div class="body">
      <slot>
        {rows.map((r) => <span class="ln" style={`width:${r}%`} />)}
      </slot>
    </div>
  </div>
  {
    ice.length > 0 && (
      <div class="ice">
        {ice.map((hh, i) => (
          <span class="icw" style={`--h:${hh}px;--fd:${((i * 7) % 5) * 0.07}s;--r:${(i % 2 ? 1 : -1) * (4 + (i % 3) * 3)}deg`}>
            <span class="ic" />
            <span class="shd">
              {shards.map(([sx, sy]) => (
                <i style={`--sx:${sx}px;--sy:${sy}px`} />
              ))}
            </span>
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  .sp-win {
    position: absolute;
    z-index: 2;
    border-radius: 12px;
    transition: translate 0.08s linear, box-shadow 0.8s ease;
    box-shadow: 0 24px 50px rgba(10, 4, 2, 0.5);
  }
  .sp-win:global(.on) {
    z-index: 3;
    box-shadow: 0 0 0 1px rgba(255, 210, 126, 0.6), 0 0 60px rgba(255, 210, 126, 0.32), 0 24px 50px rgba(10, 4, 2, 0.5);
  }
  .frame {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    background: #2b1d17;
    box-shadow: inset 0 0 0 1px rgba(255, 248, 238, 0.09);
  }
  .tb {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 32px;
    padding: 0 12px;
    background: #382720;
    color: rgba(255, 248, 238, 0.7);
    font-size: 12.5px;
    transition: color 0.8s;
  }
  .sp-win:global(.on) .tb {
    color: #fff3e2;
  }
  .tb b {
    font-weight: 600;
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .body {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px 18px;
  }
  .ln {
    height: 9px;
    border-radius: 5px;
    background: rgba(255, 248, 238, 0.12);
  }
  /* Шапка снега */
  .cap {
    position: absolute;
    z-index: 1;
    left: -5px;
    right: -5px;
    top: -13px;
    height: 17px;
    transform-origin: 50% 100%;
    transition: transform 5s cubic-bezier(0.2, 0.6, 0.3, 1), opacity 1.2s, clip-path 0.35s linear;
    filter: drop-shadow(0 1.5px 0 #d9a98e);
    /* --cut — сколько снега слева уже смёл курсор */
    clip-path: polygon(var(--cut, 0%) -100%, 100% -100%, 100% 300%, var(--cut, 0%) 300%);
  }
  .cap svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cap path {
    fill: #fff8ee;
    transition: fill 0.8s;
  }
  .sp-win:global(.on) .cap path {
    fill: #ffeccb;
  }
  :global(.bare) .cap {
    transform: scaleY(0.12);
    transition: none;
  }
  :global(.hush) .cap {
    opacity: 0;
  }
  /* Сосульки */
  .ice {
    position: absolute;
    top: 100%;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  .icw {
    position: relative;
    width: 11px;
  }
  .ic {
    display: block;
    width: 11px;
    height: var(--h);
    clip-path: polygon(0 0, 100% 0, 58% 100%, 42% 100%);
    background: linear-gradient(180deg, #fff8ee, rgba(255, 236, 214, 0.55));
    transform-origin: 50% 0;
    transition: scale 3s cubic-bezier(0.2, 0.6, 0.3, 1);
  }
  :global(.bare) .ic {
    scale: 1 0;
    transition: none;
  }
  :global(.fall) .ic {
    animation: sp-drop 0.6s cubic-bezier(0.5, 0, 1, 1) var(--fd) forwards;
  }
  .shd {
    position: absolute;
    left: 50%;
    top: 150px;
  }
  .shd i {
    position: absolute;
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: #fff3e2;
    opacity: 0;
  }
  :global(.fall) .shd i {
    animation: sp-shard 0.55s ease-out calc(var(--fd) + 0.55s) forwards;
  }
  @keyframes sp-drop {
    0% {
      transform: none;
      opacity: 1;
    }
    90% {
      transform: translateY(calc(150px - var(--h))) rotate(var(--r));
      opacity: 1;
    }
    100% {
      transform: translateY(calc(150px - var(--h))) rotate(var(--r));
      opacity: 0;
    }
  }
  @keyframes sp-shard {
    0% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translate(var(--sx), var(--sy)) rotate(120deg);
    }
  }
</style>

---
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { tr, path, CONTACTS } from '../i18n';
import Mark from './Mark.astro';
import { analyticsEnabled } from '../analytics.config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const c = CONTACTS;
---

<footer class="foot container">
  <i class="ikat ikat-sep" aria-hidden="true"></i>
  <div class="foot-grid">
    <div class="foot-brand">
      <a href={path(lang)} class="foot-logo"><Mark size={18} /> ehroz.pro</a>
      <p>{analyticsEnabled() ? tr(lang, 'foot.consent') : tr(lang, 'foot.made')}</p>
      {analyticsEnabled() && <p><a href="#" data-consent-open>{tr(lang, 'foot.cookies')}</a></p>}
      <button type="button" class="foot-egg" data-game-start>
        <span class="keys" aria-hidden="true"><kbd>↑</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd><kbd>←</kbd><kbd>→</kbd><kbd>B</kbd><kbd>A</kbd></span>
        <span class="egg-text">{tr(lang, 'foot.egg')}</span>
        <span class="egg-play">▶ {tr(lang, 'foot.egg.btn')}</span>
      </button>
    </div>
    <nav aria-label={lang === 'ru' ? 'Приложения в подвале' : 'Footer: apps'}>
      <h2>{tr(lang, 'menu.apps')}</h2>
      <ul>
        {
          apps.map((a, i) => (
            <li>
              <a href={path(lang, a.slug)}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {a.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={tr(lang, 'cc.title')}>
      <h2>{tr(lang, 'cc.title')}</h2>
      <ul>
        <li><a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener">Telegram</a></li>
        <li><a href={`mailto:${c.email}`}>Email</a></li>
        <li><a href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener">Instagram</a></li>
        <li><a href={`https://github.com/${c.github}`} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={`https://www.behance.net/${c.behance}`} target="_blank" rel="noopener">Behance</a></li>
      </ul>
    </nav>
    <nav aria-label="ehroz.pro">
      <h2>ehroz.pro</h2>
      <ul>
        <li><a href={path(lang, 'about')}>{tr(lang, 'about.page.h1')}</a></li>
        <li><a href={path(lang, 'contacts')}>{tr(lang, 'contacts.page.h1')}</a></li>
        <li><a href={c.order} target="_blank" rel="noopener">{tr(lang, 'contact.order')}</a></li>
        <li><a href={path(other)} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Русский'}</a></li>
      </ul>
    </nav>
  </div>
  <div class="foot-bottom">
    <span>© 2026 Ehroz</span>
    <span>{c.city[lang]} · UTC+5</span>
  </div>
</footer>

<style>
  .foot {
    margin-top: 120px;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    margin-top: 24px;
  }
  .foot-grid > * {
    padding: 20px 16px 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .foot-brand {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .foot-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .foot-brand {
      grid-column: auto;
    }
  }
  .foot-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 18px/1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .foot-brand p {
    margin-top: 12px;
    max-width: 36ch;
    color: var(--muted);
    font-size: 14px;
  }
  .foot-egg {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    padding: 14px 16px;
    max-width: 440px;
    width: 100%;
    text-align: left;
    color: var(--text-2);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px dashed color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 12px;
    cursor: pointer;
    font: inherit;
    transition: background var(--fast) var(--ease), transform var(--fast) var(--ease);
  }
  .foot-egg:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    transform: translateY(-2px);
  }
  .foot-egg .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .foot-egg kbd {
    min-width: 24px;
    padding: 4px 6px;
    text-align: center;
    color: var(--accent);
    font: 600 12px/1 var(--font-mono);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    border-bottom-width: 3px;
    border-radius: 6px;
    animation: kglow 2.4s ease-in-out infinite;
  }
  .foot-egg kbd:nth-child(2) { animation-delay: 0.12s; }
  .foot-egg kbd:nth-child(3) { animation-delay: 0.24s; }
  .foot-egg kbd:nth-child(4) { animation-delay: 0.36s; }
  .foot-egg kbd:nth-child(5) { animation-delay: 0.48s; }
  .foot-egg kbd:nth-child(6) { animation-delay: 0.6s; }
  .foot-egg kbd:nth-child(7) { animation-delay: 0.72s; }
  .foot-egg kbd:nth-child(8) { animation-delay: 0.84s; }
  .foot-egg kbd:nth-child(9) { animation-delay: 0.96s; }
  .foot-egg kbd:nth-child(10) { animation-delay: 1.08s; }
  @keyframes kglow {
    0%, 70%, 100% { background: transparent; }
    10% { background: color-mix(in srgb, var(--accent) 30%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .foot-egg kbd { animation: none; }
  }
  .foot-egg .egg-text {
    font-size: 13px;
  }
  .foot-egg .egg-play {
    color: var(--accent);
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2 {
    margin-bottom: 12px;
    color: var(--faint);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-flex;
    gap: 10px;
    color: var(--text-2);
    font-size: 14px;
    transition: color var(--fast) var(--ease);
  }
  ul a:hover {
    color: var(--accent);
  }
  ul a span {
    color: var(--faint);
    font: 400 12px/1.6 var(--font-mono);
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    color: var(--faint);
    font: 500 10.5px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

---
import type { Lang } from '../content/apps';
import { apps } from '../content/apps';
import { path, tr, pick, asset, CONTACTS, PLATFORM } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = [
  ...apps.map((a) => ({
    type: 'app',
    title: a.name,
    sub: pick(lang, a.short),
    meta: a.platforms.map((p) => pick(lang, PLATFORM[p])).join(' · '),
    href: path(lang, a.slug),
    icon: asset(`icons/${a.slug}-160.webp`),
    slug: a.slug,
    keys: [a.name, a.short.ru, a.short.en, a.tagline.ru, a.tagline.en, ...a.platforms, ...a.features.map((f) => f.title[lang])].join(' ').toLowerCase(),
  })),
  { type: 'action', title: 'Telegram', sub: `@${CONTACTS.telegram}`, href: `https://t.me/${CONTACTS.telegram}`, ic: 'telegram', keys: 'telegram телеграм contact контакт написать message' },
  { type: 'action', title: 'Email', sub: CONTACTS.email, href: `mailto:${CONTACTS.email}`, ic: 'mail', keys: 'email почта mail contact контакт' },
  { type: 'action', title: tr(lang, 'contact.order'), sub: CONTACTS.order.replace('https://', ''), href: CONTACTS.order, ic: 'briefcase', keys: 'order заказать сайт website hire' },
  { type: 'action', title: tr(lang, 'menu.lang'), sub: lang === 'ru' ? 'English version' : 'Русская версия', href: path(lang === 'ru' ? 'en' : 'ru'), ic: 'globe', keys: 'language язык english русский en ru' },
  { type: 'action', title: tr(lang, 'menu.theme'), sub: `${tr(lang, 'theme.dark')} / ${tr(lang, 'theme.light')}`, action: 'theme', ic: 'moon', keys: 'theme тема dark light тёмная светлая' },
];
---

<dialog class="spot" id="spotlight" aria-label={tr(lang, 'spot.placeholder')}>
  <div class="spot-field">
    <Icon name="search" size={22} />
    <input
      type="search"
      placeholder={tr(lang, 'spot.placeholder')}
      aria-label={tr(lang, 'spot.placeholder')}
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="spot-list"
      aria-autocomplete="list"
    />
    <kbd>esc</kbd>
  </div>
  <ul class="spot-list" id="spot-list" role="listbox"></ul>
  <p class="spot-empty" hidden>{tr(lang, 'spot.empty')}</p>
  <p class="spot-hint">{tr(lang, 'spot.hint')}</p>
  <template id="spot-icons">
    <span data-ic="telegram"><Icon name="telegram" size={18} /></span>
    <span data-ic="mail"><Icon name="mail" size={18} /></span>
    <span data-ic="briefcase"><Icon name="briefcase" size={18} /></span>
    <span data-ic="globe"><Icon name="globe" size={18} /></span>
    <span data-ic="moon"><Icon name="moon" size={18} /></span>
  </template>
  <script type="application/json" id="spot-data" set:html={JSON.stringify({ items, labels: { apps: tr(lang, 'spot.apps'), actions: tr(lang, 'spot.actions') } })} />
</dialog>

<style>
  .spot {
    width: min(640px, calc(100vw - 24px));
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--cell);
    color: var(--text);
  }
  .spot[open] {
    animation: spot-in var(--mid) var(--ease);
  }
  @keyframes spot-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .spot::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }
  .spot-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 60px;
    color: var(--faint);
    border-bottom: 1px solid var(--line);
  }
  .spot-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: 500 21px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .spot-field input::-webkit-search-cancel-button {
    display: none;
  }
  .spot-field kbd {
    padding: 4px 6px;
    border: 1px solid var(--line-strong);
    font: 500 10px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .spot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: min(56vh, 460px);
    overflow-y: auto;
  }
  .spot-list:empty {
    display: none;
  }
  .spot-list :global(.spot-group) {
    padding: 10px 16px 6px;
    color: var(--faint);
    font: 500 10.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .spot-list :global(.spot-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    border-top: 1px solid var(--line);
    cursor: pointer;
  }
  .spot-list :global(.spot-item[aria-selected='true']) {
    background: var(--accent);
    color: var(--on-accent);
  }
  .spot-list :global(.spot-item[aria-selected='true'] small),
  .spot-list :global(.spot-item[aria-selected='true'] .spot-meta) {
    color: var(--on-accent);
  }
  .spot-list :global(.spot-item img) {
    width: 40px;
    height: 40px;
    margin: -3px;
  }
  .spot-list :global(.spot-ic) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-strong);
  }
  .spot-list :global(.spot-t) {
    display: grid;
    min-width: 0;
    flex: 1;
    line-height: 1.3;
  }
  .spot-list :global(.spot-t b) {
    font-weight: 650;
    font-size: 15px;
  }
  .spot-list :global(.spot-t small) {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .spot-list :global(.spot-meta) {
    color: var(--faint);
    font: 500 10.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .spot-empty {
    padding: 22px 16px;
    color: var(--muted);
  }
  .spot-hint {
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font: 500 10.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  @media (max-width: 600px) {
    .spot-list :global(.spot-meta) {
      display: none;
    }
  }
</style>

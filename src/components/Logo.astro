interface Props { height?: number; class?: string }
const { height = 16, class: cls } = Astro.props;
const [, , w, h] = '0 0 1656 224'.split(' ').map(Number);
const id = `ehroz-pro-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['logo', cls]} viewBox="0 0 1656 224" height={height} width={Math.round((height * w) / h)} aria-hidden="true" focusable="false">

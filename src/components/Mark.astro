---
// Знак ehroz.pro: кольцо из долек с одной «горячей» — родство с Morfus.
import { ringSectors } from '../lib/ring';
interface Props { size?: number; class?: string }
const { size = 18, class: cls } = Astro.props;
const s = ringSectors(6, 12, 12, 11, 5, 1.6, 1.4, 30);
---
<svg class:list={['mark', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  {s.map((x, i) => <path d={x.d} fill="currentColor" opacity={i === 0 ? 1 : 0.38} />)}
</svg>
